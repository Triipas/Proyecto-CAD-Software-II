<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- allowBackup=false: SecureStorage (JWT) no debe restaurarse en otro dispositivo (recomendación de MAUI).
	     networkSecurityConfig: sin tráfico en claro salvo el servidor local del emulador (RNF09). -->
	<application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round"
	             android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config">
		<!-- HU21 (ADR-07): las notificaciones push del despacho usan el canal «despachos» (lo crea la app al arrancar). -->
		<meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="despachos" />
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Ubicación con la app en uso (HU06, HU08). El acompañamiento (DP13) sigue con la app fuera de la pantalla mediante un
	     servicio en primer plano de tipo ubicación que inicia el ciudadano: no se pide ubicación en segundo plano. -->
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<!-- HU21 (ADR-07): aviso del despacho al sereno. En Android 13+ se pide con una explicación previa. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- DP13: servicio en primer plano del acompañamiento y CPU despierta con la pantalla apagada mientras dura. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<!-- ADR-08: desde la bienvenida, «¿Emergencia ahora?» abre el marcador con 105, 116 o 106 (sin llamar por su cuenta). -->
	<queries>
		<intent>
			<action android:name="android.intent.action.DIAL" />
			<data android:scheme="tel" />
		</intent>
		<!-- Reporte: dictado de la descripción con el reconocedor de voz del sistema (la app no pide el micrófono). -->
		<intent>
			<action android:name="android.speech.action.RECOGNIZE_SPEECH" />
		</intent>
	</queries>
	<uses-feature android:name="android.hardware.location" android:required="false" />
	<uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
