<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Tokens de color v2: mismos nombres y valores que src/Cad.Server/wwwroot/css/tokens.css
     (contraste WCAG 2.2 verificado el 18/10/2026). Los nombres v1 se conservan. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Marca y acción -->
    <Color x:Key="ColorMarino">#0B1F44</Color>              <!-- blanco encima: 16.23:1 -->
    <Color x:Key="ColorMarinoElevado">#132C5C</Color>
    <Color x:Key="ColorMarinoHundido">#06142E</Color>
    <Color x:Key="ColorPrimario">#1D4ED8</Color>            <!-- blanco encima: 6.70:1 -->
    <Color x:Key="ColorPrimarioHover">#1A3FB0</Color>
    <Color x:Key="ColorPrimarioActivo">#16348F</Color>
    <Color x:Key="ColorSobrePrimario">#FFFFFF</Color>
    <Color x:Key="ColorAcento">#5CC8FF</Color>              <!-- solo sobre marino: 8.63:1 -->
    <Color x:Key="ColorTenue">#E6EEFD</Color>
    <Color x:Key="ColorTenueFuerte">#CFDDFB</Color>

    <!-- Superficies y texto -->
    <Color x:Key="ColorFondo">#F3F6FB</Color>
    <Color x:Key="ColorSuperficie">#FFFFFF</Color>
    <Color x:Key="ColorSuperficieHundida">#EDF2F9</Color>
    <Color x:Key="ColorTexto">#0D1B33</Color>
    <Color x:Key="ColorTextoSecundario">#475A75</Color>
    <Color x:Key="ColorTextoTerciario">#5C6E88</Color>
    <Color x:Key="ColorTextoSobreMarino">#D5E0F0</Color>    <!-- 12.17:1 sobre marino -->
    <Color x:Key="ColorTextoSobreMarinoSecundario">#9DB1D0</Color> <!-- 7.45:1 -->

    <!-- Bordes -->
    <Color x:Key="ColorBorde">#D9E2EE</Color>
    <Color x:Key="ColorBordeFuerte">#C3CFDF</Color>
    <Color x:Key="ColorBordeControl">#7487A2</Color>        <!-- 3.66:1 sobre superficie -->
    <Color x:Key="ColorFoco">#1D4ED8</Color>

    <!-- Estados: siempre con icono y texto -->
    <Color x:Key="ColorError">#B42318</Color>
    <Color x:Key="ColorErrorFondo">#FEF3F2</Color>
    <Color x:Key="ColorErrorBorde">#F4C7C3</Color>
    <Color x:Key="ColorAdvertencia">#93370D</Color>
    <Color x:Key="ColorAdvertenciaFondo">#FFF8EB</Color>
    <Color x:Key="ColorAdvertenciaBorde">#F5D9A8</Color>
    <Color x:Key="ColorInformacion">#1D46B8</Color>
    <Color x:Key="ColorInformacionFondo">#EAF1FE</Color>
    <Color x:Key="ColorInformacionBorde">#BFD3F5</Color>
    <Color x:Key="ColorExito">#05603A</Color>
    <Color x:Key="ColorExitoFondo">#ECFDF3</Color>
    <Color x:Key="ColorExitoBorde">#ABEFC6</Color>
    <Color x:Key="ColorNeutro">#3F4E63</Color>
    <Color x:Key="ColorNeutroFondo">#EEF2F7</Color>
    <Color x:Key="ColorNeutroBorde">#D3DCE8</Color>
    <Color x:Key="ColorProgreso">#1D4ED8</Color>            <!-- 5.75:1 sobre su fondo -->
    <Color x:Key="ColorProgresoFondo">#E6EEFD</Color>
    <Color x:Key="ColorProgresoBorde">#CFDDFB</Color>

    <!-- Dominio. Urgencia (SOS): blanco encima 6.57:1; siempre con el texto «SOS». -->
    <Color x:Key="ColorUrgente">#B42318</Color>
    <Color x:Key="ColorUrgenteActivo">#912018</Color>
    <Color x:Key="ColorUrgenteFondo">#FEF3F2</Color>
    <Color x:Key="ColorUrgenteBorde">#F4C7C3</Color>
    <Color x:Key="ColorReporte">#6D28D9</Color>
    <Color x:Key="ColorReporteFondo">#F4EFFE</Color>
    <Color x:Key="ColorAcompanamiento">#0F766E</Color>
    <Color x:Key="ColorAcompanamientoFondo">#E8F6F4</Color>
</ResourceDictionary>
