<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Estilos de CAD Móvil v2 (rediseño, fase 1). Public Sans, como el panel web.
     Los pesos se eligen por familia (PublicSansSemiBold, PublicSansBold), no con FontAttributes,
     para no sintetizar negritas. Radios: 8 controles, 12 superficies, 999 chips. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:v="clr-namespace:Cad.Movil.Vistas">

    <!-- ── Página ──────────────────────────────────────────────────────── -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorFondo}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <!-- ── Texto ───────────────────────────────────────────────────────── -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
        <Setter Property="FontFamily" Value="PublicSans" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontFamily" Value="PublicSansBold" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
        <Setter Property="TextColor" Value="{StaticResource ColorMarino}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="TituloSeccion" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="PublicSansSemiBold" />
        <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="TextoSecundario" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextoSecundario}" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="PublicSansSemiBold" />
    </Style>

    <!-- Cifras protagonistas: cronómetro, horas, contadores. -->
    <Style x:Key="Cifra" TargetType="Label">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontFamily" Value="PublicSansBold" />
        <Setter Property="CharacterSpacing" Value="-0.5" />
        <Setter Property="TextColor" Value="{StaticResource ColorMarino}" />
    </Style>

    <Style x:Key="ErrorCampo" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource ColorError}" />
    </Style>

    <!-- ── Campos ──────────────────────────────────────────────────────── -->
    <!-- Borde de control con contraste ≥ 3:1 sobre la superficie. El subrayado nativo
         se quita en MauiProgram para Entry, Editor, Picker, DatePicker y TimePicker. -->
    <Style x:Key="MarcoCampo" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource ColorBordeControl}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSuperficie}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource ColorTextoTerciario}" />
        <Setter Property="FontFamily" Value="PublicSans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource ColorTextoTerciario}" />
        <Setter Property="FontFamily" Value="PublicSans" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
        <Setter Property="TitleColor" Value="{StaticResource ColorTextoTerciario}" />
        <Setter Property="FontFamily" Value="PublicSans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
        <Setter Property="FontFamily" Value="PublicSans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource ColorTexto}" />
        <Setter Property="FontFamily" Value="PublicSans" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- ── Botones ─────────────────────────────────────────────────────── -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="PublicSansSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="BotonPrincipal" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimario}" />
        <Setter Property="TextColor" Value="{StaticResource ColorSobrePrimario}" />
        <Setter Property="FontFamily" Value="PublicSansSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <!-- Movimiento (fase 2): al tocar se hunde un poco y vuelve (Movimiento.Pulsable). -->
        <Setter Property="v:Movimiento.Pulsable" Value="True" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimarioActivo}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimarioHover}" />
                            <Setter Property="TextColor" Value="{StaticResource ColorSobrePrimario}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSuperficie}" />
        <Setter Property="TextColor" Value="{StaticResource ColorMarino}" />
        <Setter Property="BorderColor" Value="{StaticResource ColorBordeControl}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="PublicSansMedium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <!-- Movimiento (fase 2): al tocar se hunde un poco y vuelve (Movimiento.Pulsable). -->
        <Setter Property="v:Movimiento.Pulsable" Value="True" />
        <!-- Deshabilitado: texto y borde atenuados (el estado no depende solo del color: hay un texto que lo explica). -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ColorTenue}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource ColorTextoSecundario}" />
                            <Setter Property="BorderColor" Value="{StaticResource ColorBorde}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource ColorFondo}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Acción discreta (Salir, Detalles): sin borde, texto en azul de acción. -->
    <Style x:Key="BotonTerciario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorPrimario}" />
        <Setter Property="FontFamily" Value="PublicSansSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- SOS y acciones urgentes: siempre con el texto «SOS» o un verbo explícito. -->
    <Style x:Key="BotonUrgente" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorUrgente}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="PublicSansBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ColorUrgenteActivo}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ── Superficies ─────────────────────────────────────────────────── -->
    <Style x:Key="Superficie" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSuperficie}" />
        <Setter Property="Stroke" Value="{StaticResource ColorBorde}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Shadow">
            <Shadow Brush="#0B1F44" Offset="0,2" Radius="6" Opacity="0.08" />
        </Setter>
    </Style>

    <!-- Entrada a un flujo (Reportar, Acompañamiento): toda la superficie es pulsable. -->
    <Style x:Key="Mosaico" TargetType="Border" BasedOn="{StaticResource Superficie}">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinimumHeightRequest" Value="72" />
    </Style>

    <!-- Encabezado de borde a borde en azul marino (fase 4): título blanco, ayuda en celeste grisáceo y acciones a la derecha. -->
    <Style x:Key="EncabezadoMarino" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorMarino}" />
        <Setter Property="Padding" Value="20,20,20,24" />
        <Setter Property="RowSpacing" Value="6" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="TituloSobreMarino" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontFamily" Value="PublicSansBold" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="TextoSobreMarino" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextoSobreMarino}" />
    </Style>

    <!-- Acción discreta sobre el encabezado marino (Salir): borde translúcido, texto claro. -->
    <Style x:Key="BotonSobreMarino" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderColor" Value="#3D5A93" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="PublicSansSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Píldora de estado sobre el marino (ubicación lista, operativo): fondo translúcido y texto claro. -->
    <Style x:Key="PildoraSobreMarino" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="#1A3366" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- Título y ayuda de un mosaico o de una tarjeta de lista. -->
    <Style x:Key="TituloMosaico" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="PublicSansSemiBold" />
        <Setter Property="TextColor" Value="{StaticResource ColorMarino}" />
    </Style>

    <!-- Fondo del icono de un mosaico: un cuadro suave del tono de su flujo. -->
    <Style x:Key="FondoIcono" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ── Chips de estado: color + icono + texto ──────────────────────── -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>
    <Style x:Key="ChipInformacion" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorInformacionFondo}" />
        <Setter Property="Stroke" Value="{StaticResource ColorInformacionBorde}" />
    </Style>
    <Style x:Key="ChipExito" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorExitoFondo}" />
        <Setter Property="Stroke" Value="{StaticResource ColorExitoBorde}" />
    </Style>
    <Style x:Key="ChipAdvertencia" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorAdvertenciaFondo}" />
        <Setter Property="Stroke" Value="{StaticResource ColorAdvertenciaBorde}" />
    </Style>
    <Style x:Key="ChipUrgente" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorUrgenteFondo}" />
        <Setter Property="Stroke" Value="{StaticResource ColorUrgenteBorde}" />
    </Style>
    <Style x:Key="ChipProgreso" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorProgresoFondo}" />
        <Setter Property="Stroke" Value="{StaticResource ColorProgresoBorde}" />
    </Style>
    <Style x:Key="ChipNeutro" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorNeutroFondo}" />
        <Setter Property="Stroke" Value="{StaticResource ColorNeutroBorde}" />
    </Style>
    <Style x:Key="TextoChip" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="PublicSansSemiBold" />
    </Style>
</ResourceDictionary>
