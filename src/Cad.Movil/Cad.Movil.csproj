<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android: los dispositivos de prueba del equipo son Android (Plan de Arquitectura, ADR-01).
		     net10.0 (sin plataforma) solo existe para probar la lógica de la app con xUnit. -->
		<TargetFrameworks>net10.0-android;net10.0</TargetFrameworks>
		<OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>

		<RootNamespace>Cad.Movil</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>CAD Móvil</ApplicationTitle>
		<ApplicationId>pe.cadmvp.movil</ApplicationId>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icono y pantalla de inicio con el azul marino de los tokens v2 (#0B1F44). -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1F44" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1F44" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<!-- Public Sans (OFL; licencia en Resources/Fonts/OFL-PublicSans.txt). -->
		<MauiFont Include="Resources\Fonts\*.ttf" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- HU21-CA01: aviso del despacho en tiempo real con la app abierta (canal /hubs/sereno).
		     10.0.13 o superior: corrige CVE-2026-70159 (GHSA-334f-vvp4-7g6p). -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Cad.Contratos\Cad.Contratos.csproj" />
	</ItemGroup>

	<!-- HU21 (ADR-07): notificación push del despacho con Firebase Cloud Messaging, solo en Android.
	     google-services.json es la configuración de cliente del proyecto de Firebase del equipo: no se versiona
	     (.gitignore). Sin el archivo, la app compila y funciona igual, sin push (p. ej., en la CI). -->
	<PropertyGroup>
		<CadGoogleServicesJson Condition="'$(CadGoogleServicesJson)' == ''">$(MSBuildProjectDirectory)\Platforms\Android\google-services.json</CadGoogleServicesJson>
	</PropertyGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
		<!-- Firebase trae versiones de AndroidX más nuevas que algunos paquetes «Ktx» de MAUI: sin alinearlos, D8
		     encuentra clases duplicadas. Se fijan las mismas versiones que resuelve Firebase. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<GoogleServicesJson Include="$(CadGoogleServicesJson)" Condition="Exists('$(CadGoogleServicesJson)')" />
	</ItemGroup>

</Project>
