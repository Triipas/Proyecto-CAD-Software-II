<?xml version="1.0" encoding="utf-8" ?>
<!-- HU34–HU37 — acompañamiento temporal: activación con la finalidad aceptada, estado y tiempo restante, transmisión real y finalización.
     Rediseño del 26/10/2026 (como el inicio, diseño A): con el acompañamiento activo, el mapa es el fondo y muestra el recorrido que la
     central ya recibió, con el mismo marcador que ve el operador. Arriba flota «La central te acompaña» con el latido real de la
     transmisión; abajo, en la zona del pulgar, cómo vas, lo último que pasó con la central y el final del trayecto. No se promete
     más de lo que el sistema sabe: no dice que un operador esté mirando, sino que tu ubicación llega. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cad.Movil.VistasModelo"
             xmlns:v="clr-namespace:Cad.Movil.Vistas"
             x:Class="Cad.Movil.Vistas.AcompanamientoPagina"
             x:DataType="vm:AcompanamientoVistaModelo"
             Shell.TabBarIsVisible="False"
             Title="Acompañamiento">
    <ContentPage.Resources>
        <!-- Tarjeta blanca que flota sobre el mapa, como en el inicio. -->
        <Style x:Key="Flotante" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource ColorSuperficie}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Shadow">
                <Shadow Brush="#0B1F44" Offset="0,8" Radius="20" Opacity="0.20" />
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <v:EncabezadoPagina Titulo="Acompañamiento" TextoVolver="Inicio"
                            Ayuda="Comparte tu ubicación con la central durante un trayecto, hasta 30 minutos. No es un SOS: si estás en peligro, pulsa «Necesito ayuda» y se emite uno." />

        <!-- Sin acompañamiento activo: el inicio (HU34) y cómo terminó el anterior. -->
        <ScrollView Grid.Row="1" IsVisible="{Binding MostrarFormulario}">
            <VerticalStackLayout Padding="16,20,16,32" Spacing="16" MaximumWidthRequest="480">
                <!-- Estado general: no confirmado, cierre pendiente, finalizado, vencido o un error. -->
                <v:Aviso Tipo="{Binding TipoAvisoEstado}" Texto="{Binding TextoEstado}" IsVisible="{Binding HayEstado}" />
                <Button Text="Volver a ingresar" Style="{StaticResource BotonSecundario}" Command="{Binding VolverAIngresar}" IsVisible="{Binding SesionTerminada}" />

                <!-- HU34: inicio con la finalidad aceptada (CA02), permiso y ubicación (CA03). -->
                <Border Style="{StaticResource Superficie}" Padding="16" IsVisible="{Binding MostrarInicio}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Antes de empezar" FontAttributes="Bold" />
                        <Label Text="Mientras el acompañamiento esté activo, la aplicación enviará tu ubicación a la central cada 15 segundos, también con la aplicación cerrada. Termina cuando tú lo decidas o, como máximo, a los 30 minutos." />
                        <v:Aviso Tipo="advertencia" Texto="{x:Static vm:AcompanamientoVistaModelo.TextoEntorno}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox IsChecked="{Binding FinalidadAceptada}" VerticalOptions="Start"
                                      SemanticProperties.Description="Acepto compartir mi ubicación con la central durante el trayecto" />
                            <Label Grid.Column="1" Text="Acepto compartir mi ubicación con la central durante el trayecto." VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AlTocarFinalidad" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <Button Text="Continuar y permitir la ubicación" Style="{StaticResource BotonPrincipal}"
                                Command="{Binding PermitirUbicacion}" IsVisible="{Binding MostrarPermitir}" />
                        <Button Text="Abrir los ajustes del teléfono" Style="{StaticResource BotonSecundario}"
                                Command="{Binding AbrirAjustes}" IsVisible="{Binding MostrarAjustes}" />
                        <Button Text="{Binding TextoBotonIniciar}" Style="{StaticResource BotonPrincipal}" Command="{Binding Iniciar}"
                                SemanticProperties.Hint="Inicia el acompañamiento; no emite un SOS ni registra un reporte" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Volver al inicio" Style="{StaticResource BotonSecundario}" Command="{Binding Volver}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Acompañamiento activo. -->
        <Grid Grid.Row="1" IsVisible="{Binding MostrarActivo}">
            <WebView x:Name="Mapa" SemanticProperties.Description="Mapa con el recorrido que recibió la central" />

            <!-- Arriba: la central te acompaña, con el latido real de la transmisión (HU35-CA04) y el tiempo en segundo plano (HU34-CA01). -->
            <Border Style="{StaticResource Flotante}" Padding="14,12" Margin="12,12,12,0" VerticalOptions="Start">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource ColorAcompanamiento}" VerticalOptions="Center">
                            <v:Icono Nombre="escudo" Color="White" Tamano="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding LatidoAlDia}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource ColorTextoTerciario}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="La central te acompaña" FontFamily="PublicSansBold" FontSize="17" TextColor="{StaticResource ColorMarino}"
                                   SemanticProperties.HeadingLevel="Level1" />
                            <Label Text="{Binding TextoLatido}" FontSize="13" TextColor="{StaticResource ColorAcompanamiento}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding LatidoAlDia}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource ColorAdvertencia}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                    <ProgressBar Progress="{Binding ProgresoRestante}" ProgressColor="{StaticResource ColorAcompanamiento}"
                                 SemanticProperties.Description="{Binding TextoRestante}" />
                    <Label Text="{Binding TextoRestante}" FontSize="13" TextColor="{StaticResource ColorTextoSecundario}" />
                </VerticalStackLayout>
            </Border>

            <!-- Abajo, en la zona del pulgar: cómo vas (o la confirmación que pidió la central), lo último y el final del trayecto. -->
            <Border BackgroundColor="{StaticResource ColorSuperficie}" StrokeThickness="0" StrokeShape="RoundRectangle 20,20,0,0"
                    Padding="16,14,16,16" VerticalOptions="End">
                <Border.Shadow>
                    <Shadow Brush="#0B1F44" Offset="0,-6" Radius="20" Opacity="0.16" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12" MaximumWidthRequest="480">
                    <!-- HU41: la central preguntó. «Necesito ayuda» emite un SOS (o usa el que ya tengas). -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HayConfirmacion}">
                        <Label Text="La central te pregunta cómo estás" FontFamily="PublicSansBold" FontSize="17" TextColor="{StaticResource ColorMarino}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{Binding TextoConfirmacion}" FontSize="13" TextColor="{StaticResource ColorTextoSecundario}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Estoy bien" Style="{StaticResource BotonPrincipal}" Command="{Binding ResponderEstoyBien}"
                                    SemanticProperties.Hint="Avisa a la central de que estás bien. El acompañamiento sigue activo" />
                            <Button Grid.Column="1" Text="Necesito ayuda" Style="{StaticResource BotonUrgente}" Command="{Binding ResponderNecesitoAyuda}"
                                    SemanticProperties.Hint="Emite un SOS a la central" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Por tu cuenta, sin esperar a que pregunte. -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding MostrarComoVas}">
                        <Label Text="¿Cómo vas?" FontFamily="PublicSansBold" FontSize="17" TextColor="{StaticResource ColorMarino}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Button Text="Necesito ayuda" Style="{StaticResource BotonUrgente}" Command="{Binding InformarNecesitoAyuda}"
                                SemanticProperties.Hint="Emite un SOS a la central" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Estoy bien" Style="{StaticResource BotonSecundario}" Command="{Binding InformarEstoyBien}"
                                    SemanticProperties.Hint="Avisa a la central de que estás bien. El acompañamiento sigue activo" />
                            <Button Grid.Column="1" Text="Algo no está bien" Style="{StaticResource BotonSecundario}" Command="{Binding InformarAlgoNoEstaBien}"
                                    SemanticProperties.Hint="Avisa a la central sin emitir un SOS: te tendrá en seguimiento" />
                        </Grid>
                    </VerticalStackLayout>
                    <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" HeightRequest="24" />

                    <!-- Lo último entre tú y la central. -->
                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Actividad}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LineaActividad">
                                <Grid ColumnDefinitions="44,*">
                                    <Label Text="{Binding Hora}" FontSize="13" TextColor="{StaticResource ColorTextoTerciario}" />
                                    <Label Grid.Column="1" Text="{Binding Texto}" FontSize="13" TextColor="{StaticResource ColorTextoSecundario}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource ColorBorde}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Text="Llegué a mi destino" Style="{StaticResource BotonSecundario}" Command="{Binding InformarLlegue}"
                                SemanticProperties.Hint="Avisa tu llegada y finaliza el acompañamiento" />
                        <Button Grid.Column="1" Text="Finalizar" Style="{StaticResource BotonTerciario}" Command="{Binding Finalizar}"
                                SemanticProperties.Hint="Deja de compartir tu ubicación de inmediato" />
                    </Grid>
                    <!-- HU35-CA05 y DP13: lo que la transmisión puede y no puede hacer. -->
                    <Label Text="{x:Static vm:AcompanamientoVistaModelo.TextoEntorno}" FontSize="12" TextColor="{StaticResource ColorTextoTerciario}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <v:Aviso Grid.Row="1" Emergente="True" Tipo="advertencia" Texto="{Binding MensajeInicio}" Mostrar="{Binding HayMensajeInicio}" />
        <v:Aviso Grid.Row="1" Emergente="True" Tipo="{Binding TipoResultadoConfirmacion}" Texto="{Binding ResultadoConfirmacion}" Mostrar="{Binding HayResultadoConfirmacion}" />
        <v:Aviso Grid.Row="1" Emergente="True" Tipo="{Binding TipoResultadoEstado}" Texto="{Binding ResultadoEstado}" Mostrar="{Binding HayResultadoEstado}" />
    </Grid>
</ContentPage>
