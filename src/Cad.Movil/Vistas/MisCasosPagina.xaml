<?xml version="1.0" encoding="utf-8" ?>
<!-- HU30 — «Mis casos»: SOS y reportes propios con origen, fecha y estado público (DP05).
     Rediseño CAD v2 (fase 4): pestaña de la barra inferior; cada caso es una tarjeta pulsable con su origen y un chip de estado. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cad.Movil.VistasModelo"
             xmlns:v="clr-namespace:Cad.Movil.Vistas"
             x:Class="Cad.Movil.Vistas.MisCasosPagina"
             x:DataType="vm:MisCasosVistaModelo"
             Title="Mis casos">
    <!-- CA02: deslizar hacia abajo vuelve a consultar el estado actual. -->
    <RefreshView IsRefreshing="{Binding Cargando}" Command="{Binding Actualizar}" RefreshColor="{StaticResource ColorPrimario}">
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <v:EncabezadoPagina Titulo="Mis casos" MostrarVolver="False"
                                    Ayuda="Tus SOS y reportes, los más recientes primero. Desliza hacia abajo para actualizar." />

                <VerticalStackLayout Padding="16,20,16,32" Spacing="12" MaximumWidthRequest="480">
                    <v:Aviso Tipo="error" Texto="{Binding Mensaje}" IsVisible="{Binding HayMensaje}" />
                    <Button Text="Volver a ingresar" Style="{StaticResource BotonSecundario}" Command="{Binding VolverAIngresar}" IsVisible="{Binding SesionTerminada}" />

                    <!-- Estado vacío: qué es esta lista y cómo se llena. -->
                    <VerticalStackLayout Spacing="8" Padding="16,32" IsVisible="{Binding SinCasos}" HorizontalOptions="Center">
                        <v:Icono Nombre="documento" Color="{StaticResource ColorTextoSecundario}" Tamano="40" HorizontalOptions="Center" />
                        <Label Text="Aún no tienes SOS ni reportes." Style="{StaticResource TituloMosaico}" HorizontalTextAlignment="Center" />
                        <Label Text="Cuando pidas ayuda o reportes una incidencia, verás aquí su estado y sus avances."
                               Style="{StaticResource TextoSecundario}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Movimiento (fase 4): mientras llega la primera respuesta, la forma de la lista en lugar de una pantalla vacía. -->
                    <v:Esqueleto IsVisible="{Binding PrimeraCarga}" />

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Casos}" v:Movimiento.EntradaEscalonada="True">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ElementoMiCaso">
                                <Grid>
                                    <Border Style="{StaticResource Superficie}" Padding="16">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <HorizontalStackLayout Spacing="8">
                                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3" BackgroundColor="{StaticResource ColorUrgente}" IsVisible="{Binding EsSos}">
                                                    <Label Text="SOS" TextColor="White" FontFamily="PublicSansBold" FontSize="13" />
                                                </Border>
                                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3" BackgroundColor="{StaticResource ColorReporte}" IsVisible="{Binding EsReporte}">
                                                    <Label Text="Reporte" TextColor="White" FontFamily="PublicSansBold" FontSize="13" />
                                                </Border>
                                                <v:ChipEstado Estado="{Binding Estado}" Urgente="{Binding EsSos}" />
                                            </HorizontalStackLayout>
                                            <v:Icono Grid.Column="1" Nombre="derecha" Color="{StaticResource ColorTextoSecundario}" VerticalOptions="Center" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Fecha, StringFormat='Registrado el {0}'}" Style="{StaticResource TextoSecundario}" />
                                            <!-- CA03: resultado público de un caso finalizado. -->
                                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Resultado}" IsVisible="{Binding HayResultado}" />
                                        </Grid>
                                    </Border>
                                    <Button BackgroundColor="Transparent" BorderWidth="0" v:Movimiento.Tarjeta="True" Command="{Binding Abrir}"
                                            SemanticProperties.Description="{Binding Descripcion}" SemanticProperties.Hint="Muestra los avances del caso" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
