<?xml version="1.0" encoding="utf-8" ?>
<!-- HU30 — «Mis casos»: SOS y reportes propios con origen, fecha y estado público (DP05). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cad.Movil.VistasModelo"
             xmlns:v="clr-namespace:Cad.Movil.Vistas"
             x:Class="Cad.Movil.Vistas.MisCasosPagina"
             x:DataType="vm:MisCasosVistaModelo"
             Title="Mis casos">
    <!-- CA02: deslizar hacia abajo vuelve a consultar el estado actual. -->
    <RefreshView IsRefreshing="{Binding Cargando}" Command="{Binding Actualizar}">
        <ScrollView>
            <VerticalStackLayout Padding="16,24" Spacing="12" MaximumWidthRequest="480">
                <VerticalStackLayout>
                    <Label Text="Ciudadano" Style="{StaticResource Sobretitulo}" />
                    <Label Text="Mis casos" Style="{StaticResource Titulo}" />
                    <Label Text="Tus SOS y reportes, los más recientes primero. Desliza hacia abajo para actualizar." Style="{StaticResource TextoSecundario}" />
                </VerticalStackLayout>

                <v:Aviso Tipo="error" Texto="{Binding Mensaje}" IsVisible="{Binding HayMensaje}" />
                <Button Text="Volver a ingresar" Style="{StaticResource BotonSecundario}" Command="{Binding VolverAIngresar}" IsVisible="{Binding SesionTerminada}" />
                <v:Aviso Tipo="informacion" Texto="Aún no tienes SOS ni reportes." IsVisible="{Binding SinCasos}" />

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Casos}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ElementoMiCaso">
                            <Border Style="{StaticResource Superficie}" Padding="16" SemanticProperties.Description="{Binding Descripcion}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Abrir}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                    <Label Text="{Binding Fecha, StringFormat='Registrado el {0}'}" Style="{StaticResource TextoSecundario}" />
                                    <!-- CA03: resultado público de un caso finalizado. -->
                                    <Label Text="{Binding Resultado}" IsVisible="{Binding HayResultado}" />
                                    <Button Text="Ver avances" Style="{StaticResource BotonSecundario}" Command="{Binding Abrir}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
