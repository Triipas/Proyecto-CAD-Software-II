<?xml version="1.0" encoding="utf-8" ?>
<!-- ADR-08 — PIN de 6 dígitos con teclado propio (teclas de 72 dp desde el 26/10/2026): crear y confirmar, restablecer o ingresar. El PIN nunca se
     muestra; seis puntos indican cuántos dígitos van. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cad.Movil.VistasModelo"
             xmlns:v="clr-namespace:Cad.Movil.Vistas"
             x:Class="Cad.Movil.Vistas.PinPagina"
             x:DataType="vm:PinVistaModelo"
             Title="PIN">
    <ContentPage.Resources>
        <Style x:Key="TeclaPin" TargetType="Button">
            <Setter Property="HeightRequest" Value="72" />
            <Setter Property="FontFamily" Value="PublicSansSemiBold" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource ColorMarino}" />
            <Setter Property="BackgroundColor" Value="{StaticResource ColorSuperficie}" />
            <Setter Property="BorderColor" Value="{StaticResource ColorBorde}" />
            <Setter Property="BorderWidth" Value="1" />
            <!-- Movimiento (26/10/2026): la tecla responde al dedo como una tecla física: se hunde, vibra y se tiñe de azul mientras
                 está presionada (Movimiento.Tecla). -->
            <Setter Property="v:Movimiento.Tecla" Value="True" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource ColorTenue}" />
                                <Setter Property="BorderColor" Value="{StaticResource ColorPrimario}" />
                                <Setter Property="TextColor" Value="{StaticResource ColorPrimario}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{StaticResource ColorTextoSecundario}" />
                                <Setter Property="BackgroundColor" Value="{StaticResource ColorFondo}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <!-- Acomodo del 26/10/2026: sin el hueco bajo el teclado. Los puntos quedan en el centro del espacio de arriba y el teclado,
         con teclas más altas, abajo, en la zona del pulgar; los enlaces, debajo de él. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <v:EncabezadoPagina Titulo="{Binding Titulo}" Ayuda="{Binding Subtitulo}" />

        <!-- Seis puntos: lleno = dígito escrito. -->
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="16" Padding="16,12">
            <HorizontalStackLayout x:Name="PuntosPin" HorizontalOptions="Center" Spacing="18" BindableLayout.ItemsSource="{Binding Puntos}" v:Movimiento.SacudirAl="{Binding Mensaje}"
                                   SemanticProperties.Description="Dígitos del PIN escritos">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:Boolean">
                        <Border WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" StrokeThickness="2"
                                Stroke="{StaticResource ColorPrimario}" BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding .}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource ColorPrimario}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
            <v:Aviso Emergente="True" Tipo="error" Texto="{Binding Mensaje}" Mostrar="{Binding HayMensaje}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Padding="16,0,16,20" Spacing="8" MaximumWidthRequest="420">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12" Margin="0,0,0,8">
                <Button Text="1" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="1" />
                <Button Grid.Column="1" Text="2" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="2" />
                <Button Grid.Column="2" Text="3" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="3" />
                <Button Grid.Row="1" Text="4" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="4" />
                <Button Grid.Row="1" Grid.Column="1" Text="5" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="5" />
                <Button Grid.Row="1" Grid.Column="2" Text="6" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="6" />
                <Button Grid.Row="2" Text="7" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="7" />
                <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="8" />
                <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="9" />
                <Button Grid.Row="3" Grid.Column="1" Text="0" Style="{StaticResource TeclaPin}" Command="{Binding Tecla}" CommandParameter="0" />
                <Button Grid.Row="3" Grid.Column="2" Text="Borrar" Style="{StaticResource BotonTerciario}" Command="{Binding Borrar}" v:Movimiento.Tecla="True"
                        HeightRequest="72" SemanticProperties.Description="Borrar el último dígito" />
            </Grid>

            <Button Text="Crear un PIN nuevo" Style="{StaticResource BotonPrincipal}" Command="{Binding OlvideMiPin}" IsVisible="{Binding Bloqueado}" />
            <Button Text="Olvidé mi PIN" Style="{StaticResource BotonTerciario}" Command="{Binding OlvideMiPin}" IsVisible="{Binding EsIngreso}" />
            <Button Text="¿No es tu número? Cambiarlo" Style="{StaticResource BotonTerciario}" Command="{Binding CambiarNumero}" IsVisible="{Binding EsIngreso}" />
            <Button Text="Crear una cuenta nueva con este número (solo desarrollo)" Style="{StaticResource BotonTerciario}"
                    Command="{Binding RegistrarDeNuevo}" IsVisible="{Binding PuedeRegistrarDeNuevo}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
