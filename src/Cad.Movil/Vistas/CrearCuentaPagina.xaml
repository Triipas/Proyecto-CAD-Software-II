<?xml version="1.0" encoding="utf-8" ?>
<!-- ADR-08 y registro único (06/11/2026) — crea tu cuenta: un solo formulario con todos los datos que la central necesita.
     El celular ya está verificado y no se vuelve a pedir; solo la dirección es opcional. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cad.Movil.VistasModelo"
             xmlns:v="clr-namespace:Cad.Movil.Vistas"
             x:Class="Cad.Movil.Vistas.CrearCuentaPagina"
             x:DataType="vm:CrearCuentaVistaModelo"
             Title="Crea tu cuenta">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <v:EncabezadoPagina Titulo="Crea tu cuenta"
                                Ayuda="Hazlo con calma, antes de necesitarlo: la central usará estos datos para atenderte en una emergencia." />

            <VerticalStackLayout Padding="16,24,16,32" Spacing="12" MaximumWidthRequest="480">
                <Label Text="Celular" Style="{StaticResource Etiqueta}" />
                <Border Style="{StaticResource MarcoCampo}" BackgroundColor="{StaticResource ColorSuperficieHundida}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Celular, StringFormat='+51 {0}'}" FontSize="17" VerticalOptions="Center"
                               TextColor="{StaticResource ColorTexto}" />
                        <Border Grid.Column="1" Style="{StaticResource ChipExito}" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4">
                                <v:Icono Nombre="exito" Color="{StaticResource ColorExito}" Tamano="14" VerticalOptions="Center" />
                                <Label Text="Verificado" Style="{StaticResource TextoChip}" TextColor="{StaticResource ColorExito}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <v:Aviso Emergente="True" Tipo="{Binding TipoMensaje}" Texto="{Binding Mensaje}" Mostrar="{Binding HayMensaje}" />

                <v:CamposDatosCiudadano x:Name="Campos" Margin="0,8,0,0" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Margin="0,8,0,0">
                    <CheckBox IsChecked="{Binding AceptaTerminos}" Color="{StaticResource ColorPrimario}" VerticalOptions="Start"
                              SemanticProperties.Description="Acepto los términos de uso y el tratamiento de mis datos" />
                    <Label Grid.Column="1" Text="Acepto los términos de uso y el tratamiento de mis datos para atender mis casos."
                           VerticalOptions="Center" FontSize="15" TextColor="{StaticResource ColorTexto}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AlTocarAceptacion" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Label Text="{Binding ErrorTerminos}" Style="{StaticResource ErrorCampo}" IsVisible="{Binding HayErrorTerminos}" />
                <Button Text="Leer los términos" Style="{StaticResource BotonTerciario}" Command="{Binding AlternarTerminos}" HorizontalOptions="Start" />
                <Border Style="{StaticResource Superficie}" Padding="16" IsVisible="{Binding MostrarTerminos}">
                    <Label Text="{Binding Terminos}" Style="{StaticResource TextoSecundario}" />
                </Border>

                <Button Text="Continuar" Style="{StaticResource BotonPrincipal}" Command="{Binding Continuar}" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
