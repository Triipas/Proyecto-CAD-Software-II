<?xml version="1.0" encoding="utf-8" ?>
<!-- Pantalla principal del ciudadano: HU06 (ubicación al abrir), HU07/HU08 (SOS con una única activación), acceso al reporte (HU10) y al acompañamiento (HU34). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cad.Movil.VistasModelo"
             xmlns:v="clr-namespace:Cad.Movil.Vistas"
             x:Class="Cad.Movil.Vistas.InicioCiudadanoPagina"
             x:DataType="vm:InicioCiudadanoVistaModelo"
             Title="Inicio">
    <ScrollView>
        <VerticalStackLayout Padding="16,24" Spacing="16" MaximumWidthRequest="480">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="Ciudadano" Style="{StaticResource Sobretitulo}" />
                    <Label Text="Pedir ayuda" Style="{StaticResource Titulo}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Salir" Style="{StaticResource BotonSecundario}" Command="{Binding Salir}" VerticalOptions="Center" />
            </Grid>
            <Label Text="Finaliza tu acompañamiento antes de salir." Style="{StaticResource TextoSecundario}" IsVisible="{Binding AcompanamientoEnCurso}" />

            <!-- HU34-CA08: el acompañamiento activo y su tiempo restante siguen visibles. -->
            <v:Aviso Tipo="informacion" Texto="{Binding TextoAcompanamiento}" IsVisible="{Binding AcompanamientoEnCurso}" />

            <!-- HU06: estado del permiso de ubicación (sin transmitir nada). -->
            <v:Aviso Tipo="{Binding TipoAvisoUbicacion}" Texto="{Binding TextoUbicacion}" />
            <Button Text="Continuar y permitir la ubicación" Style="{StaticResource BotonPrincipal}"
                    Command="{Binding PermitirUbicacion}" IsVisible="{Binding MostrarExplicacion}" />
            <Button Text="Abrir los ajustes del teléfono" Style="{StaticResource BotonSecundario}"
                    Command="{Binding AbrirAjustes}" IsVisible="{Binding MostrarAjustes}" />

            <!-- HU07: un toque inicia el SOS, sin formulario ni confirmación. -->
            <Border Style="{StaticResource Superficie}" Padding="16,24">
                <VerticalStackLayout Spacing="16">
                    <Button x:Name="BotonSos"
                            Text="{Binding TextoBotonSos}"
                            Command="{Binding EmitirSos}"
                            WidthRequest="200" HeightRequest="200" CornerRadius="100"
                            HorizontalOptions="Center"
                            BackgroundColor="{StaticResource ColorUrgente}" TextColor="White"
                            FontSize="40" FontAttributes="Bold"
                            SemanticProperties.Description="Emitir SOS"
                            SemanticProperties.Hint="Envía una alerta urgente a la central con una sola pulsación, sin confirmación">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource ColorUrgenteActivo}" />
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontSize" Value="22" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                    <Label Text="Pulsa una vez para pedir ayuda urgente. No se pide confirmación." Style="{StaticResource TextoSecundario}" HorizontalTextAlignment="Center" />

                    <v:Aviso Tipo="{Binding TipoAvisoSos}" Texto="{Binding TextoSos}" IsVisible="{Binding HayEstadoSos}" />
                    <Button Text="Reintentar el mismo SOS" Style="{StaticResource BotonPrincipal}"
                            Command="{Binding Reintentar}" IsVisible="{Binding PuedeReintentar}" />
                    <Button Text="Volver a ingresar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding Salir}" IsVisible="{Binding SesionTerminada}" />
                </VerticalStackLayout>
            </Border>

            <!-- HU10: un reporte es para lo que no es urgente; la central lo revisa después. -->
            <Border Style="{StaticResource Superficie}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="¿No es urgente?" FontAttributes="Bold" />
                    <Label Text="Reporta una incidencia con su tipo, descripción, lugar y hora. La central la revisará." Style="{StaticResource TextoSecundario}" />
                    <Button Text="Reportar una incidencia" Style="{StaticResource BotonSecundario}" Command="{Binding Reportar}"
                            SemanticProperties.Hint="Abre el formulario de reporte; no es una alerta urgente" />
                </VerticalStackLayout>
            </Border>

            <!-- HU34: control independiente del SOS y del reporte (CA05). -->
            <Border Style="{StaticResource Superficie}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="¿Vas a hacer un trayecto?" FontAttributes="Bold" />
                    <Label Text="Comparte tu ubicación con la central hasta 30 minutos. No emite un SOS." Style="{StaticResource TextoSecundario}" />
                    <Button Text="Acompañamiento" Style="{StaticResource BotonSecundario}" Command="{Binding Acompanar}"
                            SemanticProperties.Hint="Abre el acompañamiento temporal; no emite un SOS ni registra un reporte" />
                </VerticalStackLayout>
            </Border>

            <!-- HU31: avisos de cambios de estado de los casos propios (bandeja dentro de la app). -->
            <v:Aviso Tipo="informacion" Texto="Tienes notificaciones nuevas sobre tus casos." IsVisible="{Binding HayNoLeidas}" />
            <Button Text="{Binding TextoNotificaciones}" Style="{StaticResource BotonSecundario}" Command="{Binding VerNotificaciones}"
                    SemanticProperties.Hint="Muestra los avisos de cambios de estado de tus casos" />

            <!-- HU30: estado y avances públicos de los SOS y reportes propios. -->
            <Button Text="Mis casos" Style="{StaticResource BotonSecundario}" Command="{Binding VerMisCasos}"
                    SemanticProperties.Hint="Muestra tus SOS y reportes con su estado" />

            <Label Text="MVP académico con datos simulados. No es un canal oficial de emergencias." Style="{StaticResource TextoSecundario}" FontSize="13" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
