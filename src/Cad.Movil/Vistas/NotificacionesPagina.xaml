<?xml version="1.0" encoding="utf-8" ?>
<!-- HU31 — bandeja de notificaciones: cambios del estado público de los casos propios, sin detalles del hecho.
     Rediseño CAD v2 (fase 4): pestaña «Avisos»; lo nuevo lleva un punto azul y la etiqueta «Nueva». -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cad.Movil.VistasModelo"
             xmlns:v="clr-namespace:Cad.Movil.Vistas"
             x:Class="Cad.Movil.Vistas.NotificacionesPagina"
             x:DataType="vm:NotificacionesVistaModelo"
             Title="Avisos">
    <RefreshView IsRefreshing="{Binding Cargando}" Command="{Binding Actualizar}" RefreshColor="{StaticResource ColorPrimario}">
        <ScrollView>
            <VerticalStackLayout Spacing="0">
                <v:EncabezadoPagina Titulo="Avisos" MostrarVolver="False" Ayuda="{Binding Resumen}" />

                <VerticalStackLayout Padding="16,20,16,32" Spacing="12" MaximumWidthRequest="480">
                    <v:Aviso Tipo="error" Texto="{Binding Mensaje}" IsVisible="{Binding HayMensaje}" />
                    <Button Text="Volver a ingresar" Style="{StaticResource BotonSecundario}" Command="{Binding VolverAIngresar}" IsVisible="{Binding SesionTerminada}" />

                    <VerticalStackLayout Spacing="8" Padding="16,32" IsVisible="{Binding SinNotificaciones}" HorizontalOptions="Center">
                        <v:Icono Nombre="campana" Color="{StaticResource ColorTextoSecundario}" Tamano="40" HorizontalOptions="Center" />
                        <Label Text="Aún no tienes notificaciones." Style="{StaticResource TituloMosaico}" HorizontalTextAlignment="Center" />
                        <Label Text="Te avisaremos aquí cuando cambie el estado de tus casos." Style="{StaticResource TextoSecundario}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Movimiento (fase 4): mientras llega la primera respuesta, la forma de la lista en lugar de una pantalla vacía. -->
                    <v:Esqueleto IsVisible="{Binding PrimeraCarga}" />

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Notificaciones}" v:Movimiento.EntradaEscalonada="True">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ElementoNotificacion">
                                <Grid>
                                    <Border Style="{StaticResource Superficie}" Padding="16">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                            <Grid Grid.RowSpan="2" WidthRequest="36" HeightRequest="36" VerticalOptions="Start">
                                                <Ellipse Fill="{StaticResource ColorInformacionFondo}" />
                                                <v:Icono Nombre="campana" Color="{StaticResource ColorInformacion}" Tamano="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Ellipse Fill="{StaticResource ColorPrimario}" Stroke="White" StrokeThickness="2" WidthRequest="12" HeightRequest="12"
                                                         HorizontalOptions="End" VerticalOptions="Start" IsVisible="{Binding NoLeida}" />
                                            </Grid>
                                            <Label Grid.Column="1" Text="{Binding Texto}" Style="{StaticResource TituloMosaico}" FontSize="15" />
                                            <Label Grid.Column="1" Grid.Row="1" Style="{StaticResource TextoSecundario}" FontSize="13">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Estado}" FontFamily="PublicSansSemiBold" />
                                                        <Span Text=" · " />
                                                        <Span Text="{Binding Fecha}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <v:Icono Grid.Column="2" Grid.RowSpan="2" Nombre="derecha" Color="{StaticResource ColorTextoSecundario}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                    <Button BackgroundColor="Transparent" BorderWidth="0" Command="{Binding Abrir}"
                                            SemanticProperties.Description="{Binding Descripcion}" SemanticProperties.Hint="Abre el caso" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
