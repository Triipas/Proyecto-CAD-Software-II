@model Cad.Server.Panel.Pages.Central.ListaSos
@using System.Globalization
@{
    var inv = CultureInfo.InvariantCulture;
}
@* Fragmento de la sección urgente. Lo genera el servidor tanto en la carga inicial como al resincronizar. *@
<div data-lista-sos data-total="@Model.Pendientes.Count">
    @if (Model.Pendientes.Count == 0)
    {
        <div class="estado-vacio">
            <partial name="_Icono" model="@("exito")" />
            <p class="aviso__titulo">No hay SOS pendientes</p>
            <p>Los nuevos SOS aparecerán aquí sin recargar la página.</p>
        </div>
    }
    else
    {
        <ol class="lista-sos">
            @foreach (var sos in Model.Pendientes)
            {
                var local = TimeZoneInfo.ConvertTime(sos.RegistradoEn, Model.ZonaHoraria);
                <li class="sos" id="sos-@sos.Id" tabindex="-1" data-sos="@sos.Id" data-ciudadano="@sos.Ciudadano"
                    data-lat="@sos.Latitud?.ToString(inv)" data-lon="@sos.Longitud?.ToString(inv)"
                    data-precision="@sos.PrecisionMetros?.ToString("0", inv)" data-hora="@local.ToString("HH:mm", inv)"
                    data-clase="@(sos.Tipo ?? Cad.Server.Modulos.Consultas.SosPendiente.TipoPorDeterminar)" data-detalle="/panel/central/sos/@sos.Id">
                    <div class="sos__cabecera">
                        <span class="etiqueta-urgente"><partial name="_Icono" model="@("urgente")" />@sos.Origen</span>
                        <span class="sos__estado">@sos.Estado</span>
                        <time class="sos__hora" datetime="@sos.RegistradoEn.ToString("O", inv)">@local.ToString("HH:mm:ss", inv)</time>
                    </div>
                    @* 24/10/2026: elegir el caso es la acción de la tarjeta (el nombre es el botón; con el ratón, toda la tarjeta):
                       el mapa lo encuadra con su sereno sugerido y se abren los serenos para asignar. *@
                    <button type="button" class="sos__ciudadano sos__seleccionar" data-seleccionar-sos aria-pressed="false">@sos.Ciudadano<span class="visualmente-oculto">: elegir este SOS para asignarlo</span></button>
                    @* HU13-CA03: el tipo se muestra siempre; sin clasificar, «Tipo por determinar». *@
                    <p class="sos__tipo@(sos.Tipo is null ? " sos__tipo--pendiente" : "")" data-tipo>@(sos.Tipo is null ? Cad.Server.Modulos.Consultas.SosPendiente.TipoPorDeterminar : $"Tipo: {sos.Tipo}")</p>
                    @if (sos.UbicacionDisponible)
                    {
                        <p class="sos__dato-ubicacion">
                            <partial name="_Icono" model="@("ubicacion")" />
                            <span>Ubicación disponible · ± @sos.PrecisionMetros?.ToString("0", inv) m</span>
                        </p>
                    }
                    else
                    {
                        <p class="sos__ubicacion sos__ubicacion--no">
                            <partial name="_Icono" model="@("advertencia")" />
                            <span>Ubicación no disponible</span>
                        </p>
                    }
                    <div class="sos__acciones">
                        <a class="sos__detalle" href="/panel/central/sos/@sos.Id">Verificar y registrar contacto<span class="visualmente-oculto"> del SOS de @sos.Ciudadano</span></a>
                    </div>
                </li>
            }
        </ol>
    }
</div>
