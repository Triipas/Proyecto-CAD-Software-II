@page "/panel/central"
@model Cad.Server.Panel.Pages.Central.IndexModel
@inject Cad.Server.Modulos.Asistencia.ConsultarAsistencia ConsultarAsistencia
@{
    ViewData["Title"] = "Central";
    // Dirección «Mapa protagonista» (rediseño CAD v2, fase 3): el mapa ocupa la pantalla y el trabajo flota encima.
    ViewData["ClasePagina"] = "pagina--central";
}
@section Estilos {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/central.css" asp-append-version="true" />
}
@section IndicadoresBarra {
    @* Lo primero que ve el operador: cuántos SOS hay y con cuántos serenos cuenta. 05/11/2026: cada cifra lleva a lo que cuenta
       (los SOS de la bandeja, el panel de serenos); «por asignar» ya se ve en la bandeja. central.js los mantiene al día. *@
    <ul class="barra__indicadores" aria-label="Situación de la central">
        <li class="indicador indicador--sos@(Model.Pendientes.Count > 0 ? " indicador--activo" : "")" data-indicador="sos"><a href="#titulo-urgente" data-ir-sos><b data-valor>@Model.Pendientes.Count</b> SOS</a></li>
        <li class="indicador" data-indicador="serenos-libres">
            <button type="button" class="indicador__boton" aria-controls="panel-serenos" aria-expanded="false" data-abrir-serenos>
                <b data-valor>@Model.SerenosOperativos</b> <span data-etiqueta>de @Model.SerenosRegistrados @(Model.SerenosRegistrados == 1 ? "sereno activo" : "serenos activos")</span>
            </button>
        </li>
        <li class="indicador"><a href="/panel/acompanamientos"><b>@Model.AcompanamientosActivos</b> @(Model.AcompanamientosActivos == 1 ? "acompañamiento" : "acompañamientos")</a></li>
    </ul>
}
<h1 class="visualmente-oculto titulo">Central de monitoreo</h1>

@* Bandeja y mapa (05/11/2026): la bandeja es una columna fija con el trabajo en el orden en que se hace (SOS, reportes por
   revisar, por asignar y en curso); el mapa ocupa el resto. Los serenos y la leyenda se abren encima del mapa cuando se piden
   y lo tapan sin moverlo. *@
<div class="central">
    @{ var admision = await ConsultarAsistencia.AjusteAsync(ViewContext.HttpContext.RequestAborted); }
    <section class="bandeja" id="panel-cola" aria-labelledby="titulo-cola">
        <div class="bandeja__cabecera">
            <h2 class="bandeja__titulo" id="titulo-cola">Bandeja</h2>
            @* Estado del canal en tiempo real: icono + texto + color (nunca solo color). Conectado es un punto discreto; si se
               corta, el aviso se hace visible (central.css). *@
            <p class="conexion conexion--conectando" role="status" data-conexion data-estado="conectando">
                <span data-icono="conectando"><partial name="_Icono" model="@("informacion")" /></span>
                <span data-icono="conectado"><partial name="_Icono" model="@("exito")" /></span>
                <span data-icono="reconectando"><partial name="_Icono" model="@("advertencia")" /></span>
                <span data-icono="desconectado"><partial name="_Icono" model="@("error")" /></span>
                <span data-texto>Conectando al tiempo real…</span>
            </p>
        </div>
        @* Pestañas de la bandeja (05/11/2026): SOS, reportes (por revisar y por asignar) y en curso. La elegida decide también qué
           casos se ven en el mapa (los serenos siempre); central.js la recuerda y avisa en «SOS» si llega uno mientras se mira
           otra. Sin JS se ven las tres secciones seguidas, como antes. *@
        <div class="bandeja__pestanas" role="tablist" aria-label="Qué casos ver" data-pestanas hidden>
            <button type="button" class="bandeja__pestana bandeja__pestana--sos" role="tab" id="pestana-sos" aria-controls="grupo-sos" aria-selected="true" data-pestana="sos">
                SOS <span class="bandeja__pestana-cifra" data-cifra-pestana="sos">@Model.Pendientes.Count</span>
            </button>
            <button type="button" class="bandeja__pestana bandeja__pestana--reportes" role="tab" id="pestana-reportes" aria-controls="grupo-reportes" aria-selected="false" tabindex="-1" data-pestana="reportes">
                Reportes <span class="bandeja__pestana-cifra" data-cifra-pestana="reportes">@(Model.PorRevisar.Reportes.Count + Model.ReportesAdmitidos.Count)</span>
            </button>
            <button type="button" class="bandeja__pestana bandeja__pestana--en-curso" role="tab" id="pestana-en-curso" aria-controls="grupo-en-curso" aria-selected="false" tabindex="-1" data-pestana="en-curso">
                En curso <span class="bandeja__pestana-cifra" data-cifra-pestana="en-curso">@Model.Asignados.Count</span>
            </button>
        </div>
        <div class="bandeja__cuerpo" id="cuerpo-cola">
            <div class="bandeja__pestana-panel" id="grupo-sos" role="tabpanel" aria-labelledby="pestana-sos" data-grupo-pestana="sos">
            <section class="central__urgente bandeja__grupo" aria-labelledby="titulo-urgente" data-avisos-sonoros="0"
                     data-medicion="@(Model.MedicionActiva ? "true" : "false")" tabindex="-1">
                <h3 id="titulo-urgente" class="central__titulo">
                    Atención urgente · SOS <span class="central__contador" data-contador>@Model.Pendientes.Count</span>
                </h3>
                @* HU09-CA02 — aviso de un SOS cancelado por su titular (lo muestra central.js al recibirlo). *@
                <div class="aviso aviso--advertencia central__aviso" role="status" data-aviso-cancelacion hidden>
                    <partial name="_Icono" model="@("advertencia")" />
                    <p class="aviso__texto"><span data-texto></span> <a href="#">Ver historial</a></p>
                </div>
                <div data-region-lista>
                    <partial name="_ListaSos" model="@Model.Lista" />
                </div>
            </section>
            </div>

            <div class="bandeja__pestana-panel" id="grupo-reportes" role="tabpanel" aria-labelledby="pestana-reportes" data-grupo-pestana="reportes">
            @* HU14 en la central (05/11/2026): los reportes recibidos y en revisión, con el modo de la admisión automática (HU45). *@
            <section class="central__revisar bandeja__grupo" aria-labelledby="titulo-revisar">
                <h3 id="titulo-revisar" class="central__titulo">
                    Por revisar · reportes <span class="central__contador central__contador--revisar" data-contador-revisar>@Model.PorRevisar.Reportes.Count</span>
                </h3>
                <partial name="_AdmisionAutomatica" model="admision" />
                <div data-region-revisar>
                    <partial name="_ListaPorRevisar" model="@Model.PorRevisar" />
                </div>
            </section>

            @* HU15-CA02 y HU20-CA07 — reportes admitidos, separados de los SOS (no son urgentes) y asignables igual. *@
            <section class="central__reportes bandeja__grupo" aria-labelledby="titulo-reportes">
                <h3 id="titulo-reportes" class="central__titulo">
                    Por asignar · reportes <span class="central__contador central__contador--reportes" data-contador-reportes>@Model.ReportesAdmitidos.Count</span>
                </h3>
                <div data-region-reportes>
                    <partial name="_ListaReportes" model="@Model.ListaDeReportes" />
                </div>
            </section>
            </div>

            <div class="bandeja__pestana-panel" id="grupo-en-curso" role="tabpanel" aria-labelledby="pestana-en-curso" data-grupo-pestana="en-curso">
            @* Los casos que ya tienen sereno siguen a la vista, tras los pendientes: al elegir uno, el mapa va a él y dibuja solo
               entonces el recorrido de su sereno. *@
            <section class="central__asignados bandeja__grupo" aria-labelledby="titulo-asignados">
                <h3 id="titulo-asignados" class="central__titulo">
                    En curso · con sereno <span class="central__contador central__contador--asignados" data-contador-asignados>@Model.Asignados.Count</span>
                </h3>
                <div data-region-asignados>
                    <partial name="_ListaAsignados" model="@Model.ListaDeAsignados" />
                </div>
            </section>
            </div>
        </div>
        @* Anuncio de un SOS nuevo o cancelado para el lector de pantalla: fuera de las pestañas, para que se oiga aunque «SOS» no
           sea la pestaña que se mira (sus paneles ocultos salen del árbol de accesibilidad). *@
        <p class="visualmente-oculto" aria-live="assertive" data-anuncio></p>
    </section>

    <div class="central__mapa">
        <div id="mapa" class="mapa mapa--central" data-centro-lat="@Model.CentroLatitud" data-centro-lon="@Model.CentroLongitud"
             data-zoom="@Model.Zoom" data-teselas="@Model.UrlTeselas" role="region" aria-label="Mapa de casos y serenos con ubicación"></div>

        @* Herramientas del mapa: los serenos (con su cifra) y las capas con la clave de iconos. Abren paneles encima del mapa. *@
        <div class="mapa-herramientas">
            <button type="button" class="mapa-herramientas__boton" aria-controls="panel-serenos" aria-expanded="false" data-abrir-serenos>
                <i class="leyenda-icono leyenda-icono--sereno marcador-sereno" data-muestra="sereno" aria-hidden="true"></i>
                <span><b data-serenos-activos>@Model.SerenosOperativos</b> de <span data-serenos-registrados>@Model.SerenosRegistrados</span> activos</span>
            </button>
            <button type="button" class="mapa-herramientas__boton leyenda-mapa__clave" aria-expanded="false" aria-controls="clave-mapa" data-abrir-clave>
                <partial name="_Icono" model="@("informacion")" />Capas y leyenda
            </button>
        </div>

        @if (Model.Mensaje is not null || Model.ErrorAccion is not null)
        {
            <div class="central__avisos">
                @if (Model.Mensaje is not null)
                {
                    <div class="aviso aviso--exito central__aviso" role="status" tabindex="-1" data-enfocar>
                        <partial name="_Icono" model="@("exito")" />
                        <div>
                            <p class="aviso__titulo">@Model.Mensaje</p>
                            <p class="aviso__texto">@Model.DetalleMensaje</p>
                        </div>
                    </div>
                }
                @if (Model.ErrorAccion is not null)
                {
                    <div class="aviso aviso--error central__aviso" role="alert" tabindex="-1" data-enfocar>
                        <partial name="_Icono" model="@("error")" />
                        <div>
                            <p class="aviso__titulo">No se pudo asignar el caso</p>
                            <p class="aviso__texto">@Model.ErrorAccion</p>
                        </div>
                    </div>
                }
            </div>
        }

        @* HU19 — estado y disponibilidad de los serenos, actualizados sin recargar. Se abre desde su cifra (cabecera o mapa) o al
           tocar un sereno en el mapa, y tapa el mapa sin moverlo. *@
        <section class="panel-flotante serenos-flotante" id="panel-serenos" aria-labelledby="titulo-serenos" data-panel hidden>
            <div class="panel-flotante__cabecera">
                <h2 class="panel-flotante__titulo" id="titulo-serenos">Serenos</h2>
                <button type="button" class="panel-flotante__plegar" data-cerrar-serenos>
                    <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" /></svg>
                    <span class="visualmente-oculto">Cerrar la lista de serenos</span>
                </button>
            </div>
            <div class="panel-flotante__cuerpo" id="cuerpo-serenos">
                <p class="central__ayuda">Disponible: operativo y sin caso asignado. Elige un sereno para verlo en el mapa.</p>
                @* Filtro por nombre: la lista crece y buscar a ojo no escala. central.js lo reaplica al resincronizar. *@
                <div class="serenos-filtro">
                    <div class="campo-busqueda">
                        <label class="visualmente-oculto" for="filtro-serenos">Buscar un sereno por nombre</label>
                        <span class="campo-busqueda__icono"><partial name="_Icono" model="@("lupa")" /></span>
                        <input class="campo__control campo-busqueda__control" id="filtro-serenos" type="search" placeholder="Buscar sereno por nombre" autocomplete="off" data-filtro-serenos />
                    </div>
                    <p class="texto-secundario" role="status" data-sin-coincidencias hidden>Ningún sereno se llama así.</p>
                </div>
                <div data-region-serenos>
                    <partial name="_ListaSerenos" model="@Model.ListaDeSerenos" />
                </div>
            </div>
        </section>

        @* Capas y clave de iconos (05/11/2026): cada capa se puede ocultar, con el icono que la representa, y cada marcador y cada
           línea se explican tal como se ven (central.js dibuja las muestras con marcadores.js, las mismas que el mapa). *@
        <section class="clave-mapa" id="clave-mapa" aria-labelledby="titulo-clave-mapa" hidden data-clave-mapa>
            <div class="clave-mapa__cabecera">
                <h2 class="clave-mapa__titulo" id="titulo-clave-mapa">Capas y leyenda</h2>
                <button type="button" class="clave-mapa__cerrar" aria-label="Cerrar las capas y la leyenda" data-cerrar-clave>×</button>
            </div>
            <div class="leyenda-mapa" role="group" aria-label="Capas del mapa">
                <button type="button" aria-pressed="true" data-capa="sos"><i class="leyenda-icono marcador-sos" data-muestra="sos" aria-hidden="true"></i>SOS</button>
                <button type="button" aria-pressed="true" data-capa="reporte"><i class="leyenda-icono marcador-reporte" data-muestra="reporte" aria-hidden="true"></i>Reportes</button>
                <button type="button" aria-pressed="true" data-capa="sereno"><i class="leyenda-icono leyenda-icono--sereno marcador-sereno" data-muestra="sereno" aria-hidden="true"></i>Serenos</button>
            </div>
            <div class="clave-mapa__grupos">
                <div>
                    <h3 class="clave-mapa__grupo">Casos</h3>
                    <p class="clave-mapa__nota">La forma dice qué es: cuadrado, SOS; círculo, reporte. El relleno dice en qué va.</p>
                    <ul class="clave-mapa__lista">
                        <li><i class="leyenda-icono marcador-sos" data-muestra="sos" aria-hidden="true"></i><span><b>SOS por asignar</b> Color lleno: espera a un sereno.</span></li>
                        <li><i class="leyenda-icono marcador-sos marcador-caso--en-curso" data-muestra="sos" aria-hidden="true"></i><span><b>SOS en curso</b> Blanco con borde: ya tiene sereno.</span></li>
                        <li><i class="leyenda-icono marcador-reporte" data-muestra="reporte" aria-hidden="true"></i><span><b>Reporte admitido</b> Color lleno: espera a un sereno.</span></li>
                        <li><i class="leyenda-icono marcador-reporte marcador-caso--en-curso marcador-caso--revision" data-muestra="reporte" aria-hidden="true"></i><span><b>Reporte por revisar</b> Borde discontinuo: recibido o en revisión.</span></li>
                        <li><i class="leyenda-icono marcador-reporte marcador-caso--en-curso" data-muestra="reporte" aria-hidden="true"></i><span><b>Reporte en curso</b> Blanco con borde: ya tiene sereno.</span></li>
                    </ul>
                </div>
                <div>
                    <h3 class="clave-mapa__grupo">Serenos</h3>
                    <ul class="clave-mapa__lista">
                        <li><i class="leyenda-icono leyenda-icono--sereno marcador-sereno" data-muestra="sereno" aria-hidden="true"></i><span><b>Disponible</b> Operativo y sin caso: se le puede asignar.</span></li>
                        <li><i class="leyenda-icono leyenda-icono--sereno marcador-sereno marcador-sereno--no-disponible" data-muestra="sereno-ocupado" aria-hidden="true"></i><span><b>No disponible</b> Con un caso o fuera de servicio.</span></li>
                        <li><i class="leyenda-icono leyenda-icono--conjunto" data-muestra="en-el-lugar" aria-hidden="true"></i><span><b>En el lugar</b> El escudo sobre el caso: su sereno ya llegó.</span></li>
                    </ul>
                    <h3 class="clave-mapa__grupo">Líneas y anillos</h3>
                    <ul class="clave-mapa__lista">
                        <li><i class="leyenda-linea leyenda-linea--despacho" aria-hidden="true"></i><span><b>Sereno sugerido</b> Del caso elegido al disponible más cercano, con la distancia en línea recta.</span></li>
                        <li><i class="leyenda-linea leyenda-linea--recorrido" aria-hidden="true"></i><span><b>Recorrido</b> Por las calles, del sereno asignado hasta su caso.</span></li>
                        <li><i class="leyenda-icono leyenda-icono--sonar" aria-hidden="true"><span></span></i><span><b>Anillos</b> El último caso que llegó; se apagan al abrirlo.</span></li>
                    </ul>
                </div>
            </div>
        </section>

        @* Asignación rápida: al elegir un caso aparece aquí el sereno disponible más cercano (un clic) y un buscador por nombre
           (se enfoca con «/»; flechas y Intro). No hace falta abrir el panel de serenos. Pide la misma confirmación que el panel. *@
        <section class="asignar-rapido" aria-label="Asignar el caso elegido" data-asignar-rapido hidden>
            <div class="asignar-rapido__cabecera">
                <h2 class="asignar-rapido__titulo" data-ar-caso></h2>
                <button type="button" class="asignar-rapido__cerrar" data-ar-cerrar aria-label="Cerrar la asignación rápida">
                    <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>
            <p class="texto-secundario" data-ar-vacio hidden>No hay serenos disponibles en este momento.</p>
            <div class="asignar-rapido__fila" data-ar-fila>
                <button type="button" class="boton boton--principal asignar-rapido__sugerido" data-ar-sugerido hidden>
                    <span class="asignar-rapido__accion" data-ar-sugerido-nombre></span>
                    <span class="asignar-rapido__meta" data-ar-sugerido-meta></span>
                </button>
                <div class="campo-busqueda asignar-rapido__buscar">
                    <label class="visualmente-oculto" for="ar-buscar">Buscar otro sereno disponible por nombre</label>
                    <span class="campo-busqueda__icono"><partial name="_Icono" model="@("lupa")" /></span>
                    <input class="campo__control campo-busqueda__control" id="ar-buscar" type="search" role="combobox" aria-expanded="false" aria-controls="ar-lista"
                           aria-autocomplete="list" placeholder="Buscar otro sereno" autocomplete="off" data-ar-buscar />
                    <kbd class="asignar-rapido__atajo" aria-hidden="true">/</kbd>
                    <ul class="asignar-rapido__lista" id="ar-lista" role="listbox" aria-label="Serenos disponibles" data-ar-lista hidden></ul>
                </div>
            </div>
            <p class="visualmente-oculto" role="status" data-ar-anuncio></p>
        </section>

        @* Panel del caso (05/11/2026): el detalle del SOS o del reporte elegido, en su modo panel (Panel/ModoPanel.cs), encima
           del mapa y sin moverlo. Se abre desde la acción de cada tarjeta y desde el globo del mapa; avisa a la central tras cada
           paso (panel-caso.js) y se cierra solo cuando el caso sale del trabajo pendiente. *@
        <section class="panel-caso" id="panel-caso" aria-labelledby="titulo-panel-caso" data-panel data-panel-caso hidden>
            <h2 class="visualmente-oculto" id="titulo-panel-caso" data-panel-titulo>Caso elegido</h2>
            <div class="panel-caso__marco-cabecera">
                <button type="button" class="panel-caso__cerrar" data-cerrar-panel>
                    <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" /></svg>
                    <span class="visualmente-oculto">Cerrar el caso</span>
                </button>
            </div>
            <iframe class="panel-caso__marco" name="panel-caso" title="Caso elegido" data-marco-caso></iframe>
        </section>
        <p class="central__aviso-flotante" role="status" data-aviso-flotante hidden></p>

        <div data-region-casos-mapa>
            <partial name="_CasosMapa" model="@Model.CasosEnMapa" />
        </div>
    </div>
    <noscript><p class="central__sin-js">El mapa y los avisos en tiempo real necesitan JavaScript. La lista se actualiza al recargar.</p></noscript>
</div>

@* HU20 — confirmación de la asignación: diálogo modal que abre la barra de asignación rápida con un sereno disponible
   (un SOS o un reporte admitido). Es un formulario normal (PRG) con token antifalsificación. *@
<form method="post" class="velo" data-confirmar-asignacion data-formulario hidden novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="Asignacion.SerenoId" data-campo-sereno />
    <input type="hidden" name="Asignacion.IdSolicitud" data-campo-solicitud />
    <input type="hidden" name="Asignacion.Volver" value="central" />
    <div class="dialogo" role="dialog" aria-modal="true" aria-labelledby="titulo-asignacion">
        <h2 class="dialogo__titulo" id="titulo-asignacion" data-texto-confirmacion></h2>
        <p class="dialogo__texto">El sereno recibirá el despacho en su teléfono.</p>
        <div class="dialogo__acciones">
            <button type="button" class="boton boton--secundario" data-cancelar-asignacion>Cancelar</button>
            <button type="submit" class="boton boton--principal" data-texto-carga="Asignando…">Confirmar asignación</button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/marcadores.js" asp-append-version="true"></script>
    <script src="~/js/central.js" asp-append-version="true"></script>
}
