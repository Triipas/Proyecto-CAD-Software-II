@model Cad.Server.Panel.Pages.Central.ListaSerenos
@using System.Globalization
@{
    var inv = CultureInfo.InvariantCulture;
    var operativos = Model.Serenos.Count(s => s.Operativo);
    var disponibles = Model.Serenos.Count(s => s.Disponible);
    var conCaso = Model.Serenos.Count(s => !s.Disponible && s.ConAsignacion);
    var fuera = Model.Serenos.Count(s => !s.Disponible && !s.ConAsignacion);
    var ahora = DateTimeOffset.UtcNow;
}
@functions {
    // Las dos primeras iniciales del nombre, para el escudo (el mismo del marcador del mapa).
    static string Iniciales(string nombre) =>
        string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    // «hace 18 s», «hace 4 min»: lo que central.js sigue contando hasta la próxima resincronización.
    static string Edad(double segundos) => segundos < 60 ? $"hace {(int)segundos} s" : segundos < 3600 ? $"hace {(int)(segundos / 60)} min" : $"hace {(int)(segundos / 3600)} h";
}
@* HU19 — fragmento de serenos. Lo genera el servidor en la carga inicial y al resincronizar (HU19-CA03).
   06/11/2026: tablero en filas (escudo, estado, edad de la posición y distancia) en vez de tarjetas iguales; central.js pone la
   distancia (al caso elegido en «Disponibles», a su propio caso en «Con caso») y cuenta la edad de la posición. *@
<div data-lista-serenos data-operativos="@operativos" data-disponibles="@disponibles" data-con-caso="@conCaso" data-fuera="@fuera"
     data-registrados="@Model.Registrados" data-umbral-antigua="@ListaSerenos.UmbralPosicionAntiguaSegundos">
    @if (Model.Serenos.Count == 0)
    {
        <p class="texto-secundario">No hay cuentas de sereno activas.</p>
    }
    else
    {
        if (disponibles == 0)
        {
            <p class="serenos__sin-libres" role="status" data-sin-disponibles>
                <partial name="_Icono" model="@("advertencia")" />
                <span>@(operativos == 0 ? "Ningún sereno está operativo." : "Ningún sereno disponible: todos los operativos tienen un caso.")</span>
            </p>
        }
        @* Agrupados por lo que importa al asignar: disponibles, con caso y fuera de servicio (este, plegado). *@
        @foreach (var (titulo, grupo, clave) in new[]
        {
            ("Disponibles", Model.Serenos.Where(s => s.Disponible).ToList(), "disponibles"),
            ("Con caso", Model.Serenos.Where(s => !s.Disponible && s.ConAsignacion).ToList(), "con-caso"),
            ("Fuera de servicio", Model.Serenos.Where(s => !s.Disponible && !s.ConAsignacion).ToList(), "fuera"),
        })
        {
            if (grupo.Count == 0) continue;
            <section class="serenos__grupo serenos__grupo--@clave" data-grupo-serenos="@clave" aria-label="@titulo">
                <h3 class="serenos__grupo-titulo">
                    @if (clave == "fuera")
                    {
                        <button type="button" class="serenos__plegar" aria-expanded="false" aria-controls="lista-serenos-fuera" data-plegar-grupo>
                            <partial name="_Icono" model="@("izquierda")" />@titulo <span>@grupo.Count</span>
                        </button>
                    }
                    else
                    {
                        @titulo <span>@grupo.Count</span>
                    }
                    @if (clave == "disponibles")
                    {
                        <small class="serenos__columna" data-columna="disponibles" hidden>distancia al caso elegido</small>
                    }
                    else if (clave == "con-caso")
                    {
                        <small class="serenos__columna" data-columna="con-caso" hidden>distancia a su caso</small>
                    }
                </h3>
                <ul class="lista-serenos" @(clave == "fuera" ? "id=lista-serenos-fuera" : "")>
                    @foreach (var (sereno, orden) in grupo.Select((s, i) => (s, i)))
                    {
                        var conUbicacion = sereno.UbicacionDisponible && sereno.UltimaPosicionEn is not null;
                        var hora = sereno.UltimaPosicionEn is { } h ? TimeZoneInfo.ConvertTime(h, Model.ZonaHoraria).ToString("HH:mm:ss", inv) : "";
                <li class="sereno sereno--@clave @(sereno.Disponible ? "sereno--disponible" : "")" id="sereno-@sereno.Id" tabindex="-1"
                    data-sereno="@sereno.Id" data-nombre="@sereno.Nombre" data-orden="@orden"
                    data-disponible="@(sereno.Disponible ? "true" : "false")"
                    data-lat="@sereno.Latitud?.ToString(inv)" data-lon="@sereno.Longitud?.ToString(inv)" data-caso="@sereno.CasoAsignadoId"
                    data-hora="@hora" data-clave="@sereno.Id">
                    <span class="sereno__escudo" aria-hidden="true">
                        <svg viewBox="0 0 32 36" focusable="false"><path d="M16 2 30 8v9c0 9-6 15-14 17C8 32 2 26 2 17V8z" /><text x="16" y="21" text-anchor="middle">@Iniciales(sereno.Nombre)</text></svg>
                    </span>
                    <div class="sereno__cuerpo">
                        <div class="sereno__cabecera">
                            @if (conUbicacion)
                            {
                                @* 29/10/2026: como en las tarjetas de SOS y reportes, la fila entera es el botón (el del nombre, extendido a
                                   toda la fila): lleva el mapa al sereno. Sin ubicación no hay a dónde llevarlo y el nombre es solo texto. *@
                                <button type="button" class="sereno__nombre sereno__seleccionar" data-ver-sereno aria-pressed="false">@sereno.Nombre<span class="visualmente-oculto">: ver su ubicación en el mapa</span></button>
                            }
                            else
                            {
                                <span class="sereno__nombre">@sereno.Nombre</span>
                            }
                        </div>
                        @if (sereno.Disponible)
                        {
                            <p class="sereno__estado" data-suave>
                                <span class="estado estado--activa"><partial name="_Icono" model="@("exito")" /><span class="visualmente-oculto">Operativo. </span>Disponible</span>
                                @if (conUbicacion && sereno.UltimaPosicionEn is { } recibida)
                                {
                                    var segundos = Math.Max(0, (ahora - recibida).TotalSeconds);
                                    var antigua = segundos >= ListaSerenos.UmbralPosicionAntiguaSegundos;
                                    @* Para el lector de pantalla, la hora exacta (no «hace N s», que cambia sola); a la vista, la edad. *@
                                    <span class="visualmente-oculto">Última ubicación a las @hora, precisión de @sereno.PrecisionMetros?.ToString("0", inv) metros.</span>
                                    <span class="sereno__edad@(antigua ? " sereno__edad--antigua" : "")" data-edad-s="@((int)segundos)" aria-hidden="true"
                                          title="Última ubicación a las @hora · ± @sereno.PrecisionMetros?.ToString("0", inv) m"><span class="sereno__edad-alerta" @(antigua ? "" : "hidden")><partial name="_Icono" model="@("advertencia")" /></span><span data-edad-texto>@Edad(segundos)</span></span>
                                }
                                else
                                {
                                    @* HU19-CA04: sin posiciones recibidas no hay marcador ni coordenadas inventadas. *@
                                    <span class="sereno__sin-ubicacion"><partial name="_Icono" model="@("informacion")" />Ubicación no disponible</span>
                                }
                            </p>
                            <p class="sereno__sugerido" data-distancia hidden></p>
                        }
                        else if (sereno.ConAsignacion)
                        {
                            if (!sereno.Operativo)
                            {
                                @* 24/10/2026 (DP16-b): se desactivó con un caso en curso; el caso sigue a su nombre. *@
                                <p class="sereno__alerta" data-desactivado-con-caso>
                                    <partial name="_Icono" model="@("advertencia")" />
                                    <span>Se desactivó con el caso en curso: sin ubicación, el caso sigue a su nombre.</span>
                                </p>
                            }
                            if (sereno.CasoAsignadoId is not null)
                            {
                                @* HU23-CA03: el estado del caso asignado se refleja en la central. 06/11/2026: con el tipo del caso (SOS o reporte). *@
                                <p class="sereno__caso" data-estado-caso="@sereno.EstadoCasoAsignado" data-suave>
                                    <span class="visualmente-oculto">Caso: </span>
                                    @if (sereno.CasoAsignadoEsReporte)
                                    {
                                        <span class="etiqueta-reporte">Reporte</span>
                                    }
                                    else
                                    {
                                        <span class="etiqueta-urgente"><partial name="_Icono" model="@("urgente")" />SOS</span>
                                    }
                                    @if (sereno.EstadoCasoAsignado is { } estadoCaso)
                                    {
                                        <partial name="_ChipEstado" model="@((estadoCaso, false))" />
                                    }
                                </p>
                            }
                            if (sereno.Operativo && !conUbicacion)
                            {
                                <p class="sereno__estado"><span class="sereno__sin-ubicacion"><partial name="_Icono" model="@("informacion")" />Ubicación no disponible</span></p>
                            }
                        }
                        else
                        {
                            @* Estar fuera de servicio es lo normal: sin aviso ámbar; la ubicación se comparte solo mientras está operativo (HU18). *@
                            <p class="sereno__estado sereno__estado--fuera">
                                <span class="estado estado--inactiva"><partial name="_Icono" model="@("informacion")" /><span class="visualmente-oculto">Fuera de servicio. </span>No comparte ubicación</span>
                            </p>
                        }
                    </div>
                    @if (sereno.Disponible || sereno.CasoAsignadoId is not null)
                    {
                        <div class="sereno__lateral">
                            <span class="sereno__metros" data-sereno-metros data-suave></span>
                            @if (sereno.CasoAsignadoId is { } casoAsignado)
                            {
                                <a class="sereno__ver" href="@(sereno.CasoAsignadoEsReporte ? $"/panel/reportes/{casoAsignado}" : $"/panel/central/sos/{casoAsignado}")">Ver el caso<span class="visualmente-oculto"> asignado a @sereno.Nombre</span></a>
                            }
                        </div>
                    }
                </li>
                    }
                </ul>
            </section>
        }
    }
</div>
