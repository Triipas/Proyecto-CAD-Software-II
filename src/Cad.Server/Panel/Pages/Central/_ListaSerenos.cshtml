@model Cad.Server.Panel.Pages.Central.ListaSerenos
@using System.Globalization
@{
    var inv = CultureInfo.InvariantCulture;
    var operativos = Model.Serenos.Count(s => s.Operativo);
    var disponibles = Model.Serenos.Count(s => s.Disponible);
}
@* HU19 — fragmento de serenos. Lo genera el servidor en la carga inicial y al resincronizar (HU19-CA03). *@
<div data-lista-serenos data-operativos="@operativos" data-disponibles="@disponibles">
    @if (Model.Serenos.Count == 0)
    {
        <p class="texto-secundario">No hay cuentas de sereno activas.</p>
    }
    else
    {
        <p class="texto-secundario" data-suave>@operativos operativo@(operativos == 1 ? "" : "s") · @disponibles disponible@(disponibles == 1 ? "" : "s")</p>
        <ul class="lista-serenos">
            @foreach (var sereno in Model.Serenos)
            {
                <li class="sereno @(sereno.Disponible ? "sereno--disponible" : "")" id="sereno-@sereno.Id" tabindex="-1" data-clave="@sereno.Id"
                    data-sereno="@sereno.Id" data-nombre="@sereno.Nombre"
                    data-disponible="@(sereno.Disponible ? "true" : "false")"
                    data-lat="@sereno.Latitud?.ToString(inv)" data-lon="@sereno.Longitud?.ToString(inv)" data-caso="@sereno.CasoAsignadoId"
                    data-hora="@(sereno.UltimaPosicionEn is { } h ? TimeZoneInfo.ConvertTime(h, Model.ZonaHoraria).ToString("HH:mm:ss", inv) : "")">
                    <div class="sereno__cabecera">
                        <span class="sereno__nombre">@sereno.Nombre</span>
                        <span class="estado @(sereno.Operativo ? "estado--activa" : "estado--inactiva")" data-suave>
                            <partial name="_Icono" model="@(sereno.Operativo ? "exito" : "informacion")" />@(sereno.Operativo ? "Operativo" : "No operativo")
                        </span>
                        <span class="sereno__disponibilidad" data-suave>@(sereno.Disponible ? "Disponible" : sereno.ConAsignacion ? "No disponible · con asignación vigente" : "No disponible")</span>
                    </div>
                    @if (!sereno.Operativo && sereno.ConAsignacion)
                    {
                        @* 24/10/2026 (DP16-b): se desactivó con un caso en curso; el caso sigue a su nombre. *@
                        <p class="sereno__alerta" data-desactivado-con-caso>
                            <partial name="_Icono" model="@("advertencia")" />
                            <span>Se desactivó con el caso en curso: no se ve su ubicación y el caso sigue a su nombre.</span>
                        </p>
                    }
                    @if (sereno.CasoAsignadoId is { } casoAsignado)
                    {
                        @* HU23-CA03: el estado del caso asignado se refleja en la central. *@
                        <p class="sereno__caso" data-estado-caso="@sereno.EstadoCasoAsignado" data-suave>
                            Caso @sereno.EstadoCasoAsignado · <a href="@(sereno.CasoAsignadoEsReporte ? $"/panel/reportes/{casoAsignado}" : $"/panel/central/sos/{casoAsignado}")">Ver el caso<span class="visualmente-oculto"> asignado a @sereno.Nombre</span></a>
                        </p>
                    }
                    @if (sereno.UbicacionDisponible && sereno.UltimaPosicionEn is { } recibida)
                    {
                        <p class="sereno__ubicacion">
                            <partial name="_Icono" model="@("reloj")" />
                            <span>Última ubicación a las @TimeZoneInfo.ConvertTime(recibida, Model.ZonaHoraria).ToString("HH:mm:ss", inv) · ± @sereno.PrecisionMetros?.ToString("0", inv) m</span>
                        </p>
                        @* Botón a la vista (antes era un texto con aspecto de enlace): lleva el mapa al sereno. *@
                        <button type="button" class="boton boton--secundario boton--compacto sereno__ubicar" data-ver-sereno
                                aria-label="Ubicar en el mapa al sereno @sereno.Nombre">
                            <partial name="_Icono" model="@("ubicacion")" />Ubicar en el mapa
                        </button>
                    }
                    else
                    {
                        @* HU19-CA04: sin posiciones recibidas (o sin compartirlas por no estar operativo) no hay
                           marcador ni coordenadas inventadas. *@
                        <p class="sos__ubicacion sos__ubicacion--no">
                            <partial name="_Icono" model="@("advertencia")" />
                            <span>Ubicación no disponible</span>
                        </p>
                    }
                    @if (sereno.Disponible)
                    {
                        @* HU20: visible solo con un SOS seleccionado (lo muestra el panel). *@
                        <button type="button" class="boton boton--secundario sereno__asignar" data-asignar-sereno hidden>
                            Asignar al caso seleccionado<span class="visualmente-oculto"> a @sereno.Nombre</span>
                        </button>
                    }
                </li>
            }
        </ul>
    }
</div>
