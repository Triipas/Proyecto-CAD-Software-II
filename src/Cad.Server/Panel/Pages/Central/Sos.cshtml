@page "/panel/central/sos/{id:guid}"
@model Cad.Server.Panel.Pages.Central.SosModel
@using System.Globalization
@{
    ViewData["Title"] = "Verificar SOS";
    ViewData["TituloResumenErrores"] = "No se pudo registrar el intento";
    var inv = CultureInfo.InvariantCulture;
    var sos = Model.Sos;
    string Local(DateTimeOffset momento) => TimeZoneInfo.ConvertTime(momento, Model.ZonaHoraria).ToString("dd/MM/yyyy HH:mm:ss", inv);
    var errorResultado = Model.ErrorDe("resultado");
    var errorInformacion = Model.ErrorDe("informacionHecho");
    var errorReferencia = Model.ErrorDe("referenciaUbicacion");
    var errorSolicitud = Model.ErrorDe("idSolicitud");
}
<p><a class="enlace-volver" href="/panel/central">← Central de monitoreo</a></p>
<div class="pagina__encabezado">
    <div>
        <p class="sobretitulo">Operador · SOS @sos.Estado</p>
        <h1 class="titulo">Verificar SOS</h1>
        <p class="texto-secundario">Registrado el @Local(sos.RegistradoEn).</p>
    </div>
</div>

@if (Model.Mensaje is not null)
{
    <div class="aviso aviso--exito" role="status" tabindex="-1" data-enfocar>
        <partial name="_Icono" model="@("exito")" />
        <div>
            <p class="aviso__titulo">@Model.Mensaje</p>
            <p class="aviso__texto">El SOS está en estado @sos.Estado. @Model.DetalleMensaje</p>
        </div>
    </div>
}

<div class="verificacion">
    <div class="pila">
        <section class="superficie" aria-labelledby="titulo-ciudadano">
            <h2 id="titulo-ciudadano" class="central__titulo">Ciudadano</h2>
            <dl class="datos">
                <div><dt>Nombre</dt><dd>@sos.Ciudadano</dd></div>
                <div>
                    <dt>Teléfono registrado</dt>
                    <dd>
                        @if (sos.Telefono is { Length: > 0 } telefono)
                        {
                            <a class="datos__telefono" href="tel:@telefono">@telefono</a>
                        }
                        else
                        {
                            <span>No registrado</span>
                        }
                    </dd>
                </div>
            </dl>
        </section>

        <section class="superficie" aria-labelledby="titulo-ubicacion">
            <h2 id="titulo-ubicacion" class="central__titulo">Ubicación del dispositivo</h2>
            @if (sos.UbicacionDisponible)
            {
                <dl class="datos">
                    <div><dt>Coordenadas</dt><dd>@sos.Latitud?.ToString("0.00000", inv), @sos.Longitud?.ToString("0.00000", inv)</dd></div>
                    <div><dt>Precisión</dt><dd>± @sos.PrecisionMetros?.ToString("0", inv) m</dd></div>
                    @if (sos.UbicacionObtenidaEn is { } obtenida)
                    {
                        <div><dt>Obtenida</dt><dd>@Local(obtenida)</dd></div>
                    }
                </dl>
            }
            else
            {
                <p class="sos__ubicacion sos__ubicacion--no">
                    <partial name="_Icono" model="@("advertencia")" />
                    <span>Ubicación no disponible</span>
                </p>
            }
            <p class="texto-secundario">Las referencias que indique el ciudadano se registran aparte y no cambian esta ubicación.</p>
        </section>

        @* HU13 — clasificación posterior al registro. No es necesaria para asignar (CA02). *@
        <section class="superficie" aria-labelledby="titulo-clasificacion">
            <h2 id="titulo-clasificacion" class="central__titulo">Clasificación</h2>
            @if (Model.ErrorClasificacion is not null)
            {
                <div class="aviso aviso--error" role="alert" tabindex="-1" data-enfocar>
                    <partial name="_Icono" model="@("error")" />
                    <div>
                        <p class="aviso__titulo">No se pudo clasificar el SOS</p>
                        <p class="aviso__texto">@Model.ErrorClasificacion</p>
                    </div>
                </div>
            }
            @if (sos.Clasificacion is { } clasificacion)
            {
                <dl class="datos">
                    <div><dt>Tipo</dt><dd data-tipo>@clasificacion.Categoria</dd></div>
                    <div><dt>Clasificado por</dt><dd>@clasificacion.Operador</dd></div>
                    <div><dt>Fecha y hora</dt><dd>@Local(clasificacion.ClasificadoEn)</dd></div>
                </dl>
            }
            else
            {
                <dl class="datos">
                    <div><dt>Tipo</dt><dd class="texto-secundario" data-tipo>@Cad.Server.Modulos.Consultas.SosPendiente.TipoPorDeterminar</dd></div>
                </dl>
                <form method="post" asp-page-handler="Clasificar" class="formulario" data-formulario novalidate>
                    <div class="campo">
                        <label class="campo__etiqueta" for="Clasificacion_CategoriaId">Categoría</label>
                        <select class="campo__control campo__control--seleccion" id="Clasificacion_CategoriaId" name="Clasificacion.CategoriaId" required
                                aria-invalid="@(Model.ErrorCategoria is null ? null : "true")"
                                aria-describedby="@(Model.ErrorCategoria is null ? null : "Clasificacion_CategoriaId-error")">
                            <option value="">Elige una categoría</option>
                            @foreach (var categoria in Model.Categorias)
                            {
                                <option value="@categoria.Id" selected="@(Model.Clasificacion.CategoriaId == categoria.Id)">@categoria.Nombre</option>
                            }
                        </select>
                        @if (Model.ErrorCategoria is not null)
                        {
                            <p id="Clasificacion_CategoriaId-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@Model.ErrorCategoria</span></p>
                        }
                    </div>
                    <div class="acciones">
                        <button type="submit" class="boton boton--principal" data-texto-carga="Clasificando…">Clasificar el SOS</button>
                    </div>
                </form>
            }
        </section>

        @* HU20 — asignación a un sereno disponible. También se puede hacer desde el mapa de la central. *@
        <section class="superficie" aria-labelledby="titulo-asignacion">
            <h2 id="titulo-asignacion" class="central__titulo">Asignación</h2>
            @if (Model.ErrorAsignacion is not null)
            {
                <div class="aviso aviso--error" role="alert" tabindex="-1" data-enfocar>
                    <partial name="_Icono" model="@("error")" />
                    <div>
                        <p class="aviso__titulo">No se pudo asignar el caso</p>
                        <p class="aviso__texto">@Model.ErrorAsignacion</p>
                    </div>
                </div>
            }
            @if (sos.Asignacion is { } vigente)
            {
                <p class="estado estado--activa">
                    <partial name="_Icono" model="@("exito")" />Asignado a @vigente.Sereno a las @Local(vigente.AsignadaEn)
                </p>
            }
            else if (sos.Estado != "Pendiente")
            {
                <p class="texto-secundario">El caso no está pendiente: no se puede asignar.</p>
            }
            else
            {
                @if (Model.SerenosDisponibles.Count == 0)
                {
                    <p class="texto-secundario">No hay serenos disponibles en este momento (operativos y sin asignación vigente).</p>
                }
                else
                {
                    <form method="post" asp-page-handler="Asignar" class="formulario" data-formulario novalidate>
                        <input type="hidden" name="Asignacion.IdSolicitud" value="@Model.Asignacion.IdSolicitud" />
                        <fieldset class="opciones">
                            <legend class="campo__etiqueta">Sereno disponible</legend>
                            @foreach (var sereno in Model.SerenosDisponibles)
                            {
                                var idOpcion = $"Asignacion_Sereno_{sereno.Id:N}";
                                <label class="opcion" for="@idOpcion">
                                    <input type="radio" id="@idOpcion" name="Asignacion.SerenoId" value="@sereno.Id" required />
                                    <span>
                                        @sereno.Nombre
                                        <span class="texto-secundario">
                                            · @(sereno.UltimaPosicionEn is { } h ? $"última ubicación a las {Local(h)}" : "ubicación no disponible")
                                        </span>
                                    </span>
                                </label>
                            }
                        </fieldset>
                        <div class="acciones">
                            <button type="submit" class="boton boton--principal" data-texto-carga="Asignando…">Asignar el caso</button>
                        </div>
                    </form>
                }
            }
        </section>
    </div>

    <div class="pila">
        <section class="superficie" aria-labelledby="titulo-intento">
            <h2 id="titulo-intento" class="central__titulo">Registrar intento de contacto</h2>
            <form method="post" class="formulario" data-formulario novalidate>
                <partial name="_ResumenErrores" model="@Model.Errores.Count" />
                <input type="hidden" name="Formulario.IdSolicitud" value="@Model.Formulario.IdSolicitud" />
                @if (errorSolicitud is not null)
                {
                    <p class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorSolicitud</span></p>
                }

                <fieldset class="opciones" aria-invalid="@(errorResultado is null ? null : "true")"
                          aria-describedby="@(errorResultado is null ? null : "Formulario_Resultado-error")">
                    <legend class="campo__etiqueta">Resultado del intento</legend>
                    @foreach (var (valor, texto) in SosModel.Resultados)
                    {
                        var idOpcion = $"Formulario_Resultado_{valor}";
                        <label class="opcion" for="@idOpcion">
                            <input type="radio" id="@idOpcion" name="Formulario.Resultado" value="@valor" required
                                   checked="@(Model.Formulario.Resultado == valor.ToString())" />
                            <span>@texto</span>
                        </label>
                    }
                    @if (errorResultado is not null)
                    {
                        <p id="Formulario_Resultado-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorResultado</span></p>
                    }
                </fieldset>

                <div class="campo">
                    <label class="campo__etiqueta" for="Formulario_InformacionHecho">Información del hecho (opcional)</label>
                    <textarea class="campo__control campo__control--texto" id="Formulario_InformacionHecho" name="Formulario.InformacionHecho"
                              rows="4" maxlength="@Cad.Server.Modulos.Casos.Dominio.IntentoContacto.MaximoInformacion"
                              aria-invalid="@(errorInformacion is null ? null : "true")"
                              aria-describedby="@(errorInformacion is null ? null : "Formulario_InformacionHecho-error")">@Model.Formulario.InformacionHecho</textarea>
                    @if (errorInformacion is not null)
                    {
                        <p id="Formulario_InformacionHecho-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorInformacion</span></p>
                    }
                </div>

                <div class="campo">
                    <label class="campo__etiqueta" for="Formulario_ReferenciaUbicacion">Referencia de ubicación indicada por el ciudadano (opcional)</label>
                    <input class="campo__control" id="Formulario_ReferenciaUbicacion" name="Formulario.ReferenciaUbicacion" type="text"
                           value="@Model.Formulario.ReferenciaUbicacion" autocomplete="off"
                           maxlength="@Cad.Server.Modulos.Casos.Dominio.IntentoContacto.MaximoReferencia"
                           aria-invalid="@(errorReferencia is null ? null : "true")"
                           aria-describedby="Formulario_ReferenciaUbicacion-ayuda@(errorReferencia is null ? "" : " Formulario_ReferenciaUbicacion-error")" />
                    <p id="Formulario_ReferenciaUbicacion-ayuda" class="campo__ayuda">Por ejemplo, «frente al mercado». Se guarda como texto y no sustituye la ubicación del dispositivo.</p>
                    @if (errorReferencia is not null)
                    {
                        <p id="Formulario_ReferenciaUbicacion-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorReferencia</span></p>
                    }
                </div>

                <div class="acciones">
                    <button type="submit" class="boton boton--principal" data-texto-carga="Registrando…">Registrar intento</button>
                </div>
            </form>
        </section>

        <section class="superficie" aria-labelledby="titulo-historial">
            <h2 id="titulo-historial" class="central__titulo">Intentos registrados · @sos.Intentos.Count</h2>
            @if (sos.Intentos.Count == 0)
            {
                <p class="texto-secundario">Todavía no hay intentos de contacto.</p>
            }
            else
            {
                <ol class="historial">
                    @foreach (var intento in sos.Intentos)
                    {
                        <li class="historial__elemento">
                            <p class="historial__cabecera">
                                @{ var contactado = intento.Resultado == Cad.Server.Modulos.Casos.Dominio.ResultadoContacto.Contactado; }
                                <span class="estado estado--@(contactado ? "contactado" : "sin-contacto")">
                                    <partial name="_Icono" model="@(contactado ? "exito" : "advertencia")" />@SosModel.Texto(intento.Resultado)
                                </span>
                                <time datetime="@intento.RegistradoEn.ToString("O", inv)">@Local(intento.RegistradoEn)</time>
                                <span class="texto-secundario">· @intento.Operador</span>
                            </p>
                            @if (intento.InformacionHecho is not null)
                            {
                                <p class="historial__texto"><strong>Información del hecho:</strong> @intento.InformacionHecho</p>
                            }
                            @if (intento.ReferenciaUbicacion is not null)
                            {
                                <p class="historial__texto"><strong>Referencia indicada por el ciudadano:</strong> @intento.ReferenciaUbicacion</p>
                            }
                        </li>
                    }
                </ol>
            }
        </section>
    </div>
</div>
