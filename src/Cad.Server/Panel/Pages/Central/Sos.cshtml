@page "/panel/central/sos/{id:guid}"
@model Cad.Server.Panel.Pages.Central.SosModel
@using System.Globalization
@using Accion = Cad.Server.Panel.Pages.Central.SosModel.SiguienteAccion
@{
    ViewData["Title"] = Model.Sos.EsCasoUrgente ? "Caso urgente" : "Verificar SOS";
    ViewData["TituloResumenErrores"] = "No se pudo registrar el intento";
    var inv = CultureInfo.InvariantCulture;
    var sos = Model.Sos;
    var siguiente = Model.Siguiente;
    string Local(DateTimeOffset momento) => TimeZoneInfo.ConvertTime(momento, Model.ZonaHoraria).ToString("dd/MM/yyyy HH:mm:ss", inv);
    var primerNombre = sos.Ciudadano.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? sos.Ciudadano;

    // «Otras acciones»: lo que también se puede hacer ahora, además de la siguiente acción.
    var intentoComoOtra = siguiente != Accion.Contactar && siguiente is not (Accion.VerCierre or Accion.VerCancelacion);
    var clasificarComoOtra = siguiente != Accion.Clasificar && sos.Clasificacion is null && siguiente != Accion.VerCancelacion;
    var asignarComoOtra = siguiente is Accion.Contactar or Accion.Clasificar;
    var hayOtras = intentoComoOtra || clasificarComoOtra || asignarComoOtra;
    var abrirOtras = (intentoComoOtra && Model.Errores.Count > 0) || (clasificarComoOtra && Model.ErrorCategoria is not null);
}
@section Estilos {
    @if (sos.UbicacionDisponible)
    {
        <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/detalle-caso.css" asp-append-version="true" />
}

<p><a class="enlace-volver" href="/panel/central">← Central de monitoreo</a></p>

<header class="cabecera-caso">
    <div class="cabecera-caso__fila">
        <span class="etiqueta-urgente"><partial name="_Icono" model="@("urgente")" />@(sos.EsCasoUrgente ? "Caso urgente" : "SOS")</span>
        <h1 class="titulo">@sos.Ciudadano</h1>
    </div>
    <p class="cabecera-caso__resumen">
        <strong>@sos.Origen @sos.Estado</strong> · Registrado el @Local(sos.RegistradoEn) · <a href="/panel/casos/@sos.Id/historial">Ver el historial del caso</a>
    </p>
    @if (sos.EsCasoUrgente)
    {
        <p class="texto-secundario" data-caso-urgente>Creado por un operador desde un aviso del acompañamiento (DP19). La ubicación es la última conocida de la sesión, no una posición actual.</p>
    }
    <partial name="_ProgresoCaso" model="Model.Pasos" />
</header>

@if (Model.Mensaje is not null)
{
    <div class="aviso aviso--exito" role="status" tabindex="-1" data-enfocar>
        <partial name="_Icono" model="@("exito")" />
        <div>
            <p class="aviso__titulo">@Model.Mensaje</p>
            <p class="aviso__texto">El SOS está en estado @sos.Estado. @Model.DetalleMensaje</p>
        </div>
    </div>
}

@* Errores de las acciones: se muestran arriba aunque el formulario ya no esté disponible (p. ej., el caso dejó de estar pendiente). *@
@foreach (var (titulo, error) in new[] {
    ("No se pudo clasificar el SOS", Model.ErrorClasificacion),
    ("No se pudo asignar el caso", Model.ErrorAsignacion),
    ("No se pudo registrar el inicio de atención", Model.ErrorAvance),
    ("No se pudo cerrar el caso", Model.ErrorCierre) })
{
    if (error is null) continue;
    <div class="aviso aviso--error" role="alert" tabindex="-1" data-enfocar>
        <partial name="_Icono" model="@("error")" />
        <div>
            <p class="aviso__titulo">@titulo</p>
            <p class="aviso__texto">@error</p>
        </div>
    </div>
}

<div class="detalle-caso">
    <div class="detalle-caso__principal">
        <section class="superficie siguiente" aria-labelledby="titulo-siguiente">
            @switch (siguiente)
            {
                case Accion.Contactar:
                    <div class="siguiente__cabecera">
                        <h2 class="siguiente__titulo" id="titulo-siguiente">Llama a @primerNombre y registra el resultado del contacto</h2>
                        <span class="siguiente__paso">Paso 1 de 3</span>
                    </div>
                    <partial name="_SosIntento" model="Model" />
                    break;
                case Accion.Clasificar:
                    <div class="siguiente__cabecera">
                        <h2 class="siguiente__titulo" id="titulo-siguiente">Clasifica el SOS según lo que contó @primerNombre</h2>
                        <span class="siguiente__paso">Paso 2 de 3</span>
                    </div>
                    <partial name="_SosClasificar" model="Model" />
                    break;
                case Accion.Asignar:
                    <div class="siguiente__cabecera">
                        <h2 class="siguiente__titulo" id="titulo-siguiente">Elige al sereno que atenderá el caso</h2>
                        <span class="siguiente__paso">Paso 3 de 3</span>
                    </div>
                    <partial name="_SosAsignar" model="Model" />
                    break;
                case Accion.EsperarDesplazamiento:
                    <h2 class="siguiente__titulo" id="titulo-siguiente">@sos.Asignacion!.Sereno recibió el despacho</h2>
                    <p class="texto-secundario">Verás aquí cuando confirme que va en camino y cuando inicie la atención.</p>
                    break;
                case Accion.EsperarAtencion:
                    <h2 class="siguiente__titulo" id="titulo-siguiente">@sos.Asignacion!.Sereno va en camino</h2>
                    <form method="post" asp-page-handler="IniciarAtencion" class="formulario" data-formulario>
                        <p class="texto-secundario">Si el sereno no puede registrarlo, puedes registrar el inicio de atención; quedarás como responsable.</p>
                        <div class="acciones">
                            <button type="submit" class="boton boton--secundario" data-texto-carga="Registrando…">Registrar inicio de atención</button>
                        </div>
                    </form>
                    break;
                case Accion.Cerrar:
                    var errorCategoria = Model.ErrorCierreDe("categoriaId");
                    var errorResultado = Model.ErrorCierreDe("resultadoPublico");
                    var errorNotas = Model.ErrorCierreDe("notasInternas");
                    @* HU24 — cierre con tipificación final y resultado (CA01, CA05). *@
                    <h2 class="siguiente__titulo" id="titulo-siguiente">Cierra el caso con su tipificación y resultado</h2>
                    <form method="post" asp-page-handler="Cerrar" class="formulario" data-formulario novalidate>
                        <div class="campo">
                            <label class="campo__etiqueta" for="Cierre_CategoriaId">Tipificación final</label>
                            <select class="campo__control campo__control--seleccion" id="Cierre_CategoriaId" name="Cierre.CategoriaId" required
                                    aria-invalid="@(errorCategoria is null ? null : "true")"
                                    aria-describedby="@(errorCategoria is null ? null : "Cierre_CategoriaId-error")">
                                <option value="">Elige una categoría</option>
                                @foreach (var categoria in Model.Categorias)
                                {
                                    <option value="@categoria.Id" selected="@(Model.Cierre.CategoriaId == categoria.Id)">@categoria.Nombre</option>
                                }
                            </select>
                            @if (errorCategoria is not null)
                            {
                                <p id="Cierre_CategoriaId-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorCategoria</span></p>
                            }
                        </div>
                        <div class="campo">
                            <label class="campo__etiqueta" for="Cierre_ResultadoPublico">Resultado de la atención</label>
                            <textarea class="campo__control campo__control--texto" id="Cierre_ResultadoPublico" name="Cierre.ResultadoPublico" rows="3" required
                                      maxlength="@Cad.Server.Modulos.Casos.Dominio.CierreCaso.MaximoResultado"
                                      aria-invalid="@(errorResultado is null ? null : "true")"
                                      aria-describedby="Cierre_ResultadoPublico-ayuda@(errorResultado is null ? "" : " Cierre_ResultadoPublico-error")">@Model.Cierre.ResultadoPublico</textarea>
                            <p id="Cierre_ResultadoPublico-ayuda" class="campo__ayuda">Es el resultado público: el ciudadano podrá verlo.</p>
                            @if (errorResultado is not null)
                            {
                                <p id="Cierre_ResultadoPublico-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorResultado</span></p>
                            }
                        </div>
                        <div class="campo">
                            <label class="campo__etiqueta" for="Cierre_NotasInternas">Notas internas (opcional)</label>
                            <textarea class="campo__control campo__control--texto" id="Cierre_NotasInternas" name="Cierre.NotasInternas" rows="3"
                                      maxlength="@Cad.Server.Modulos.Casos.Dominio.CierreCaso.MaximoNotas"
                                      aria-invalid="@(errorNotas is null ? null : "true")"
                                      aria-describedby="Cierre_NotasInternas-ayuda@(errorNotas is null ? "" : " Cierre_NotasInternas-error")">@Model.Cierre.NotasInternas</textarea>
                            <p id="Cierre_NotasInternas-ayuda" class="campo__ayuda">Solo para el personal autorizado; el ciudadano no las verá.</p>
                            @if (errorNotas is not null)
                            {
                                <p id="Cierre_NotasInternas-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorNotas</span></p>
                            }
                        </div>
                        <div class="acciones">
                            <button type="submit" class="boton boton--principal" data-texto-carga="Cerrando…">Cerrar el caso</button>
                        </div>
                    </form>
                    break;
                case Accion.VerCierre:
                    var cierre = sos.Cierre!;
                    @* HU24-CA04: el resultado público y las notas internas se muestran diferenciados. *@
                    <h2 class="siguiente__titulo" id="titulo-siguiente">Atención cerrada</h2>
                    <dl class="datos" data-cierre>
                        <div><dt>Tipificación final</dt><dd>@cierre.Tipificacion</dd></div>
                        <div><dt>Resultado de la atención (público)</dt><dd data-resultado-publico>@cierre.ResultadoPublico</dd></div>
                        <div>
                            <dt>Notas internas (solo personal autorizado)</dt>
                            <dd data-notas-internas>@(cierre.NotasInternas ?? "Sin notas internas.")</dd>
                        </div>
                        <div><dt>Cerrado por</dt><dd>@cierre.Responsable</dd></div>
                        <div><dt>Fecha y hora</dt><dd>@Local(cierre.CerradoEn)</dd></div>
                    </dl>
                    break;
                case Accion.VerCancelacion:
                    <h2 class="siguiente__titulo" id="titulo-siguiente">SOS cancelado</h2>
                    <p class="texto-secundario">El ciudadano canceló este SOS: no se puede asignar. El motivo está en el historial.</p>
                    break;
                default:
                    <h2 class="siguiente__titulo" id="titulo-siguiente">Sin acciones pendientes</h2>
                    <p class="texto-secundario">El caso no está pendiente: no se puede asignar.</p>
                    break;
            }
        </section>

        @if (hayOtras)
        {
            <details class="superficie otras-acciones" open="@abrirOtras">
                <summary>Otras acciones</summary>
                <div class="otras-acciones__cuerpo">
                    @if (asignarComoOtra)
                    {
                        <section aria-labelledby="titulo-asignar-directo">
                            <h3 id="titulo-asignar-directo" class="otras-acciones__titulo">Asignar sin @(siguiente == Accion.Contactar ? "verificar" : "clasificar")</h3>
                            <partial name="_SosAsignar" model="Model" />
                        </section>
                    }
                    @if (clasificarComoOtra)
                    {
                        <section aria-labelledby="titulo-clasificar-otra">
                            <h3 id="titulo-clasificar-otra" class="otras-acciones__titulo">Clasificar</h3>
                            <partial name="_SosClasificar" model="Model" />
                        </section>
                    }
                    @if (intentoComoOtra)
                    {
                        <section aria-labelledby="titulo-intento-otro">
                            <h3 id="titulo-intento-otro" class="otras-acciones__titulo">Registrar otro intento de contacto</h3>
                            <partial name="_SosIntento" model="Model" />
                        </section>
                    }
                </div>
            </details>
        }

        @if (sos.Asignacion is { } vigente)
        {
            <section class="superficie seccion-caso" aria-labelledby="titulo-asignacion">
                <h2 id="titulo-asignacion" class="seccion-caso__titulo">Despacho</h2>
                <p class="estado estado--activa">
                    <partial name="_Icono" model="@("exito")" />Asignado a @vigente.Sereno a las @Local(vigente.AsignadaEn)
                </p>
                @if (vigente.FinalizadaEn is { } finalizada)
                {
                    <p class="texto-secundario">Asignación finalizada con el cierre a las @Local(finalizada).</p>
                }
                @* HU22/HU23: avances con responsable, fecha y hora. *@
                @if (sos.Avances is { Count: > 0 } avances)
                {
                    <ol class="historial" data-avances>
                        @foreach (var avance in avances)
                        {
                            <li class="historial__elemento">
                                <p class="historial__cabecera">
                                    <span class="estado estado--activa">@avance.Descripcion</span>
                                    <time datetime="@avance.En.ToString("O", inv)">@Local(avance.En)</time>
                                    <span class="texto-secundario">· @avance.Responsable</span>
                                </p>
                            </li>
                        }
                    </ol>
                }
            </section>
        }

        <section class="superficie seccion-caso" aria-labelledby="titulo-historial">
            <h2 id="titulo-historial" class="seccion-caso__titulo">Intentos registrados · @sos.Intentos.Count</h2>
            @if (sos.Intentos.Count == 0)
            {
                <p class="texto-secundario">Todavía no hay intentos de contacto.</p>
            }
            else
            {
                <ol class="historial">
                    @foreach (var intento in sos.Intentos)
                    {
                        <li class="historial__elemento">
                            <p class="historial__cabecera">
                                @{ var contactado = intento.Resultado == Cad.Server.Modulos.Casos.Dominio.ResultadoContacto.Contactado; }
                                <span class="estado estado--@(contactado ? "contactado" : "sin-contacto")">
                                    <partial name="_Icono" model="@(contactado ? "exito" : "advertencia")" />@Cad.Server.Panel.Pages.Central.SosModel.Texto(intento.Resultado)
                                </span>
                                <time datetime="@intento.RegistradoEn.ToString("O", inv)">@Local(intento.RegistradoEn)</time>
                                <span class="texto-secundario">· @intento.Operador</span>
                            </p>
                            @if (intento.InformacionHecho is not null)
                            {
                                <p class="historial__texto"><strong>Información del hecho:</strong> @intento.InformacionHecho</p>
                            }
                            @if (intento.ReferenciaUbicacion is not null)
                            {
                                <p class="historial__texto"><strong>Referencia indicada por el ciudadano:</strong> @intento.ReferenciaUbicacion</p>
                            }
                        </li>
                    }
                </ol>
            }
        </section>
    </div>

    <aside class="detalle-caso__contexto" aria-label="Contexto del caso">
        <section class="superficie seccion-caso" aria-labelledby="titulo-ciudadano">
            <h2 id="titulo-ciudadano" class="seccion-caso__titulo">Ciudadano</h2>
            <dl class="datos datos--en-linea">
                <div><dt>Nombre</dt><dd>@sos.Ciudadano</dd></div>
                <div>
                    <dt>Teléfono registrado</dt>
                    <dd>
                        @if (sos.Telefono is { Length: > 0 } telefono)
                        {
                            <a class="datos__telefono" href="tel:@telefono">@telefono</a>
                        }
                        else
                        {
                            <span>No registrado</span>
                        }
                    </dd>
                </div>
            </dl>
        </section>

        <section class="superficie seccion-caso" aria-labelledby="titulo-ubicacion">
            <h2 id="titulo-ubicacion" class="seccion-caso__titulo">Ubicación del dispositivo</h2>
            @if (sos.UbicacionDisponible)
            {
                <div id="mapa-hecho" class="mapa mapa--detalle" role="region" aria-label="Mapa con la ubicación del dispositivo"
                     data-lat="@sos.Latitud?.ToString(inv)" data-lon="@sos.Longitud?.ToString(inv)" data-teselas="@Model.UrlTeselas"
                     data-titulo="Ubicación del dispositivo"></div>
                <dl class="datos datos--en-linea">
                    <div><dt>Coordenadas</dt><dd>@sos.Latitud?.ToString("0.00000", inv), @sos.Longitud?.ToString("0.00000", inv)</dd></div>
                    <div><dt>Precisión</dt><dd>± @sos.PrecisionMetros?.ToString("0", inv) m</dd></div>
                    @if (sos.UbicacionObtenidaEn is { } obtenida)
                    {
                        <div><dt>Obtenida</dt><dd>@Local(obtenida)</dd></div>
                    }
                </dl>
            }
            else
            {
                <p class="sos__ubicacion sos__ubicacion--no">
                    <partial name="_Icono" model="@("advertencia")" />
                    <span>Ubicación no disponible</span>
                </p>
            }
            <p class="texto-secundario detalle-caso__nota">Las referencias que indique el ciudadano se registran aparte y no cambian esta ubicación.</p>
        </section>

        <section class="superficie seccion-caso" aria-labelledby="titulo-clasificacion">
            <h2 id="titulo-clasificacion" class="seccion-caso__titulo">Clasificación</h2>
            @if (sos.Clasificacion is { } clasificacion)
            {
                <dl class="datos datos--en-linea">
                    <div><dt>Tipo</dt><dd data-tipo>@clasificacion.Categoria</dd></div>
                    <div><dt>Clasificado por</dt><dd>@clasificacion.Operador</dd></div>
                    <div><dt>Fecha y hora</dt><dd>@Local(clasificacion.ClasificadoEn)</dd></div>
                </dl>
            }
            else
            {
                <dl class="datos datos--en-linea">
                    <div><dt>Tipo</dt><dd class="texto-secundario" data-tipo>@Cad.Server.Modulos.Consultas.SosPendiente.TipoPorDeterminar</dd></div>
                </dl>
            }
        </section>

        @if (Model.Tiempos is { } tiempos)
        {
            <partial name="_TiemposCaso" model="tiempos" />
        }
    </aside>
</div>

@section Scripts {
    @if (sos.UbicacionDisponible)
    {
        <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
        <script src="~/js/mapa-hecho.js" asp-append-version="true"></script>
    }
}
