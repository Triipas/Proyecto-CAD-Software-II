@model string
@* Iconos decorativos propios (trazo de 24×24, color heredado). El significado siempre lo da el texto. *@
<svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case "escudo":
            <path d="M12 2.5 19.5 5.5v6c0 4.8-3.2 8.8-7.5 10-4.3-1.2-7.5-5.2-7.5-10v-6z" />
            <path d="m8.75 12 2.25 2.25 4.25-4.5" />
            break;
        case "sonido":
            <path d="M11 5 6 9H3v6h3l5 4z" />
            <path d="M15.5 8.5a5 5 0 0 1 0 7" />
            <path d="M18.5 5.5a9 9 0 0 1 0 13" />
            break;
        case "silencio":
            <path d="M11 5 6 9H3v6h3l5 4z" />
            <path d="m16 9 5 6" />
            <path d="m21 9-5 6" />
            break;
        case "izquierda":
            <path d="m15 18-6-6 6-6" />
            break;
        case "error":
            <circle cx="12" cy="12" r="9" />
            <path d="m15 9-6 6M9 9l6 6" />
            break;
        case "advertencia":
            <path d="M10.3 4.2 2.6 17.5A2 2 0 0 0 4.3 20.5h15.4a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z" />
            <path d="M12 9.5v4M12 17h.01" />
            break;
        case "informacion":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5.5M12 7.75h.01" />
            break;
        case "urgente":
            <path d="M6 18v-5a6 6 0 0 1 12 0v5" />
            <path d="M4 18h16v3H4zM12 2v2M4.2 5.2l1.4 1.4M19.8 5.2l-1.4 1.4" />
            break;
        case "ubicacion":
            <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
            <circle cx="12" cy="9.5" r="2.5" />
            break;
        case "exito":
            <circle cx="12" cy="12" r="9" />
            <path d="m8 12.25 2.75 2.75 5.25-5.5" />
            break;
        @* Estados de un caso (rediseño CAD v2): se usan en los chips junto al texto del estado. *@
        case "telefono":
            <path d="M5 3h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 12l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 5a2 2 0 0 1 2-2z" />
            break;
        case "reloj":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
        case "bandeja":
            <path d="M22 12h-6l-2 3h-4l-2-3H2" />
            <path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1z" />
            break;
        case "lupa":
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
            break;
        case "asignado":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="m16 11 2 2 4-4" />
            break;
        case "camino":
            <path d="m3 11 19-9-9 19-2-8-8-2z" />
            break;
        case "derivar":
            <path d="M7 17 17 7M7 7h10v10" />
            break;
        case "cancelar":
            <circle cx="12" cy="12" r="9" />
            <path d="m4.9 4.9 14.2 14.2" />
            break;
        case "documento":
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            break;
        case "ruta":
            <circle cx="6" cy="19" r="3" />
            <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15" />
            <circle cx="18" cy="5" r="3" />
            break;
        case "filtro":
            <path d="M22 3H2l8 9.46V19l4 2v-8.54z" />
            break;
    }
</svg>
