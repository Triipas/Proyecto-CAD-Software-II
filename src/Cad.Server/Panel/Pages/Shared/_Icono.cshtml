@model string
@* Iconos decorativos propios (trazo de 24×24, color heredado). El significado siempre lo da el texto. *@
<svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case "escudo":
            <path d="M12 2.5 19.5 5.5v6c0 4.8-3.2 8.8-7.5 10-4.3-1.2-7.5-5.2-7.5-10v-6z" />
            <path d="m8.75 12 2.25 2.25 4.25-4.5" />
            break;
        case "error":
            <circle cx="12" cy="12" r="9" />
            <path d="m15 9-6 6M9 9l6 6" />
            break;
        case "advertencia":
            <path d="M10.3 4.2 2.6 17.5A2 2 0 0 0 4.3 20.5h15.4a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z" />
            <path d="M12 9.5v4M12 17h.01" />
            break;
        case "informacion":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5.5M12 7.75h.01" />
            break;
        case "exito":
            <circle cx="12" cy="12" r="9" />
            <path d="m8 12.25 2.75 2.75 5.25-5.5" />
            break;
    }
</svg>
