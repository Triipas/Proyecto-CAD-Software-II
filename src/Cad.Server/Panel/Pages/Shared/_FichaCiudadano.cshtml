@model Cad.Server.Modulos.Consultas.FichaCiudadano
@* ADR-08, fase D: datos del ciudadano para atender su caso. Los opcionales que no completó se indican como «No registrado».
   Rediseño del 27/10/2026: el nombre y el teléfono primero, con sus iniciales; los demás datos debajo.
   29/10/2026: el contacto de emergencia va primero entre ellos; en el detalle de un caso la ficha vive en la columna izquierda, siempre a la vista. *@
@{
    var iniciales = string.Concat(Model.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
<section class="superficie seccion-caso ficha-ciudadano" aria-labelledby="titulo-ciudadano" data-ficha-ciudadano>
    <h2 id="titulo-ciudadano" class="seccion-caso__titulo">Ciudadano</h2>
    <div class="ficha">
        <span class="ficha__avatar" aria-hidden="true">@iniciales</span>
        <div class="ficha__datos">
            <p class="ficha__nombre">@Model.Nombre</p>
            <p class="ficha__telefono">
                @if (Model.Telefono is { Length: > 0 } telefono)
                {
                    <span class="visualmente-oculto">Teléfono registrado: </span><a class="datos__telefono" href="tel:@telefono">@(telefono.Length == 9 ? $"{telefono[..3]} {telefono[3..6]} {telefono[6..]}" : telefono)</a>
                    @if (Model.TelefonoVerificado)
                    {
                        <span> · verificado</span>
                    }
                }
                else
                {
                    <span>Teléfono: No registrado</span>
                }
            </p>
        </div>
    </div>
    <dl class="datos datos--en-linea">
        <div class="dato--ancho@(Model.TieneContacto ? null : " dato--vacio")">
            <dt>Contacto de emergencia</dt>
            <dd data-contacto-emergencia>
                @if (Model.TieneContacto)
                {
                    <span>@Model.ContactoNombre (@Model.ContactoParentesco) · </span><a class="datos__telefono" href="tel:@Model.ContactoTelefono">@Model.ContactoTelefono</a>
                }
                else
                {
                    <span>No registrado</span>
                }
            </dd>
        </div>
        <div class="@(Model.Documento is null ? "dato--vacio" : null)"><dt>Documento</dt><dd>@(Model.Documento ?? "No registrado")</dd></div>
        <div class="@(Model.Edad is null ? "dato--vacio" : null)"><dt>Edad</dt><dd>@(Model.Edad is { } edad ? $"{edad} años" : "No registrada")</dd></div>
        <div class="dato--ancho@(Model.Direccion is null ? " dato--vacio" : null)"><dt>Dirección</dt><dd>@(Model.Direccion ?? "No registrada")</dd></div>
    </dl>
</section>
