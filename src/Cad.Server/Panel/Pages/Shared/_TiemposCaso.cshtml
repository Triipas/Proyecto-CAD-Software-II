@model Cad.Server.Modulos.Consultas.TiemposCaso
@* HU28 — tiempos del caso con las marcas registradas (DP18: por caso, sin promedios). *@
@{
    // 27/10/2026: sin ninguna marca todavía, una sola línea en vez de «No disponible» repetido (los datos siguen en el HTML).
    var sinMarcas = Model.EsSos ? Model.Respuesta == Cad.Server.Modulos.Consultas.TiemposCaso.NoDisponible
        : Model.HastaDecision == Cad.Server.Modulos.Consultas.TiemposCaso.NoDisponible && Model.HastaAtencion == Cad.Server.Modulos.Consultas.TiemposCaso.NoDisponible;
}
<section class="superficie@(sinMarcas ? " tiempos--sin-marcas" : "")" aria-labelledby="titulo-tiempos" data-tiempos>
    <h2 id="titulo-tiempos" class="central__titulo">Tiempos del caso</h2>
    @if (sinMarcas)
    {
        <p class="tiempos__pendiente">@(Model.EsSos ? "Se medirá cuando se inicie la atención." : "Se medirán al decidir el reporte y al iniciar la atención.")</p>
    }
    <dl class="datos">
        @if (Model.EsSos)
        {
            <dt>Tiempo de respuesta</dt>
            <dd data-tiempo-respuesta>@Model.Respuesta</dd>
        }
        else
        {
            <dt>Hasta la decisión de la revisión</dt>
            <dd data-tiempo-decision>@Model.HastaDecision</dd>
            <dt>Hasta el inicio de la atención</dt>
            <dd data-tiempo-atencion>@Model.HastaAtencion</dd>
        }
    </dl>
    <p class="texto-secundario">@(Model.EsSos
        ? "Del registro del SOS al inicio de la atención. No es el tiempo de presentación en la central."
        : "Medidos desde el registro del reporte. Un reporte derivado o descartado no se atiende.")</p>
</section>
