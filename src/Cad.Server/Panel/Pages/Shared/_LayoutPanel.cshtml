@using System.Security.Claims
@using Cad.Server.Compartido
@using Cad.Server.Modulos.Cuentas.Dominio
@{
    var rol = User.FindFirstValue(Autenticacion.ReclamoRol);
    var ruta = Context.Request.Path.Value ?? "";
    // Panel del caso (05/11/2026): las páginas que lo permiten se muestran sin la barra dentro de la central (Panel/ModoPanel.cs).
    var enPanel = ViewData[Cad.Server.Panel.ModoPanel.ClaveVista] is true && Cad.Server.Panel.ModoPanel.Activo(Context.Request);
    // Navegación orientativa por rol: los permisos los decide siempre el servidor (HU03).
    var enlaces = rol switch
    {
        Roles.Operador => new[] { ("/panel/central", "Central", "panel"), ("/panel/casos", "Casos", "lista"), ("/panel/mapa-concentracion", "Mapa de concentración", "capas"), ("/panel/acompanamientos", "Acompañamientos", "ruta"), ("/panel/analitica", "Analítica", "grafico") },
        Roles.Administrador => new[] { ("/panel/admin/cuentas", "Cuentas institucionales", "usuarios"), ("/panel/admin/ia", "Asistencia con IA", "chispa") },
        _ => Array.Empty<(string, string, string)>(),
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Central CAD</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
    @if (enPanel)
    {
        <link rel="stylesheet" href="~/css/panel-caso.css" asp-append-version="true" />
    }
</head>
<body data-sonido="@TempData[Cad.Server.Panel.SonidoPanel.Clave]" data-en-panel="@(enPanel ? "true" : "false")">
    @* Barra superior en dos niveles (06/11/2026, «carpeta»): la fila de estado (marca, indicadores en vivo y sesión) y, debajo, las
       secciones como lengüetas; la activa se funde con lo que sigue. Una página con vistas propias las cuelga de su lengüeta con
       la sección «HojaBarra». Sin menú de hamburguesa: en pantallas estrechas las lengüetas se desplazan en horizontal. *@
    @if (!enPanel)
    {
    var conHoja = IsSectionDefined("HojaBarra");
    <header class="barra@(conHoja ? " barra--con-hoja" : "")" data-barra>
        <div class="barra__fila">
            <div class="barra__marca">
                <span class="barra__escudo"><partial name="_Icono" model="@("escudo")" /></span>
                <span class="barra__nombre"><b>Central CAD</b><small>MVP académico · datos simulados</small></span>
            </div>
            @await RenderSectionAsync("IndicadoresBarra", required: false)
            @if (User.Identity?.IsAuthenticated == true)
            {
                var nombre = User.FindFirstValue(Autenticacion.ReclamoNombre) ?? "";
                var iniciales = string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
                <form method="post" asp-page="/Salir" class="barra__sesion">
                    @if (rol == Roles.Operador)
                    {
                        @* Avisos sonoros (24/10/2026): activados por defecto; este botón los silencia o los vuelve a activar (sonidos.js). *@
                        <button type="button" class="barra__sonido" aria-pressed="true" title="Silenciar avisos sonoros" data-alternar-sonido>
                            <span data-icono-sonido="activado"><partial name="_Icono" model="@("sonido")" /></span>
                            <span data-icono-sonido="silenciado"><partial name="_Icono" model="@("silencio")" /></span>
                            <span class="visualmente-oculto">Avisos sonoros</span>
                        </button>
                    }
                    <span class="barra__avatar" aria-hidden="true">@iniciales</span>
                    <span class="barra__persona"><b>@nombre</b><span>@rol</span></span>
                    <button type="submit" class="boton boton--sobre-marino boton--compacto">Salir</button>
                </form>
            }
        </div>
        @if (enlaces.Length > 0)
        {
            <nav class="barra__navegacion" id="secciones-panel" aria-label="Secciones del panel">
                <ul class="barra__secciones">
                    @foreach (var (href, texto, icono) in enlaces)
                    {
                        <li><a class="barra__seccion" href="@href" aria-current="@(ruta.StartsWith(href) || (href == "/panel/central" && (ruta.StartsWith("/panel/reportes") || ruta.StartsWith("/panel/criterios-triaje"))) ? "page" : null)"><partial name="_Icono" model="@icono" />@texto</a></li>
                    }
                </ul>
            </nav>
        }
        @if (conHoja)
        {
            <div class="barra__hoja">
                @await RenderSectionAsync("HojaBarra")
            </div>
        }
    </header>
    }
    else if (IsSectionDefined("HojaBarra"))
    {
        IgnoreSection("HojaBarra");
    }
    <main class="pagina @ViewData["ClasePagina"]@(enPanel ? " pagina--en-panel" : "")">
        @RenderBody()
    </main>
    <script src="~/js/movimiento.js" asp-append-version="true"></script>
    <script src="~/js/sonidos.js" asp-append-version="true"></script>
    <script src="~/js/formulario.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (enPanel)
    {
        <script src="~/js/panel-caso.js" asp-append-version="true"></script>
    }
</body>
</html>
