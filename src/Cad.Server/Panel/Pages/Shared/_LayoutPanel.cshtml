@using System.Security.Claims
@using Cad.Server.Compartido
@using Cad.Server.Modulos.Cuentas.Dominio
@{
    var rol = User.FindFirstValue(Autenticacion.ReclamoRol);
    var ruta = Context.Request.Path.Value ?? "";
    // Navegación orientativa por rol: los permisos los decide siempre el servidor (HU03).
    var enlaces = rol switch
    {
        Roles.Operador => new[] { ("/panel/central", "Central"), ("/panel/reportes", "Reportes"), ("/panel/casos", "Casos"), ("/panel/mapa-concentracion", "Mapa de concentración"), ("/panel/acompanamientos", "Acompañamientos") },
        Roles.Administrador => new[] { ("/panel/admin/cuentas", "Cuentas institucionales") },
        _ => Array.Empty<(string, string)>(),
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Central CAD</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
    @* Barra superior del rediseño CAD v2 (dirección «Mapa protagonista»): marca, secciones y sesión.
       Por debajo de 1100 px las secciones pasan a un menú desplegable (data-menu, formulario.js). *@
    <header class="barra" data-barra>
        @if (enlaces.Length > 0)
        {
            <button type="button" class="barra__menu" aria-expanded="false" aria-controls="secciones-panel" data-menu>
                <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                <span class="visualmente-oculto">Secciones del panel</span>
            </button>
        }
        <div class="barra__marca">
            <span class="barra__escudo"><partial name="_Icono" model="@("escudo")" /></span>
            <span class="barra__nombre"><b>Central CAD</b><small>MVP académico · datos simulados</small></span>
        </div>
        @if (enlaces.Length > 0)
        {
            <nav class="barra__navegacion" id="secciones-panel" aria-label="Secciones del panel">
                <ul class="barra__secciones">
                    @foreach (var (href, texto) in enlaces)
                    {
                        <li><a class="barra__seccion" href="@href" aria-current="@(ruta.StartsWith(href) ? "page" : null)">@texto</a></li>
                    }
                </ul>
            </nav>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            var nombre = User.FindFirstValue(Autenticacion.ReclamoNombre) ?? "";
            var iniciales = string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
            <form method="post" asp-page="/Salir" class="barra__sesion">
                <span class="barra__avatar" aria-hidden="true">@iniciales</span>
                <span class="barra__persona"><b>@nombre</b><span>@rol</span></span>
                <button type="submit" class="boton boton--sobre-marino boton--compacto">Salir</button>
            </form>
        }
    </header>
    <main class="pagina @ViewData["ClasePagina"]">
        @RenderBody()
    </main>
    <script src="~/js/formulario.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
