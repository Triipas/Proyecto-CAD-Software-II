@model int
@* Resumen de errores al principio del formulario: recibe el foco tras un envío rechazado. *@
@if (Model > 0)
{
    <div id="resumen-errores" class="aviso aviso--error formulario__completo" role="alert" tabindex="-1" data-enfocar>
        <partial name="_Icono" model="@("error")" />
        <div>
            <p class="aviso__titulo">No se pudo guardar la cuenta</p>
            <p class="aviso__texto">Revisa @(Model == 1 ? "el campo marcado" : $"los {Model} campos marcados").</p>
        </div>
    </div>
}
