@model Cad.Server.Modulos.Asistencia.AjusteIaVista
@using Cad.Server.Modulos.Asistencia
@using Cad.Server.Modulos.Asistencia.Dominio
@* HU47 (S6-T15; plan de asistencia con IA, 7.2) — aviso del modo vigente de la admisión automática en «Reportes» y «Central», para
   que nadie se sorprenda, con el botón para pausarla (el operador solo puede detenerla; reactivarla es del administrador).
   Apagada: no se muestra nada. *@
@if (Model.Modo != ModoAdmision.Apagada)
{
    var activa = Model.Modo == ModoAdmision.Activa;
    <div class="aviso @(activa ? "aviso--advertencia" : "aviso--informacion") admision-automatica" role="status" data-admision-automatica="@Model.Modo">
        <partial name="_Icono" model="@(activa ? "advertencia" : "informacion")" />
        <div class="admision-automatica__texto">
            <p class="aviso__titulo">Admisión automática: «@ConsultarAsistencia.Texto(Model.Modo)»</p>
            <p class="aviso__texto">@(Model.Freno is { } freno
                ? $"Pasó sola a «Sombra». {freno} Solo el administrador puede reactivarla."
                : activa
                    ? $"Admite sola los reportes que cumplan todas las condiciones, {Model.Parametros.RetrasoSegundos} s después de llegar si nadie inicia la revisión. Si ves algo raro, páusala."
                    : "Calcula qué reportes habría admitido, sin admitir ninguno.")</p>
        </div>
        <form method="post" asp-page="/Reportes/Index" asp-page-handler="Pausar" class="admision-automatica__pausa">
            <button type="submit" class="boton boton--secundario boton--compacto" data-pausar-admision data-texto-carga="Pausando…">Pausar</button>
        </form>
    </div>
}
