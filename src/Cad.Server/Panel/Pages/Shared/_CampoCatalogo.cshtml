@model Cad.Server.Panel.Pages.CampoCatalogo
@{
    var idAyuda = $"{Model.Id}-ayuda";
    var idError = $"{Model.Id}-error";
    var descrito = string.Join(" ", new[] { Model.Ayuda is null ? null : idAyuda, Model.Error is null ? null : idError }.OfType<string>());
}
<div class="campo@(Model.Clase is null ? "" : " " + Model.Clase)">
    <label class="campo__etiqueta" for="@Model.Id">@Model.Etiqueta</label>
    <select class="campo__control campo__control--seleccion" id="@Model.Id" name="@Model.Nombre" required
            aria-invalid="@(Model.Error is null ? null : "true")"
            aria-describedby="@(descrito.Length == 0 ? null : descrito)">
        <option value="">@Model.Vacio</option>
        @foreach (var opcion in Model.Opciones)
        {
            <option value="@opcion.Codigo" selected="@(Model.Valor == opcion.Codigo)">@opcion.Texto</option>
        }
    </select>
    @if (Model.Ayuda is not null)
    {
        <p id="@idAyuda" class="campo__ayuda">@Model.Ayuda</p>
    }
    @if (Model.Error is not null)
    {
        <p id="@idError" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@Model.Error</span></p>
    }
</div>
