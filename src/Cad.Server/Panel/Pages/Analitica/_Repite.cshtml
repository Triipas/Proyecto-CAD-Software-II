@model (IndexModel M, IndexModel.VistaRepite V)
@using System.Text.Json
@{
    var (m, v) = Model;
    var alertas = v.Alzas.Where(a => a.Alerta).ToList();
    var principal = alertas.FirstOrDefault(a => a.Categoria is null) ?? alertas.FirstOrDefault();
    string Veces(ZonaEnAlza a) => a.PromedioAnterior <= 0 ? "aparece de nuevo" : $"{Formato.Decimal(a.SemanaActual / a.PromedioAnterior)}× lo normal";
    // Un punto «late» cuando tuvo un caso en las últimas 24 horas del periodo: es un lugar que sigue activo.
    bool Reciente(PuntoCritico p) => v.FinSemana - p.UltimoCaso <= TimeSpan.FromHours(24);
    var puntosJson = JsonSerializer.Serialize(v.Puntos.Select((p, i) => new { numero = i + 1, lat = p.Latitud, lon = p.Longitud, casos = p.Casos, categoria = p.CategoriaFrecuente, reciente = Reciente(p) }));
    var alzasJson = JsonSerializer.Serialize(v.Alzas.Where(a => a.Categoria is null).Select(a => new
    {
        sur = a.Sur, oeste = a.Oeste, norte = a.Norte, este = a.Este, nombre = m.Zonas.Nombre(a.Sur, a.Oeste), alerta = a.Alerta, texto = Veces(a),
    }));
    string F(double x) => x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    string Hace(DateTimeOffset momento)
    {
        var local = TimeZoneInfo.ConvertTime(momento, m.ZonaHoraria);
        var dias = (DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(v.FinSemana, m.ZonaHoraria).DateTime).DayNumber - DateOnly.FromDateTime(local.DateTime).DayNumber);
        return dias switch { 0 => $"hoy {local:HH:mm}", 1 => $"ayer {local:HH:mm}", _ => $"hace {dias} días" };
    }
    var recientes = v.Puntos.Take(12).Count(Reciente); // solo los 12 con número laten en el mapa
}
@if (v.Puntos.Count == 0 && v.Alzas.Count == 0)
{
    <partial name="_Vacio" model="@(new Vacio($"Nada se repite en {m.TextoPeriodo}.",
        "Ningún lugar acumula 3 o más incidencias a 100 m, y ninguna zona creció esta semana. Con un periodo más largo aparecen los patrones de fondo.",
        m.Periodo == "30" ? [] : [("Ver los últimos 30 días", m.Enlace(periodo: "30"), true)]))" />
}
else
{
    <section class="tarjeta-a respuesta repite-b" aria-labelledby="respuesta-repite" data-respuesta="repite" data-repite>
        <div class="respuesta__cabecera">
            <h2 class="respuesta__titular" id="respuesta-repite">
                @(v.Puntos.Count switch { 0 => "Ningún lugar acumula", 1 => "Un lugar acumula", var n => $"{n} lugares acumulan" }) 3 o más incidencias muy cerca@(principal is null ? "." : "")@if (principal is not null)
                {<text>; esta semana, la <em>@m.Zonas.Nombre(principal.Sur, principal.Oeste)</em> @(principal.PromedioAnterior > 0 ? $"está en {Veces(principal)}" : "no tenía casos y ahora sí").</text>}
            </h2>
            <p class="respuesta__lectura">Un <b>punto crítico</b> es un lugar con 3 o más incidencias a menos de 100 m en @m.TextoPeriodo: en el mapa, más grande cuantos más casos, y el número es su lugar en la lista.@(recientes > 0 ? $" Los que laten tuvieron un caso en las últimas 24 horas ({recientes})." : "") Una <b>zona en alza</b> recibe esta semana más casos de lo normal para ella: va en un recuadro ocre si es una alerta. Pasa el cursor por un punto o por la lista para enlazarlos.</p>
        </div>
        <div class="respuesta__visual">
            <div class="repite-b__tablero">
                <div class="repite-b__mapa">
                    <div class="mapa-a mapa-a--grande" id="mapa-zonas" role="region" aria-label="Mapa de puntos críticos y zonas en alza" tabindex="0"
                         data-teselas="@m.UrlTeselas" data-escala="repite"><script type="application/json" data-puntos>@Html.Raw(puntosJson)</script><script type="application/json" data-alzas>@Html.Raw(alzasJson)</script></div>
                    <a class="repite-b__calor" href="@m.EnlaceConcentracion()">Ver el calor de todos los casos →</a>
                </div>
                <div class="repite-b__lista">
                    <h3 class="repite-b__subtitulo">Puntos críticos</h3>
                    <p class="repite-b__nota">Del que más casos acumula al que menos, en @m.TextoPeriodo.</p>
                    @if (v.Puntos.Count == 0)
                    {
                        <p class="repite-b__nota">Ningún lugar acumula 3 o más incidencias cercanas en el periodo.</p>
                    }
                    else
                    {
                        <ol class="puntos-b">
                            @foreach (var (p, i) in v.Puntos.Take(8).Select((p, i) => (p, i + 1)))
                            {
                                <li>
                                    <button type="button" class="punto-b@(Reciente(p) ? " punto-b--reciente" : "")" data-punto="@i" style="--i:@i">
                                        <span class="punto-b__numero" aria-hidden="true">@i</span>
                                        <b>@m.Zonas.Nombre(p.Latitud - 0.0025, p.Longitud - 0.0025) · @(p.CategoriaFrecuente ?? "Sin clasificar")</b>
                                        <span class="punto-b__casos">@p.Casos<small>@(p.Casos == 1 ? "caso" : "casos")</small></span>
                                        <small>último @Hace(p.UltimoCaso)@(Reciente(p) ? " · sigue activo" : "")</small>
                                    </button>
                                </li>
                            }
                        </ol>
                        @if (v.Puntos.Count > 8)
                        {
                            <p class="repite-b__nota">Y @Formato.Plural(v.Puntos.Count - 8, "punto más", "puntos más") con menos casos (en el mapa).</p>
                        }
                    }
                    <div class="alzas-b">
                        <h3 class="repite-b__subtitulo">Zonas en alza esta semana</h3>
                        @if (v.Alzas.Count == 0)
                        {
                            <p class="repite-b__nota">Ninguna zona subió esta semana respecto de las cuatro anteriores.</p>
                        }
                        else
                        {
                            <p class="repite-b__nota">Casos de cada una de las últimas 5 semanas; la de la derecha es esta.</p>
                            @foreach (var (a, i) in v.Alzas.Take(5).Select((a, i) => (a, i)))
                            {
                                var semanas = a.Semanas ?? [];
                                var techo = Math.Max(1, semanas.DefaultIfEmpty(0).Max());
                                <div class="alza-b@(a.Alerta ? " alza-b--alerta" : "")" data-alerta="@a.Alerta.ToString().ToLowerInvariant()" style="--i:@i">
                                    <span><b>@m.Zonas.Nombre(a.Sur, a.Oeste)</b><small>@(a.Categoria ?? "todas las categorías")</small></span>
                                    <span class="alza-b__semanas" role="img" aria-label="@m.Zonas.Nombre(a.Sur, a.Oeste): @string.Join(", ", semanas) casos por semana; lo normal, @Formato.Decimal(a.PromedioAnterior)">
                                        @for (var s = 0; s < semanas.Count; s++)
                                        {
                                            <i class="@(s == semanas.Count - 1 ? "alza-b__ahora" : "")" style="height:@F(Math.Max(semanas[s] * 100.0 / techo, 4))%;--s:@s"></i>
                                        }
                                    </span>
                                    <span class="alza-b__veces">@(a.Alerta ? "▲ " : "")@Veces(a)<small>@a.SemanaActual @(a.SemanaActual == 1 ? "caso" : "casos") · normal @Formato.Decimal(a.PromedioAnterior)</small></span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <ul class="repite-b__leyenda">
                <li><i class="repite-b__muestra-punto">1</i>Punto crítico: el número es el de la lista; el círculo tenue marca los 100 m</li>
                @if (v.Puntos.Count > 12) { <li><i class="repite-b__muestra-menor"></i>Los demás puntos críticos (@(v.Puntos.Count - 12)), sin número</li> }
                <li><i class="repite-b__muestra-late"></i>Late: caso en las últimas 24 h</li>
                <li><i class="repite-b__muestra-alerta"></i>▲ Zona en alza con alerta</li>
                <li><i class="repite-b__muestra-sube"></i>Zona que subió, sin alerta</li>
            </ul>
            <p class="repite-b__pie">Hay alerta cuando el aumento se sale de lo normal y la zona suma al menos 3 casos en la semana: uno o dos casos más en una zona tranquila no la activan. Las zonas en alza se miden siempre por semana, aunque elijas otro periodo.</p>
        </div>
    </section>
}
