@model (IndexModel M, IndexModel.VistaRepite V)
@using System.Text.Json
@{
    var (m, v) = Model;
    var alertas = v.Alzas.Where(a => a.Alerta).ToList();
    var principal = alertas.FirstOrDefault(a => a.Categoria is null) ?? alertas.FirstOrDefault();
    string Veces(ZonaEnAlza a) => a.PromedioAnterior <= 0 ? "aparece de nuevo" : $"{Formato.Decimal(a.SemanaActual / a.PromedioAnterior)}× lo normal";
    var puntosJson = JsonSerializer.Serialize(v.Puntos.Select((p, i) => new { numero = i + 1, lat = p.Latitud, lon = p.Longitud, casos = p.Casos, categoria = p.CategoriaFrecuente }));
    var alzasJson = JsonSerializer.Serialize(v.Alzas.Where(a => a.Categoria is null).Select(a => new
    {
        sur = a.Sur, oeste = a.Oeste, norte = a.Norte, este = a.Este, nombre = m.Zonas.Nombre(a.Sur, a.Oeste), alerta = a.Alerta, texto = Veces(a),
    }));
    var maxAlza = Math.Max(4, v.Alzas.Select(a => (double)a.SemanaActual).DefaultIfEmpty(0).Max() + 1);
    string P(double x) => (x / maxAlza * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    string Hace(DateTimeOffset momento)
    {
        var local = TimeZoneInfo.ConvertTime(momento, m.ZonaHoraria);
        var dias = (DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(v.FinSemana, m.ZonaHoraria).DateTime).DayNumber - DateOnly.FromDateTime(local.DateTime).DayNumber);
        return dias switch { 0 => $"hoy {local:HH:mm}", 1 => $"ayer {local:HH:mm}", _ => $"hace {dias} días" };
    }
}
@if (v.Puntos.Count == 0 && v.Alzas.Count == 0)
{
    <partial name="_Vacio" model="@(new Vacio($"Nada se repite en {m.TextoPeriodo}.",
        "Ningún lugar acumula 3 o más incidencias a 100 m, y ninguna zona creció esta semana. Con un periodo más largo aparecen los patrones de fondo.",
        m.Periodo == "30" ? [] : [("Ver los últimos 30 días", m.Enlace(periodo: "30"), true)]))" />
}
else
{
    <div class="cobertura-a">
        <section class="tarjeta-a mapa-protagonista" aria-label="Mapa de lo que se repite">
            <div class="mapa-a mapa-a--grande" id="mapa-zonas" role="region" aria-label="Mapa de puntos críticos y zonas en alza" tabindex="0"
                 data-teselas="@m.UrlTeselas" data-escala="repite"><script type="application/json" data-puntos>@Html.Raw(puntosJson)</script><script type="application/json" data-alzas>@Html.Raw(alzasJson)</script></div>
            <div class="respuesta flotante-a" data-respuesta="repite">
                <h2 class="respuesta__titular" id="respuesta-repite">
                    @(v.Puntos.Count switch { 0 => "Ningún lugar acumula 3 o más incidencias", 1 => "Un lugar acumula 3 o más incidencias", var n => $"{n} lugares acumulan 3 o más incidencias" })@if (principal is not null)
                    {<text>; la <em>@m.Zonas.Nombre(principal.Sur, principal.Oeste)</em> @(principal.PromedioAnterior > 0 ? $"está en {Veces(principal)}" : "no tenía casos y ahora sí").</text>}
                    else {<text>.</text>}
                </h2>
                <p class="respuesta__lectura">Círculo azul: punto crítico (100 m) con su número de casos. Recuadro ámbar: zona en alza esta semana.</p>
                <a class="boton boton--secundario boton--compacto" href="@m.EnlaceConcentracion()">Ver en el mapa de concentración →</a>
            </div>
        </section>
        <div class="cobertura-a__lado">
            <section class="tarjeta-a" aria-labelledby="titulo-puntos">
                <div class="tarjeta-a__cabecera"><h3 id="titulo-puntos">Puntos críticos</h3><span class="tarjeta-a__nota">3+ incidencias a 100 m · @m.TextoPeriodo</span></div>
                @if (v.Puntos.Count == 0)
                {
                    <p class="tarjeta-a__vacia">Ningún lugar acumula 3 o más incidencias cercanas en el periodo.</p>
                }
                else
                {
                    <ol class="filas-a">
                        @foreach (var (p, i) in v.Puntos.Take(6).Select((p, i) => (p, i + 1)))
                        {
                            <li class="fila-a" data-punto="@i">
                                <span class="numero-a">@i</span>
                                <span>@m.Zonas.Nombre(p.Latitud - 0.0025, p.Longitud - 0.0025)<br /><span class="tarjeta-a__nota">@(p.CategoriaFrecuente ?? "Sin clasificar") · último @Hace(p.UltimoCaso)</span></span>
                                <span class="fila-a__cifra">@p.Casos <small>casos</small></span>
                            </li>
                        }
                    </ol>
                }
            </section>
            <section class="tarjeta-a" aria-labelledby="titulo-alzas">
                <div class="tarjeta-a__cabecera"><h3 id="titulo-alzas">Zonas en alza</h3><span class="tarjeta-a__nota">● esta semana · ● gris: promedio de 4 semanas</span></div>
                @if (v.Alzas.Count == 0)
                {
                    <p class="tarjeta-a__vacia">Ninguna zona subió esta semana respecto de las cuatro anteriores.</p>
                }
                else
                {
                    <ul class="alzas-a">
                        @foreach (var a in v.Alzas.Take(5))
                        {
                            <li class="alza-a @(a.Alerta ? "alza-a--alerta" : "")" data-alerta="@a.Alerta.ToString().ToLowerInvariant()">
                                <span>@m.Zonas.Nombre(a.Sur, a.Oeste)<br /><span class="tarjeta-a__nota">@(a.Categoria ?? "todas las categorías")</span></span>
                                <span class="alza-a__pista" aria-hidden="true"><span class="alza-a__linea" style="left:@P(a.PromedioAnterior)%;width:calc(@P(a.SemanaActual)% - @P(a.PromedioAnterior)%)"></span><span class="alza-a__antes" style="left:@P(a.PromedioAnterior)%"></span><span class="alza-a__ahora" style="left:@P(a.SemanaActual)%"></span></span>
                                <span class="fila-a__cifra @(a.Alerta ? "fila-a__cifra--aviso" : "")">@(a.Alerta ? "▲ " : "")@a.SemanaActual <small>vs @Formato.Decimal(a.PromedioAnterior)</small></span>
                            </li>
                        }
                    </ul>
                    <p class="tarjeta-a__nota tarjeta-a__nota--bloque">Alerta en ámbar cuando el aumento se sale de lo normal (no por uno o dos casos).</p>
                }
                <a class="enlace-a" href="@m.EnlaceConcentracion()">Abrir el periodo en el mapa de concentración →</a>
            </section>
        </div>
    </div>
}
