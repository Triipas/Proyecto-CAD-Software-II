@page "/panel/analitica/{pregunta?}"
@model Cad.Server.Panel.Pages.Analitica.IndexModel
@{
    ViewData["Title"] = $"Analítica · {Model.Actual.Titulo}";
    ViewData["ClasePagina"] = "pagina--analitica";
    var enVivo = Model.Actual.Clave == "ahora";
    // El detalle de un sereno lleva el mapa de las zonas por donde patrulla; la salud del sistema, el margen del GPS a escala.
    var conMapa = Model.Actual.Clave is "tiempo" or "cobertura" or "repite" or "sistema" || (Model.Actual.Clave == "serenos" && Model.Sereno is not null);
}
@section Estilos {
    @if (conMapa)
    {
        <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/analitica.css" asp-append-version="true" />
    @if (Model.Actual.Clave == "sistema")
    {
        <link rel="stylesheet" href="~/css/analitica-sistema.css" asp-append-version="true" />
    }
    @if (Model.Actual.Clave == "serenos")
    {
        <link rel="stylesheet" href="~/css/analitica-serenos.css" asp-append-version="true" />
    }
    @if (Model.Actual.Clave == "reasigna")
    {
        <link rel="stylesheet" href="~/css/analitica-reasigna.css" asp-append-version="true" />
    }
    @if (Model.Actual.Clave == "cobertura")
    {
        <link rel="stylesheet" href="~/css/analitica-cobertura.css" asp-append-version="true" />
    }
    @if (Model.Actual.Clave == "tiempo")
    {
        <link rel="stylesheet" href="~/css/analitica-tiempo.css" asp-append-version="true" />
    }
    @if (Model.Actual.Clave == "falsos")
    {
        <link rel="stylesheet" href="~/css/analitica-falsos.css" asp-append-version="true" />
    }
}
<div class="analitica" data-analitica="@Model.Actual.Clave">
    @* La columna de preguntas: cada una con su dato del periodo y su estado (icono y texto, nunca solo color). *@
    <nav class="preguntas" aria-label="Preguntas de la analítica">
        <h1 class="preguntas__titulo">Analítica</h1>
        <p class="preguntas__ayuda">Elige una pregunta: la respuesta va primero, la evidencia debajo.</p>
        <ul class="preguntas__lista">
            @foreach (var p in Preguntas.Todas)
            {
                var resumen = Model.Resumenes.GetValueOrDefault(p.Clave);
                <li>
                    <a class="pregunta" href="@Model.Enlace(p.Clave)" aria-current="@(p.Clave == Model.Actual.Clave ? "page" : null)" data-pregunta="@p.Clave">
                        <span class="pregunta__icono">@Preguntas.Icono(p)</span>
                        <span class="pregunta__titulo">@p.Titulo</span>
                        <span class="pregunta__dato @(resumen?.Tono is { Length: > 0 } tono ? $"pregunta__dato--{tono}" : "")">@(resumen?.Texto ?? "")</span>
                    </a>
                </li>
            }
        </ul>
        <div class="preguntas__pie">
            <a class="boton boton--secundario boton--compacto" href="@Model.EnlaceInforme()" data-informe>
                <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14" /></svg>
                Informe del periodo (CSV)
            </a>
            <span>MVP académico · datos simulados</span>
        </div>
    </nav>

    <div class="analitica__trabajo">
        @if (enVivo)
        {
            <div class="filtros-analitica">
                <span class="vivo-analitica" data-vivo data-conexion="conectando" role="status"><span class="vivo-analitica__punto" aria-hidden="true"></span><span data-texto>Conectando…</span></span>
                <a class="boton boton--secundario boton--compacto filtros-analitica__accion" href="/panel/central">Abrir la central</a>
            </div>
        }
        else
        {
            @* Periodo: hoy, 7 días, 30 días o un rango. Enlaces y formularios GET: la selección queda en la dirección. *@
            <div class="filtros-analitica" data-filtros>
                <div class="segmentado" role="group" aria-label="Periodo">
                    @foreach (var (valor, texto) in Model.Periodos)
                    {
                        <a class="segmentado__opcion" href="@Model.Enlace(periodo: valor)" aria-current="@(Model.Periodo == valor ? "true" : null)">@texto</a>
                    }
                </div>
                <details class="rango" open="@(Model.Periodo == "rango")">
                    <summary class="segmentado__opcion rango__abrir" aria-current="@(Model.Periodo == "rango" ? "true" : null)">Personalizado</summary>
                    <form class="rango__campos" method="get" action="@Url.Page("/Analitica/Index", new { pregunta = Model.Actual.Clave })">
                        <input type="hidden" name="periodo" value="rango" />
                        <label class="rango__campo">Desde <input class="campo__control" type="date" name="desde" value="@Model.Desde" required /></label>
                        <label class="rango__campo">Hasta <input class="campo__control" type="date" name="hasta" value="@Model.Hasta" required /></label>
                        @if (Model.Prioridad is { } prioridadRango)
                        {
                            <input type="hidden" name="prioridad" value="@prioridadRango" />
                        }
                        @if (Model.Actual.Clave == "serenos" && Model.Sereno is { } serenoRango)
                        {
                            <input type="hidden" name="sereno" value="@serenoRango" />
                        }
                        <button type="submit" class="boton boton--principal boton--compacto">Ver</button>
                    </form>
                </details>
                @if (Model.Actual.Clave == "tiempo")
                {
                    <form method="get" action="@Url.Page("/Analitica/Index", new { pregunta = Model.Actual.Clave })" class="filtro-select">
                        <input type="hidden" name="periodo" value="@Model.Periodo" />
                        @if (Model.Periodo == "rango")
                        {
                            <input type="hidden" name="desde" value="@Model.Desde" />
                            <input type="hidden" name="hasta" value="@Model.Hasta" />
                        }
                        <label class="visualmente-oculto" for="filtro-prioridad">Prioridad</label>
                        <select id="filtro-prioridad" class="campo__control campo__control--seleccion" name="prioridad" data-enviar-al-cambiar>
                            <option value="">Prioridad: todas</option>
                            @foreach (var o in Cad.Contratos.Casos.PrioridadesCaso.Todas)
                            {
                                <option value="@o.Codigo" selected="@(Model.Prioridad == o.Codigo)">Prioridad: @o.Codigo.ToLowerInvariant()</option>
                            }
                        </select>
                        <noscript><button type="submit" class="boton boton--secundario boton--compacto">Ver</button></noscript>
                    </form>
                }
                @if (Model.Actual.Clave == "bloques")
                {
                    <span class="filtros-analitica__periodo">Datos simulados · @BloquesDistrito.Todos.Count bloques · @BloquesDistrito.TotalZonas zonas</span>
                }
                else
                {
                    <span class="filtros-analitica__periodo">Comparado con @Model.TextoAnterior</span>
                }
            </div>
            @if (Model.ErrorPeriodo is { } errorPeriodo)
            {
                <div class="aviso aviso--advertencia" role="status"><partial name="_Icono" model="@("advertencia")" /><div><p class="aviso__texto">@errorPeriodo</p></div></div>
            }
        }

        @if (Model.Error is { } referencia)
        {
            <partial name="_Error" model="@(Model.Actual, referencia, Model.Enlace())" />
        }
        else
        {
            switch (Model.Vista)
            {
                case IndexModel.VistaBloques v: <partial name="_Bloques" model="(Model, v)" /> break;
                case IndexModel.VistaAhora v: <partial name="_Ahora" model="(Model, v)" /> break;
                case IndexModel.VistaTiempo v: <partial name="_Tiempo" model="(Model, v)" /> break;
                case IndexModel.VistaFalsos v: <partial name="_Falsos" model="(Model, v)" /> break;
                case IndexModel.VistaCobertura v: <partial name="_Cobertura" model="(Model, v)" /> break;
                case IndexModel.VistaReasigna v: <partial name="_Reasignaciones" model="(Model, v)" /> break;
                case IndexModel.VistaSerenos v when v.Pedido is null: <partial name="_Serenos" model="(Model, v)" /> break;
                case IndexModel.VistaSerenos v: <partial name="_Sereno" model="(Model, v)" /> break;
                case IndexModel.VistaRepite v: <partial name="_Repite" model="(Model, v)" /> break;
                case IndexModel.VistaCiudadano v: <partial name="_Ciudadano" model="(Model, v)" /> break;
                case IndexModel.VistaSistema v: <partial name="_Sistema" model="(Model, v)" /> break;
            }
        }
        <p class="analitica__mvp">MVP académico · datos simulados · no es un canal oficial de emergencias</p>
    </div>
</div>
@section Scripts {
    @if (conMapa)
    {
        <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    }
    @if (enVivo)
    {
        <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    }
    @if (Model.Actual.Clave == "bloques")
    {
        @* Antes que analitica.js: el titular ya está armado según los filtros cuando sus cifras empiezan a rodar. *@
        <script src="~/js/analitica-bloques.js" asp-append-version="true"></script>
    }
    <script src="~/js/analitica.js" asp-append-version="true"></script>
    @if (Model.Actual.Clave == "sistema")
    {
        <script src="~/js/analitica-sistema.js" asp-append-version="true"></script>
    }
    @if (Model.Actual.Clave == "reasigna")
    {
        <script src="~/js/analitica-reasigna.js" asp-append-version="true"></script>
    }
    @if (Model.Actual.Clave == "cobertura")
    {
        <script src="~/js/analitica-cobertura.js" asp-append-version="true"></script>
    }
    @if (Model.Actual.Clave == "tiempo")
    {
        <script src="~/js/analitica-tiempo.js" asp-append-version="true"></script>
    }
    @if (Model.Actual.Clave == "falsos")
    {
        <script src="~/js/analitica-falsos.js" asp-append-version="true"></script>
    }
}
