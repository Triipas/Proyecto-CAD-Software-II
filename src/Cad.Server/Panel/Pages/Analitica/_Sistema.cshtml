@model (IndexModel M, IndexModel.VistaSistema V)
@{
    var (m, v) = Model;
    var s = v.Salud;
    var senales = Sistema.Senales(s);
    var alertas = senales.Where(x => !x.Bien).ToList();
    // La cadena de un SOS, tramo a tramo. El tramo de la app al servidor no se mide: el SOS se registra al llegar.
    const double PresentacionAceptable = 5, AperturaAceptable = 60;
    var tramos = new (string Texto, bool? Bien, string Ayuda, string Mide)[]
    {
        ("no se mide", null, "El SOS se registra al llegar al servidor", "el SOS se registra al llegar: no hay tiempo que medir"),
        (s.PresentacionP50Segundos is { } p ? Formato.Minutos(p / 60) : "sin datos", s.PresentacionP50Segundos is { } p2 ? p2 <= PresentacionAceptable : null, $"Mediana del registro a verse en la central abierta · aceptable: {PresentacionAceptable} s o menos", $"del registro a verse en la central (aceptable: {PresentacionAceptable} s o menos)"),
        (s.AperturaP50Segundos is { } q ? Formato.Minutos(q / 60) : "sin datos", s.AperturaP50Segundos is { } q2 ? q2 <= AperturaAceptable : null, $"Mediana del registro a que un operador abre el detalle · aceptable: {AperturaAceptable} s o menos", $"del registro a que un operador lo abre (aceptable: {AperturaAceptable} s o menos)"),
        (s.PorcentajePushEnviadas is { } e ? $"{Formato.Porcentaje(e, 0)} llega" : "sin datos", s.PorcentajePushEnviadas is { } e2 ? e2 >= 95 : null, "Avisos push al sereno entregados al servicio de notificaciones · aceptable: más del 95 %", "de los avisos al sereno llegan al servicio de notificaciones (aceptable: más del 95 %)"),
    };
    var nodos = new[] { ("App del ciudadano", "emite el SOS"), ("Servidor", "lo registra"), ("Central", "lo muestra"), ("Operador", "lo abre"), ("App del sereno", "recibe el despacho") };
    var sinDatos = s.Sos == 0 && s.PorcentajePushEnviadas is null && s.IniciosAtencion == 0;

    // Las cuatro constantes vitales: los tres tramos medidos de la cadena y el GPS impreciso. Las demás señales van debajo.
    var gps = senales[1];
    var monitores = new (string Titulo, string Valor, string Unidad, string Que, string Limite, bool? Bien)[]
    {
        ("Llega a la central", s.PresentacionP50Segundos is { } pr ? Formato.Decimal(pr, pr < 10 ? 1 : 0) : "—", s.PresentacionP50Segundos is null ? "" : "s", "del registro a verse en la central abierta (mediana)", $"aceptable: {PresentacionAceptable} s o menos", tramos[1].Bien),
        ("Lo abre un operador", s.AperturaP50Segundos is { } ap ? Formato.Decimal(ap, 0) : "—", s.AperturaP50Segundos is null ? "" : "s", "del registro a que un operador abre el detalle (mediana)", $"aceptable: {AperturaAceptable} s o menos", tramos[2].Bien),
        ("Avisos al sereno", s.PorcentajePushEnviadas is { } pu ? Formato.Decimal(pu, 0) : "—", s.PorcentajePushEnviadas is null ? "" : "%", "de los avisos push llegan al servicio de notificaciones", "aceptable: más del 95 %", tramos[3].Bien),
        ("GPS impreciso", gps.Valor is { } gv ? Formato.Decimal(gv, 0) : "—", gps.Valor is null ? "" : "%", "de los SOS llega con más de 100 m de margen", "aceptable: menos del 15 %", gps.Valor is null ? null : gps.Bien),
    };
    var otras = new[] { senales[0], senales[3], senales[4] };
    string Pct(double x) => x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    // Un latido: plano, un pico y plano otra vez. Es decoración (aria-hidden): las cifras están en el número grande.
    const string Latido = "M 0 40 L 60 40 L 70 34 L 80 40 L 100 40 L 108 49 L 116 10 L 124 55 L 132 40 L 160 40 L 172 30 L 186 40 L 300 40";
}
@if (sinDatos)
{
    <partial name="_Vacio" model="@(new Vacio($"No hubo SOS, avisos ni atenciones en {m.TextoPeriodo}.",
        "Las señales del sistema se miden sobre lo que pasó: sin SOS no hay cadena que medir. Prueba con un periodo más largo.",
        m.Periodo == "30" ? [] : [("Ver los últimos 30 días", m.Enlace(periodo: "30"), true)]))" />
}
else
{
    <section class="tarjeta-a respuesta salud-b" aria-labelledby="respuesta-sistema" data-respuesta="sistema" data-alertas="@alertas.Count">
        <div class="respuesta__cabecera">
            @if (alertas.Count == 0 && tramos.All(t => t.Bien != false))
            {
                // Lo medido de la cadena, en una frase: hasta dos tramos con dato (los valores son cifras formateadas).
                var partes = new List<string>();
                if (s.PresentacionP50Segundos is not null) partes.Add($"un SOS aparece en la central en <em>{tramos[1].Texto}</em>");
                if (s.AperturaP50Segundos is not null) partes.Add($"{(partes.Count == 0 ? "un operador abre un SOS" : "se abre")} a los <em>{tramos[2].Texto}</em>");
                if (s.PorcentajePushEnviadas is { } envio) partes.Add($"el <em>{Formato.Porcentaje(envio, 0)}</em> de los avisos llega al sereno");
                partes = partes.Take(2).ToList();
                <h2 class="respuesta__titular" id="respuesta-sistema">El sistema responde bien@(Html.Raw(partes.Count == 0 ? "" : ": " + string.Join(" y ", partes))).</h2>
            }
            else
            {
                // El aviso push aparece en la cadena (último tramo) y en las señales: se cuenta una sola vez.
                var malos = alertas.Count + tramos.Take(3).Count(t => t.Bien == false);
                <h2 class="respuesta__titular" id="respuesta-sistema"><em>@Formato.Plural(malos, "señal", "señales")</em> fuera de lo aceptable@(alertas.FirstOrDefault() is { } primera ? $": «{primera.Nombre}» está en {primera.Texto}." : ": la cadena del SOS tarda más de lo aceptable.")</h2>
            }
            <p class="respuesta__lectura">Las constantes vitales del sistema en @m.TextoPeriodo: lo que tarda un SOS en llegar a la central y en abrirse, cuántos avisos llegan al sereno y cuántos SOS llegan con un GPS impreciso. En verde, dentro de lo aceptable; en ámbar con ▲, fuera; en gris, sin datos.</p>
        </div>
        <div class="respuesta__visual">
            <div class="monitores-b">
                @for (var i = 0; i < monitores.Length; i++)
                {
                    var mo = monitores[i];
                    var clase = mo.Bien switch { true => "", false => " monitor-b--alerta", _ => " monitor-b--sin" };
                    <article class="monitor-b@(clase)" style="--i:@i" data-monitor="@mo.Titulo">
                        <div class="monitor-b__cabeza">@mo.Titulo<span>@(mo.Bien switch { true => "bien", false => "▲ fuera", _ => "sin datos" })</span></div>
                        <b class="monitor-b__valor">@mo.Valor<small>@mo.Unidad</small></b>
                        <span class="monitor-b__que">@mo.Que</span>
                        <span class="monitor-b__limite">@mo.Limite</span>
                        @if (mo.Bien is not null)
                        {
                            <svg viewBox="0 0 300 64" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path class="monitor-b__latido" d="@Latido" pathLength="1" /></svg>
                            <span class="monitor-b__barrido" aria-hidden="true"></span>
                        }
                    </article>
                }
            </div>
            <ol class="cadena-b" aria-label="La cadena de un SOS">
                @for (var i = 0; i < nodos.Length; i++)
                {
                    <li class="cadena-b__nodo" title="@nodos[i].Item2">@nodos[i].Item1</li>
                    @if (i < tramos.Length)
                    {
                        var t = tramos[i];
                        <li class="cadena-b__tramo @(t.Bien switch { true => "cadena-b__tramo--bien", false => "cadena-b__tramo--alerta", _ => "" })" title="@t.Ayuda" data-tramo="@i">
                            <span>@(t.Bien == false ? "▲ " : "")@t.Texto</span>
                            <span class="visualmente-oculto">@t.Mide</span>
                        </li>
                    }
                }
            </ol>
        </div>
    </section>

    <div class="rejilla-a rejilla-a--dos">
        <section class="tarjeta-a" aria-labelledby="titulo-senales">
            <div class="tarjeta-a__cabecera"><h3 id="titulo-senales">Las otras señales de los datos</h3><span class="tarjeta-a__nota">lo medido en @m.TextoPeriodo frente a lo aceptable</span></div>
            <ul class="otras-b">
                @foreach (var x in otras)
                {
                    <li class="@(x.Bien ? "" : "otras-b--alerta")" data-senal="@x.Nombre" data-bien="@x.Bien.ToString().ToLowerInvariant()">
                        <span class="otras-b__nombre">@x.Nombre<small>@x.Ayuda</small></span>
                        <b class="otras-b__valor">@(x.Valor is null ? "–" : x.Bien ? "✓ " : "▲ ")@x.Texto<span class="visualmente-oculto">@(x.Valor is null ? "" : x.Bien ? ", dentro de lo aceptable" : ", fuera de lo aceptable")</span></b>
                        <span class="otras-b__regla" aria-hidden="true">
                            @if (x.MayorEsMejor) { <span class="otras-b__banda" style="left:@Pct(x.Limite / x.Maximo * 100)%;right:0"></span> } else { <span class="otras-b__banda" style="left:0;width:@Pct(x.Limite / x.Maximo * 100)%"></span> }
                            <span class="otras-b__limite" style="left:@Pct(x.Limite / x.Maximo * 100)%"></span>
                            @if (x.Valor is { } valor) { <span class="otras-b__punto" style="left:@Pct(Math.Clamp(valor, 0, x.Maximo) / x.Maximo * 100)%"></span> }
                        </span>
                    </li>
                }
            </ul>
            <ul class="leyenda-a leyenda-a--compacta">
                <li><i class="leyenda-a__banda"></i>Franja aceptable (provisional; la línea punteada es el límite)</li>
                <li><i class="leyenda-a__atascado leyenda-a__atascado--lleno"></i>▲ Fuera de lo aceptable</li>
            </ul>
            @foreach (var x in alertas.Where(a => otras.Contains(a)))
            {
                <p class="tarjeta-a__nota tarjeta-a__nota--bloque senal-a__nota">▲ Fuera de lo aceptable: «@x.Nombre» está en @x.Texto (@x.Ayuda).</p>
            }
        </section>
        <section class="tarjeta-a" aria-labelledby="titulo-gps">
            <div class="tarjeta-a__cabecera"><h3 id="titulo-gps">El margen del GPS, a escala</h3><span class="tarjeta-a__nota">de los SOS con ubicación</span></div>
            @if (s.PrecisionP50Metros is { } precision)
            {
                var p90 = s.PrecisionP90Metros ?? precision;
                <div class="gps-b" data-gps data-teselas="@m.UrlTeselas" data-p50="@Pct(precision)" data-p90="@Pct(p90)" role="img"
                     aria-label="La mitad de los SOS tiene un margen de @Formato.Decimal(precision, 0) m o menos; el 10 % peor, de más de @Formato.Decimal(p90, 0) m"></div>
                <ul class="leyenda-a leyenda-a--compacta">
                    <li><i class="gps-b__muestra-p50"></i>La mitad: @Formato.Decimal(precision, 0) m o menos</li>
                    <li><i class="gps-b__muestra-p90"></i>El 10 % peor: más de @Formato.Decimal(p90, 0) m</li>
                </ul>
                <p class="tarjeta-a__nota tarjeta-a__nota--bloque">Los círculos tienen el radio real del margen, dibujados en el centro del distrito: así se ve cuántas cuadras puede abarcar un SOS impreciso. @Formato.Porcentaje(s.PorcentajePrecisionBaja, 0) de los SOS llega con más de 100 m.</p>
            }
            else
            {
                <p class="tarjeta-a__vacia">Ningún SOS del periodo trajo la precisión de su GPS.</p>
            }
        </section>
    </div>
}
