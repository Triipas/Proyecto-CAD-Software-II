@model (IndexModel M, IndexModel.VistaReasigna V)
@{
    var (m, v) = Model;
    var r = v.Actual;
    var antes = v.Anterior;
    var minimo = m.Opciones.MinimoParaPercentiles;
    var referencia = m.Opciones.ReferenciaReasignadosPorcentaje;
    var porcentaje = r.PorcentajeReasignados;
    var sobre = porcentaje is { } p && p > referencia;
    // La regla del porcentaje, la misma de las señales del sistema: la franja aceptable es hasta la referencia (provisional).
    var senal = porcentaje is { } pc
        ? new Sistema.Senal("Casos asignados que se reasignaron", $"referencia provisional: {Formato.Porcentaje(referencia, 0)} o menos", pc, referencia, Math.Max(30, Math.Ceiling(pc / 10) * 10), false)
        : null;
    string[] clases = ["barra100__a", "barra100__b", "barra100__c", "barra100__d", "barra100__e"];
    var filas = r.Motivos.Select((x, i) => (x.Texto, x.Veces, x.Codigo == ConsultarReasignaciones.SinMotivo ? "barra100__sin-registrar" : clases[i % clases.Length])).ToList();
    // Qué sugiere el motivo que más se repite (solo con reasignaciones suficientes para que sea un patrón y no una casualidad).
    var principal = r.Reasignaciones >= minimo ? r.Motivos.Where(x => x.Veces > 0).OrderByDescending(x => x.Veces).First() : null;
    var lectura = principal?.Codigo switch
    {
        Cad.Contratos.Casos.MotivosReasignacion.SerenoNoResponde => "El motivo principal es que el sereno no responde: conviene revisar si recibe el aviso y cómo confirma el despacho.",
        Cad.Contratos.Casos.MotivosReasignacion.FallaDelEquipo => "El motivo principal es una falla del equipo o falta de señal: el problema es de la app o de la cobertura, no de la asignación.",
        Cad.Contratos.Casos.MotivosReasignacion.OtroMasCercano => "El motivo principal es que había otro sereno más cerca: revisa si la sugerencia del más cercano se está usando al asignar.",
        Cad.Contratos.Casos.MotivosReasignacion.SerenoOcupado => "El motivo principal es que el sereno estaba ocupado en otro hecho: puede faltar disponibilidad en ese momento.",
        _ => null,
    };
}
@if (r.CasosAsignados == 0)
{
    <partial name="_Vacio" model="@(new Vacio($"No se asignó ningún caso en {m.TextoPeriodo}.",
        "Sin casos asignados no hay reasignaciones que contar. Prueba con un periodo más largo.",
        m.Periodo == "30" ? [] : [("Ver los últimos 30 días", m.Enlace(periodo: "30"), true)]))" />
}
else
{
    <section class="tarjeta-a respuesta" aria-labelledby="respuesta-reasigna" data-respuesta="reasigna" data-sobre="@sobre.ToString().ToLowerInvariant()">
        <div class="respuesta__cabecera">
            @if (r.CasosReasignados == 0)
            {
                <h2 class="respuesta__titular" id="respuesta-reasigna"><em>Ningún caso</em> de los @Formato.Plural(r.CasosAsignados, "asignado", "asignados") en @m.TextoPeriodo se reasignó.</h2>
            }
            else
            {
                <h2 class="respuesta__titular" id="respuesta-reasigna">Se reasignó el <em>@Formato.Porcentaje(porcentaje!.Value)</em> de los casos asignados (@r.CasosReasignados de @r.CasosAsignados)@(sobre ? $", por encima de la referencia de {Formato.Porcentaje(referencia, 0)}." : ".")</h2>
            }
            <p class="respuesta__lectura">Una reasignación es cuando la central le quita un caso a un sereno que aún no llegó (asignado o en camino) y se lo da a otro: cada una es tiempo que el ciudadano esperó de más. Cada caso cuenta una vez, aunque se reasigne varias veces. Datos de @m.TextoPeriodo.</p>
        </div>
        @if (senal is not null)
        {
            <div class="respuesta__visual">
                <ul class="senales-a">
                    <li class="senal-a @(senal.Bien ? "" : "senal-a--alerta")" data-senal="reasignados" data-bien="@senal.Bien.ToString().ToLowerInvariant()">
                        <span class="senal-a__estado" aria-hidden="true">@(senal.Bien ? "✓" : "▲")</span>
                        <span><span class="senal-a__nombre">@senal.Nombre</span><br /><span class="tarjeta-a__nota">@senal.Ayuda@(antes.PorcentajeReasignados is { } previo ? $" · antes: {Formato.Porcentaje(previo, 0)}" : "")</span></span>
                        @Sistema.Regla(senal)
                        <b class="senal-a__valor">@senal.Texto<span class="visualmente-oculto">@(senal.Bien ? ", dentro de lo aceptable" : ", fuera de lo aceptable")</span></b>
                    </li>
                </ul>
                <ul class="leyenda-a leyenda-a--compacta">
                    <li><i class="leyenda-a__lleno" style="background:var(--color-exito)"></i>Valor del periodo, dentro de lo aceptable</li>
                    <li><i class="leyenda-a__atascado leyenda-a__atascado--lleno"></i>▲ Fuera de lo aceptable</li>
                    <li><i class="leyenda-a__banda"></i>Franja aceptable (provisional; la línea punteada es el límite)</li>
                </ul>
            </div>
        }
    </section>

    <div class="rejilla-a rejilla-a--tres">
        <section class="tarjeta-a" aria-labelledby="titulo-motivos">
            <div class="tarjeta-a__cabecera"><h3 id="titulo-motivos">¿Por qué se reasigna?</h3><span class="tarjeta-a__nota">@Formato.Plural(r.Reasignaciones, "reasignación", "reasignaciones")</span></div>
            @if (r.Reasignaciones == 0)
            {
                <p class="tarjeta-a__vacia">No hubo reasignaciones en el periodo.</p>
            }
            else
            {
                <partial name="_Filas100" model="@(new List<(string, IReadOnlyList<(string, int, string)>)> { ("", filas) } as IReadOnlyList<(string, IReadOnlyList<(string, int, string)>)>, r.Reasignaciones)" />
                <p class="tarjeta-a__nota tarjeta-a__nota--bloque">El motivo lo elige la central al reasignar.@(lectura is null ? "" : " " + lectura)@(r.Reasignaciones < minimo ? $" Con tan pocas reasignaciones (mín. {minimo}) no hay un patrón que leer." : "")</p>
            }
        </section>
        <section class="tarjeta-a" aria-labelledby="titulo-espera">
            <div class="tarjeta-a__cabecera"><h3 id="titulo-espera">¿Cuánto tardó en cambiar?</h3><span class="tarjeta-a__nota">con el primer sereno</span></div>
            @if (r.Esperas == 0)
            {
                <p class="tarjeta-a__vacia">Sin reasignaciones en el periodo: no hay tiempo que medir.</p>
            }
            else
            {
                <dl class="cifras-a" data-espera>
                    <div><dt>La mitad, en este tiempo o menos</dt><dd>@Formato.Minutos(r.EsperaP50Minutos)</dd></div>
                    @if (r.Esperas >= minimo)
                    {
                        <div><dt>El 10 % más largo, en más de</dt><dd>@Formato.Minutos(r.EsperaP90Minutos)</dd></div>
                    }
                </dl>
                <p class="tarjeta-a__nota tarjeta-a__nota--bloque">Tiempo desde que se le asignó el caso al primer sereno hasta que la central lo reasignó: es lo que el ciudadano esperó antes de que el caso cambiara de manos.@(r.Esperas < minimo ? $" Con tan pocas reasignaciones (mín. {minimo}) solo se muestra la mediana." : "")</p>
            }
        </section>
        <section class="tarjeta-a" aria-labelledby="titulo-serenos-reasigna">
            <div class="tarjeta-a__cabecera"><h3 id="titulo-serenos-reasigna">¿A cuántos serenos?</h3><span class="tarjeta-a__nota">sin nombres</span></div>
            <dl class="cifras-a" data-concentracion>
                <div><dt>Serenos con casos asignados</dt><dd>@r.SerenosConAsignacion</dd></div>
                <div><dt>Serenos a quienes se les quitó un caso</dt><dd>@r.SerenosConRetiros</dd></div>
                @if (r.Reasignaciones > 0)
                {
                    <div><dt>Casos quitados al que más perdió</dt><dd>@r.MaximoRetirosDeUnSereno de @r.Reasignaciones</dd></div>
                }
                <div><dt>Casos reasignados más de una vez</dt><dd>@r.CasosReasignadosVariasVeces</dd></div>
                <div><dt>Retirados por desactivar la cuenta</dt><dd>@r.RetirosPorDesactivacion</dd></div>
            </dl>
            <p class="tarjeta-a__nota tarjeta-a__nota--bloque">Si casi todos los casos quitados vienen de uno o dos serenos, el problema es de ellos (equipo, señal, turno); si se reparten, es del proceso. Quiénes son se ve en el historial de cada caso. Retirar por desactivar la cuenta no es una decisión de la central y no cuenta como reasignación.</p>
        </section>
    </div>
}
