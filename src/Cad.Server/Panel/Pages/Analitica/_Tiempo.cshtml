@model (IndexModel M, IndexModel.VistaTiempo V)
@using System.Text.Json
@{
    var (m, v) = Model;
    var objetivo = m.Opciones.ObjetivoRespuestaSosMinutos;
    var minimo = m.Opciones.MinimoParaPercentiles;
    var grupo = v.Grupos.FirstOrDefault(g => g.Origen == ConsultarTiemposPorEtapa.Sos && g.Prioridad == v.Prioridad);
    EtapaTiempo? Etapa(string nombre) => grupo?.Etapas.FirstOrDefault(e => e.Etapa == nombre);
    var n = v.Respuestas.Count;
    var p50 = Estadistica.Percentil(v.Respuestas, 0.5);
    var p90 = Estadistica.Percentil(v.Respuestas, 0.9);
    var anterior = v.Prioridad is null ? v.TotalAnterior : null;
    var textoPrioridad = v.Prioridad is { } pr ? $" de prioridad {pr.ToLowerInvariant()}" : "";

    // El recorrido de un SOS típico: cada tramo dura la mediana de su etapa (contacto, despacho, salida, en camino).
    var contacto = Etapa("Hasta el primer contacto")?.P50Minutos;
    var despacho = Etapa("Hasta el despacho")?.P50Minutos;
    var tramos = new List<(string, double, string)>();
    if (contacto is { } c) tramos.Add(("Contactar al ciudadano", c, "var(--rampa-2)"));
    if (despacho is { } d) tramos.Add(("Elegir y despachar a un sereno", Math.Max(0, d - (contacto ?? 0)), "var(--rampa-3)"));
    if (Etapa("Del despacho a «En camino»")?.P50Minutos is { } salida) tramos.Add(("El sereno sale", salida, "var(--rampa-4)"));
    if (Etapa("De «En camino» a la atención")?.P50Minutos is { } camino) tramos.Add(("El sereno llega al lugar", camino, "var(--rampa-6)"));
    var masLargo = tramos.Count == 0 ? default : tramos.MaxBy(t => t.Item2);
    var sumaTramos = tramos.Sum(t => t.Item2);
    // La escala llega al p90 (o al caso más lento cuando son pocos) sin pasar de 4 veces el objetivo: un SOS de horas no aplasta a
    // los demás; se dibuja en el borde con su tiempo real («→ 4 h 36 min»).
    var tope = n < minimo ? v.Respuestas.DefaultIfEmpty(0).Max() : p90 ?? 0;
    var maximo = Math.Ceiling(Math.Min(new[] { tope, objetivo * 2.0, anterior?.RespuestaP90 ?? 0, sumaTramos }.Max(), objetivo * 4.0) / 5) * 5 + 5;
    // El histograma: una columna por minuto hasta el borde de la escala; el periodo anterior, como línea detrás (si tiene casos
    // suficientes). Las dos formas comparten el alto máximo para compararse en la misma escala.
    var columnas = (int)maximo;
    var conteos = Distribucion.Contar(v.Respuestas, columnas);
    var conteosAntes = v.RespuestasAnteriores.Count >= minimo ? Distribucion.Contar(v.RespuestasAnteriores, columnas) : null;
    var techo = Math.Max(1, Math.Max(conteos.Max(), conteosAntes?.Max() ?? 0)) * 1.08;
    double X(double? minutos) => Math.Min(minutos ?? 0, columnas) / columnas * 100;

    string F(double x) => x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var prioridades = v.Grupos.Where(g => g.Origen == ConsultarTiemposPorEtapa.Sos && g.Prioridad is not null)
        .Select(g => (g.Prioridad!, g.Etapas.Single(e => e.Etapa.StartsWith("Respuesta"))))
        .ToList();
    var atascados = v.Casos.Atascados.Where(a => a.Origen != Cad.Server.Modulos.Casos.Dominio.OrigenCaso.Reporte).Take(4).ToList();
    var zonasJson = JsonSerializer.Serialize(v.Zonas.Zonas.Where(z => z.Tiempos.RespuestaP90 is not null).Select(z => new
    {
        sur = z.Sur, oeste = z.Oeste, norte = z.Norte, este = z.Este, valor = Math.Round(z.Tiempos.RespuestaP90!.Value, 1),
        nombre = m.Zonas.Nombre(z.Sur, z.Oeste), casos = z.Tiempos.Casos,
    }));
}
@if (n == 0)
{
    var acciones = new List<(string, string, bool)>();
    if (m.Periodo != "30") acciones.Add(("Ver los últimos 30 días", m.Enlace(periodo: "30"), true));
    if (v.Prioridad is not null) acciones.Add(("Quitar el filtro de prioridad", Url.Page("/Analitica/Index", new { pregunta = "tiempo", periodo = m.Periodo, desde = m.Periodo == "rango" ? m.Desde : null, hasta = m.Periodo == "rango" ? m.Hasta : null })!, acciones.Count == 0));
    <partial name="_Vacio" model="@(new Vacio($"No hubo SOS{textoPrioridad} atendidos en {m.TextoPeriodo}.",
        "Por eso no hay tiempos que mostrar. Puede ser una buena noticia, o un filtro muy estrecho: prueba con otro periodo.", acciones,
        v.Prioridad is null ? null : "La prioridad se registra desde el 27/10/2026: los SOS anteriores aparecen como «Sin registrar»."))" />
}
else
{
    var dentro = v.Respuestas.Count(r => r <= objetivo);
    <section class="tarjeta-a respuesta@(n >= minimo ? " tiempo-b" : "")" aria-labelledby="respuesta-tiempo" data-respuesta="tiempo" data-casos="@n">
        <div class="respuesta__cabecera">
            @if (n < minimo)
            {
                <h2 class="respuesta__titular" id="respuesta-tiempo">En @m.TextoPeriodo @(n == 1 ? "se midió" : "se midieron") @Formato.Plural(n, "SOS", "SOS")@(textoPrioridad); @dentro @(dentro == 1 ? "se atendió" : "se atendieron") dentro de los @objetivo min.</h2>
                <p class="respuesta__lectura">Se mide desde que el ciudadano emite el SOS hasta que el sereno empieza a atenderlo. Con tan pocos casos, un porcentaje engañaría: la regla muestra cada SOS en su lugar.</p>
            }
            else
            {
                <h2 class="respuesta__titular" id="respuesta-tiempo">La mitad de los SOS@(textoPrioridad) se atendió en <em>@Formato.Minutos(p50)</em>; @Formato.Porcentaje(dentro * 100.0 / n, 0) dentro del objetivo.</h2>
                <p class="respuesta__lectura">
                    Se mide desde que el ciudadano emite el SOS hasta que el sereno empieza a atenderlo. En @m.TextoPeriodo se midieron @Formato.Plural(n, "SOS", "SOS"):
                    cada columna son los que se atendieron en ese minuto, en verde los que entraron en el objetivo provisional y en ocre los que no.
                    @if (anterior?.RespuestaP50 is { } antes)
                    {
                        var dif = p50!.Value - antes;
                        <text>Frente a @m.TextoAnterior (línea punteada: la mitad se atendió en @Formato.Minutos(antes)), @(Math.Abs(dif) < 1 ? "casi igual" : dif < 0 ? $"ahora {Formato.Minutos(-dif)} más rápido" : $"ahora {Formato.Minutos(dif)} más lento").</text>
                    }
                </p>
            }
        </div>
        <div class="respuesta__visual">
            @if (n < minimo)
            {
                @(new Regla
                {
                    Maximo = maximo, Unidad = " min", Paso = maximo > 40 ? 10 : 5,
                    Banda = (0, objetivo, $"Objetivo provisional ≤ {objetivo} min"),
                    Puntos = v.Respuestas.Select(r => (r, (r > maximo ? "→ " : "") + Formato.Minutos(r), r > objetivo)).ToList(),
                }.Dibujar($"Cada SOS medido: {string.Join(", ", v.Respuestas.Select(r => Formato.Minutos(r)))}"))
                <div class="aviso aviso--informacion aviso-a"><partial name="_Icono" model="@("informacion")" /><div><p class="aviso__titulo">Pocos casos para dar porcentajes</p><p class="aviso__texto">Las medianas y los p90 aparecen desde @minimo casos. Para ver tendencias, mira un periodo más largo.</p></div>
                    @if (m.Periodo is "hoy" or "rango") { <a class="boton boton--secundario boton--compacto aviso-a__accion" href="@m.Enlace(periodo: "7")">Ver 7 días</a> }</div>
            }
            else
            {
                <div class="distribucion-a" data-distribucion>
                    <div class="distribucion-a__grafico" role="img" aria-label="Cuántos SOS se atendieron en cada minuto: la mitad en @Formato.Minutos(p50), 9 de cada 10 en @Formato.Minutos(p90) o menos; @dentro de @n dentro del objetivo provisional de @objetivo minutos.">
                        <div class="distribucion-a__objetivo" style="width:@F(X(objetivo))%"><span>Objetivo provisional ≤ @objetivo min</span></div>
                        <ol class="distribucion-a__columnas" aria-hidden="true">
                            @for (var i = 0; i < columnas; i++)
                            {
                                var clase = i == columnas - 1 ? " distribucion-a__columna--borde" : i >= objetivo ? " distribucion-a__columna--fuera" : "";
                                <li class="distribucion-a__columna@(clase)" style="--i:@Math.Min(i, 45)">
                                    <i style="height:@F(conteos[i] / techo * 100)%"></i>
                                    <span class="distribucion-a__globo"><b>@Distribucion.Rango(i, columnas)</b> · @Formato.Plural(conteos[i], "SOS", "SOS")</span>
                                </li>
                            }
                        </ol>
                        @if (conteosAntes is not null)
                        {
                            <svg class="distribucion-a__anterior" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="@Distribucion.Escalonada(conteosAntes, techo)" /></svg>
                        }
                        <span class="distribucion-a__marca@(X(p50) > 78 ? " distribucion-a__marca--izq" : "")" style="left:@F(X(p50))%"><span><b>@Formato.Minutos(p50)</b> · la mitad</span></span>
                        <span class="distribucion-a__marca distribucion-a__marca--p90@(X(p90) > 78 ? " distribucion-a__marca--izq" : "")" style="left:@F(X(p90))%"><span><b>@Formato.Minutos(p90)@(p90 > columnas ? " o más" : "")</b> · 9 de 10</span></span>
                    </div>
                    <div class="distribucion-a__eje" aria-hidden="true">
                        @for (var x = 0; x < columnas; x += 5)
                        {
                            <span style="left:@F(X(x))%">@(x == 0 ? "0 min" : x.ToString())</span>
                        }
                    </div>
                    <ul class="leyenda-a leyenda-distribucion">
                        <li><i class="leyenda-distribucion__dentro"></i>Atendidos dentro del objetivo</li>
                        <li><i class="leyenda-distribucion__fuera"></i>Atendidos después</li>
                        <li><i class="leyenda-distribucion__borde"></i>@(columnas - 1) min o más</li>
                        <li><i class="leyenda-distribucion__mitad"></i>La mitad (mediana) · punteada: 9 de cada 10 (p90)</li>
                        @if (conteosAntes is not null) { <li><i class="leyenda-distribucion__anterior"></i>@(char.ToUpperInvariant(m.TextoAnterior[0]) + m.TextoAnterior[1..])</li> }
                    </ul>
                    <table class="visualmente-oculto">
                        <caption>SOS atendidos por tiempo de respuesta</caption>
                        <thead><tr><th>Tiempo hasta la atención</th><th>SOS</th></tr></thead>
                        <tbody>
                            @for (var x = 0; x < columnas; x += 5)
                            {
                                var hasta = Math.Min(x + 5, columnas);
                                <tr><td>@(hasta == columnas ? $"{x} min o más" : $"{x} a {hasta} min")</td><td>@conteos[x..hasta].Sum()</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (tramos.Count > 0)
                {
                    <div class="carrera-a" data-carrera>
                        <div class="carrera-a__cabecera">
                            <h3 class="carrera-a__titulo">La carrera de un SOS típico</h3>
                            @if (masLargo.Item1 is { } nombreLargo && sumaTramos > 0 && masLargo.Item2 / sumaTramos >= 0.4)
                            {
                                <span class="carrera-a__nota">«@nombreLargo» se lleva @Formato.Porcentaje(masLargo.Item2 / sumaTramos * 100, 0) del recorrido</span>
                            }
                            <span class="carrera-a__reloj" data-reloj aria-hidden="true">@Formato.Minutos(sumaTramos)</span>
                        </div>
                        <div class="carrera-a__pista" aria-hidden="true">
                            @foreach (var (nombre, minutos, color) in tramos)
                            {
                                <span class="carrera-a__tramo" style="flex:@F(Math.Max(minutos, 0.2)) 1 0;--color:@color" data-minutos="@F(minutos)"><i></i></span>
                            }
                            <span class="carrera-a__ficha" data-ficha><partial name="_Icono" model="@("urgente")" /></span>
                        </div>
                        <ol class="carrera-a__etapas">
                            @foreach (var (nombre, minutos, color) in tramos)
                            {
                                <li data-tramo><i style="background:@color"></i>@nombre <b>@Formato.Minutos(minutos)</b></li>
                            }
                        </ol>
                        <p class="carrera-a__pie">Tiempo típico de cada etapa de un SOS (su mediana), a velocidad rápida. No suman exactamente el total de arriba.</p>
                    </div>
                }
            }
        </div>
    </section>

    <div class="rejilla-a rejilla-a--dos">
        <section class="tarjeta-a" aria-labelledby="titulo-zonas">
            <div class="tarjeta-a__cabecera"><h3 id="titulo-zonas">Tiempo de respuesta por zona</h3><span class="tarjeta-a__nota">p90 · 3 o más casos</span></div>
            @if (v.Zonas.Zonas.Count == 0)
            {
                <p class="tarjeta-a__vacia">Ninguna zona llega a 3 casos en el periodo. Para cuidar la privacidad, una zona con menos casos no se muestra sola.</p>
            }
            else
            {
                <div class="mapa-a" id="mapa-zonas" role="region" aria-label="Mapa: p90 de respuesta por zona" tabindex="0"
                     data-teselas="@m.UrlTeselas" data-escala="minutos" data-objetivo="@objetivo"><script type="application/json" data-zonas>@Html.Raw(zonasJson)</script></div>
                <div class="rampa-a" aria-hidden="true"><span>Más rápido</span><i></i><span>Más lento</span></div>
                <table class="visualmente-oculto">
                    <caption>p90 de respuesta por zona</caption>
                    <thead><tr><th>Zona</th><th>Casos</th><th>p90</th></tr></thead>
                    <tbody>@foreach (var z in v.Zonas.Zonas) { <tr><td>@m.Zonas.Nombre(z.Sur, z.Oeste)</td><td>@z.Tiempos.Casos</td><td>@Formato.Minutos(z.Tiempos.RespuestaP90)</td></tr> }</tbody>
                </table>
            }
        </section>
        <section class="tarjeta-a" aria-labelledby="titulo-prioridad">
            <div class="tarjeta-a__cabecera"><h3 id="titulo-prioridad">Tiempo de atención por prioridad</h3><span class="tarjeta-a__nota">tiempo hasta atender el SOS</span></div>
            @if (prioridades.Count == 0)
            {
                <p class="tarjeta-a__vacia">Aún no hay SOS con prioridad en el periodo (se registra al clasificar, desde el 27/10/2026).</p>
            }
            else
            {
                EtapaTiempo? De(string codigo) => prioridades.Where(p => p.Item1 == codigo).Select(p => p.Item2).FirstOrDefault();
                bool Medible(EtapaTiempo? e) => e is { P50Minutos: not null } && e.Casos >= minimo;
                var alta = De(Cad.Contratos.Casos.PrioridadesCaso.Alta);
                var media = De(Cad.Contratos.Casos.PrioridadesCaso.Media);
                <p class="prioridades-a__respuesta" data-comparacion>
                    @if (Medible(alta) && Medible(media))
                    {
                        var dif = media!.P50Minutos!.Value - alta!.P50Minutos!.Value;
                        if (Math.Abs(dif) < 1) { <text>A la mitad de los SOS de prioridad Alta y de prioridad Media se les atendió en unos @Formato.Minutos(alta.P50Minutos) o menos.</text> }
                        else if (dif > 0) { <text>A la mitad de los SOS de prioridad Alta se les atendió en @Formato.Minutos(alta.P50Minutos), @Formato.Minutos(dif) antes que a los de prioridad Media (@Formato.Minutos(media.P50Minutos)).</text> }
                        else { <text>A la mitad de los SOS de prioridad Alta se les atendió en @Formato.Minutos(alta.P50Minutos), @Formato.Minutos(-dif) después que a los de prioridad Media (@Formato.Minutos(media.P50Minutos)).</text> }
                    }
                    else
                    {
                        <text>Faltan casos para comparar: hacen falta al menos @minimo SOS atendidos de prioridad Alta y @minimo de prioridad Media.</text>
                    }
                </p>
                <ul class="leyenda-a leyenda-a--compacta">
                    <li><i class="leyenda-prioridad__dentro"></i>Dentro del objetivo (@objetivo min)</li>
                    <li><i class="leyenda-prioridad__fuera"></i>Después</li>
                    <li><i class="leyenda-prioridad__mitad"></i>La mitad</li>
                </ul>
                <ul class="prioridades-b">
                    @foreach (var (codigo, etapa) in prioridades)
                    {
                        var nombre = codigo == ConsultarTiemposPorEtapa.SinRegistrar ? "Sin registrar" : codigo;
                        var propios = Distribucion.Contar(v.PorPrioridad.GetValueOrDefault(codigo) ?? [], columnas);
                        var alto = Math.Max(1, propios.Max());
                        var medible = etapa.Casos >= minimo && etapa.P50Minutos is not null;
                        <li class="prioridad-b" data-prioridad="@codigo">
                            <span class="prioridad-b__nombre"><b>@nombre</b> <span class="tarjeta-a__nota">· @etapa.Casos</span>
                                @if (medible)
                                {
                                    <span class="prioridad-b__valor"><b>@Formato.Minutos(etapa.P50Minutos)</b> la mitad · <b>@Formato.Minutos(etapa.P90Minutos)</b> 9 de 10</span>
                                }
                                else
                                {
                                    <span class="prioridad-b__valor">@(etapa.Casos == 0 ? "sin atendidos" : $"pocos casos (mín. {minimo})")</span>
                                }
                            </span>
                            <span class="prioridad-b__mini" role="img" aria-label="@nombre: @(medible ? $"la mitad se atendió en {Formato.Minutos(etapa.P50Minutos)} y 9 de cada 10 en {Formato.Minutos(etapa.P90Minutos)} o menos" : Formato.Plural(etapa.Casos, "SOS atendido", "SOS atendidos"))">
                                @for (var i = 0; i < columnas; i++)
                                {
                                    <i class="@(i >= objetivo ? "fuera" : "")" style="height:@F(propios[i] * 100.0 / alto)%;--i:@Math.Min(i, 45)"></i>
                                }
                                @if (medible) { <span class="prioridad-b__mitad" style="left:@F(X(etapa.P50Minutos))%"></span> }
                            </span>
                        </li>
                    }
                </ul>
            }
            <div class="tarjeta-a__cabecera tarjeta-a__cabecera--separada"><h3>SOS sobre el tiempo esperado</h3><span class="tarjeta-a__nota">más tiempo del esperado en su etapa</span></div>
            @if (atascados.Count == 0)
            {
                <p class="tarjeta-a__vacia">Ningún SOS lleva más de lo esperado en su etapa.</p>
            }
            else
            {
                <ul class="filas-a">
                    @foreach (var a in atascados)
                    {
                        <li class="fila-a">
                            <span class="chip chip--urgente">SOS</span>
                            <a href="/panel/central/sos/@a.CasoId">@Cad.Server.Modulos.Casos.Dominio.EstadosCaso.Texto(a.Estado)</a>
                            <span class="fila-a__cifra fila-a__cifra--aviso">@Formato.Minutos(a.Minutos) <small>/ @a.UmbralMinutos min</small></span>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
}
