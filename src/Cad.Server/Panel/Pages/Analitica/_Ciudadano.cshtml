@model (IndexModel M, IndexModel.VistaCiudadano V)
@{
    var (m, v) = Model;
    var e = v.Evaluaciones;
    var minimo = m.Opciones.MinimoParaPercentiles;
    var promedio = e.Evaluados == 0 ? 0 : Ciudadano.Promedio(e);
    var antes = v.Anterior.Evaluados >= minimo ? Ciudadano.Promedio(v.Anterior) : (double?)null;
    var maxNota = Math.Max(1, e.Distribucion.Select(d => d.Evaluaciones).DefaultIfEmpty(0).Max());
    // La nota baja viene de la demora cuando los que calificaron mal esperaron claramente más que los que calificaron bien.
    var porDemora = e.RespuestaP50Bajas is { } b && e.RespuestaP50Altas is { } a && b >= a * 1.3 && b - a >= 3;
    var falloPrincipal = e.MotivosBajas.OrderByDescending(x => x.Veces).FirstOrDefault();
    var conCasos = e.PorTiempoDeRespuesta.Where(t => t.Evaluaciones > 0).ToList();
    var peorTramo = conCasos.OrderByDescending(t => t.PorcentajeBajas).FirstOrDefault();
    var mejorTramo = conCasos.Where(t => t.Evaluaciones >= minimo).OrderBy(t => t.PorcentajeBajas).FirstOrDefault();
    string Pct(double x) => x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    const double Alta = 40; // desde aquí, el tramo va en ocre: casi la mitad o más califica mal
    var cohortes = v.Adopcion.Cohortes.Where(c => c.Registrados > 0).TakeLast(4).ToList();
    var canales = v.Adopcion.Canales.Where(c => c.Reportes > 0).OrderByDescending(c => c.Reportes).ToList();
    var totalCanales = canales.Sum(c => c.Reportes);
    var demora = v.Reportes.DemoraTotal;
    string[] coloresCanal = ["#037F58", "#1DAE7A", "#A6E6C8", "#BCC7D6", "#E1E7EF"];

    // La línea de la espera: un punto por tramo con evaluaciones, en su lugar del eje (los tramos sin casos dejan su hueco).
    var techo = Math.Max(60, Math.Ceiling(conCasos.Select(t => t.PorcentajeBajas).DefaultIfEmpty(0).Max() / 10) * 10 + 10);
    double X(int i) => (i + 0.5) / Math.Max(1, e.PorTiempoDeRespuesta.Count) * 100;
    double Y(double p) => 100 - p / techo * 100;
    var puntosLinea = e.PorTiempoDeRespuesta.Select((t, i) => (t, i)).Where(x => x.t.Evaluaciones > 0).Select(x => $"{Pct(X(x.i) * 10)} {Pct(Y(x.t.PorcentajeBajas) * 10)}").ToList();
    var linea = puntosLinea.Count == 0 ? "" : "M " + string.Join(" L ", puntosLinea);

    // La nube de motivos: más grande, más veces. En tierra los de las notas bajas; en verde, los de las altas.
    var motivos = e.MotivosBajas.Select(x => (x, Baja: true)).Concat(e.MotivosAltas.Select(x => (x, Baja: false))).OrderByDescending(x => x.x.Veces).ToList();
    var maxMotivo = Math.Max(1, motivos.Select(x => x.x.Veces).DefaultIfEmpty(0).Max());
}
<section class="tarjeta-a respuesta valora-b" aria-labelledby="respuesta-ciudadano" data-respuesta="ciudadano" data-evaluados="@e.Evaluados">
    @if (e.Evaluados == 0)
    {
        <div class="respuesta__cabecera">
            <h2 class="respuesta__titular" id="respuesta-ciudadano">Nadie evaluó la atención en @m.TextoPeriodo.</h2>
            <p class="respuesta__lectura">@(e.Cerrados == 0 ? "No se cerró ningún caso en el periodo." : $"Se cerraron {Formato.Plural(e.Cerrados, "caso", "casos")}, pero ninguno tiene evaluación del ciudadano todavía.") Abajo, cómo usan la app y por dónde llegan los reportes.</p>
        </div>
    }
    else
    {
        <div class="respuesta__cabecera">
            <h2 class="respuesta__titular" id="respuesta-ciudadano">Califican la atención con <em>@Formato.Decimal(promedio) de 5</em>@if (e.Evaluados < minimo) {<text>.</text>} else if (porDemora) {<text>; las notas bajas se concentran en las <strong>esperas largas</strong>.</text>} else if (falloPrincipal is not null) {<text>; el motivo más marcado en las notas bajas: «@falloPrincipal.Texto».</text>} else {<text>.</text>}</h2>
            <p class="respuesta__lectura">A la izquierda, la nota y cuántas evaluaciones recibió cada una. A la derecha, de quienes esperaron cada tiempo hasta que empezó la atención, qué parte calificó con nota baja (1 a 3).</p>
        </div>
        <div class="respuesta__visual">
            <div class="valora-b__tablero">
                <div class="valora-b__notas">
                    <div class="nota-b">
                        <b class="nota-b__cifra">@promedio.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("es-PE"))</b>
                        <div>
                            <span class="estrellas-b" role="img" aria-label="@Formato.Decimal(promedio) de 5 estrellas"><span class="estrellas-b__base" aria-hidden="true">★★★★★</span><span class="estrellas-b__llena" aria-hidden="true" style="width:@Pct(promedio / 5 * 100)%">★★★★★</span></span>
                            <small>@Formato.Plural(e.Evaluados, "evaluación", "evaluaciones")@(antes is { } previo ? $" · antes {Formato.Decimal(previo)}" : "")</small>
                        </div>
                    </div>
                    <div class="escalera-b" role="img" aria-label="Evaluaciones por nota: @string.Join(", ", Enumerable.Range(1, 5).Reverse().Select(n => $"{n} estrellas {e.Distribucion.FirstOrDefault(d => d.Puntuacion == n)?.Evaluaciones ?? 0}"))">
                        @for (var nota = 5; nota >= 1; nota--)
                        {
                            var n = e.Distribucion.FirstOrDefault(d => d.Puntuacion == nota)?.Evaluaciones ?? 0;
                            <div class="escalera-b__peldano" style="--i:@(5 - nota)">
                                <span class="escalera-b__estrellas" aria-hidden="true">@(new string('★', nota))</span>
                                <span class="escalera-b__pista" aria-hidden="true"><i class="@(nota <= ConsultarEvaluaciones.UltimaBaja ? "escalera-b--baja" : "")" style="width:@Pct(Math.Max(n * 100.0 / maxNota, n > 0 ? 2 : 0))%"></i></span>
                                <b>@n</b>
                            </div>
                        }
                    </div>
                    <table class="visualmente-oculto">
                        <caption>Evaluaciones por puntuación</caption>
                        <thead><tr><th>Puntuación</th><th>Evaluaciones</th></tr></thead>
                        <tbody>@for (var nota = 1; nota <= 5; nota++) { <tr><td>@nota de 5</td><td>@(e.Distribucion.FirstOrDefault(d => d.Puntuacion == nota)?.Evaluaciones ?? 0)</td></tr> }</tbody>
                    </table>
                    <p class="valora-b__evaluan"><b>@Formato.Porcentaje(e.PorcentajeEvaluados, 0)</b> de los casos cerrados se evaluó (@e.Evaluados de @e.Cerrados). En tierra, las notas bajas (1 a 3).</p>
                </div>
                <div class="valora-b__espera">
                    <h3 class="valora-b__subtitulo">Cuanto más esperan, ¿peor califican?</h3>
                    @if (e.Evaluados < minimo)
                    {
                        <div class="aviso aviso--informacion aviso-a"><partial name="_Icono" model="@("informacion")" />
                            <div><p class="aviso__titulo">Pocas evaluaciones para sacar conclusiones</p><p class="aviso__texto">Con menos de @minimo evaluaciones no se cruza la nota con el tiempo de respuesta: un solo caso movería todo el porcentaje.</p></div>
                        </div>
                    }
                    else
                    {
                        <p class="valora-b__nota">Qué parte puso nota baja, según cuánto esperó hasta que empezó la atención. Huecos: tramos con menos de @minimo evaluaciones.</p>
                        <div class="linea-b" role="img" aria-label="Notas bajas según la espera: @string.Join("; ", e.PorTiempoDeRespuesta.Select(t => t.Evaluaciones == 0 ? $"{t.Tramo}, sin casos" : $"{t.Tramo}, {Formato.Porcentaje(t.PorcentajeBajas, 0)} de {t.Evaluaciones}"))">
                            <span class="linea-b__ejes" aria-hidden="true"></span>
                            @for (var y = 0; y < techo; y += 20)
                            {
                                <span class="linea-b__y" style="top:@Pct(Y(y))%" aria-hidden="true">@y %</span>
                            }
                            @if (linea.Length > 0)
                            {
                                <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                                    <path class="linea-b__area" d="@linea L @puntosLinea[^1].Split(' ')[0] 1000 L @puntosLinea[0].Split(' ')[0] 1000 Z" />
                                    <path class="linea-b__trazo" d="@linea" pathLength="1" />
                                </svg>
                            }
                            @for (var i = 0; i < e.PorTiempoDeRespuesta.Count; i++)
                            {
                                var t = e.PorTiempoDeRespuesta[i];
                                var pocos = t.Evaluaciones > 0 && t.Evaluaciones < minimo;
                                var alta = t.PorcentajeBajas >= Alta;
                                var bajas = (int)Math.Round(t.PorcentajeBajas * t.Evaluaciones / 100.0);
                                if (t.Evaluaciones > 0)
                                {
                                    <span class="linea-b__punto@(alta ? " linea-b--alta" : "")@(pocos ? " linea-b--pocos" : "")" style="left:@Pct(X(i))%;top:@Pct(Y(t.PorcentajeBajas))%;--i:@i" aria-hidden="true"></span>
                                    <span class="linea-b__valor@(alta ? " linea-b--alta" : "")" style="left:@Pct(X(i))%;top:@Pct(Y(t.PorcentajeBajas))%;--i:@i" aria-hidden="true">@Formato.Porcentaje(t.PorcentajeBajas, 0)</span>
                                }
                                <span class="linea-b__tramo" style="left:@Pct(X(i))%" data-tramo="@t.Tramo" data-evaluaciones="@t.Evaluaciones">@t.Tramo<small>@(t.Evaluaciones == 0 ? "sin casos" : $"{bajas} de {t.Evaluaciones}")</small></span>
                            }
                        </div>
                        @if (peorTramo is { PorcentajeBajas: >= 50 })
                        {
                            <p class="valora-b__conclusion"><b>Con @peorTramo.Tramo.ToLowerInvariant(), @Formato.Porcentaje(peorTramo.PorcentajeBajas, 0) califica mal</b>@(mejorTramo is not null && mejorTramo != peorTramo ? $"; con {mejorTramo.Tramo.ToLowerInvariant()}, {Formato.Porcentaje(mejorTramo.PorcentajeBajas, 0)}." : ".")</p>
                        }
                        <p class="valora-b__nota">La espera se cuenta desde que se registró el caso hasta que empezó la atención.</p>
                    }
                </div>
            </div>
        </div>
    }
</section>

<div class="rejilla-a rejilla-a--tres">
    <section class="tarjeta-a" aria-labelledby="titulo-motivos">
        <div class="tarjeta-a__cabecera"><h3 id="titulo-motivos">Lo que marcan al calificar</h3><span class="tarjeta-a__nota">puede marcar varios</span></div>
        @if (motivos.Count == 0)
        {
            <p class="tarjeta-a__vacia">Sin motivos marcados en el periodo. Los motivos se registran desde el 27/10/2026.</p>
        }
        else
        {
            <p class="tarjeta-a__nota tarjeta-a__nota--bloque">Más grande, más veces. En tierra, los de las notas bajas; en verde, los de las altas.</p>
            <ul class="nube-b">
                @for (var i = 0; i < motivos.Count; i++)
                {
                    var (x, baja) = motivos[i];
                    <li class="@(baja ? "nube-b--baja" : "nube-b--alta")" data-motivo="@x.Codigo" style="font-size:@Pct(0.75 + x.Veces / (double)maxMotivo * 0.55)rem;--i:@i">@(baja ? "▲ " : "✓ ")@x.Texto <b>@x.Veces</b></li>
                }
            </ul>
        }
    </section>
    <section class="tarjeta-a" aria-labelledby="titulo-vuelven">
        <div class="tarjeta-a__cabecera"><h3 id="titulo-vuelven">Uso recurrente de la app</h3><span class="tarjeta-a__nota">por semana de registro</span></div>
        @if (cohortes.Count == 0)
        {
            <p class="tarjeta-a__vacia">Nadie se registró en la app en el periodo.</p>
        }
        else
        {
            <div class="tabla-a__desplazable">
            <table class="tabla-a tabla-a--cohortes">
                <thead><tr><th scope="col">Registrados la semana del</th><th scope="col" class="tabla-a__num">Personas</th><th scope="col" class="tabla-a__num">La usaron</th><th scope="col" class="tabla-a__num">Volvieron</th></tr></thead>
                <tbody>
                    @foreach (var c in cohortes)
                    {
                        var usaron = 100.0 * c.UsaronAlgunaVez / c.Registrados;
                        var volvieron = 100.0 * c.VolvieronOtraSemana / c.Registrados;
                        <tr data-cohorte="@c.Semana.ToString("yyyy-MM-dd")">
                            <th scope="row">@c.Semana.ToString("d MMM", new System.Globalization.CultureInfo("es-PE"))</th>
                            <td class="tabla-a__num">@c.Registrados</td>
                            <td class="tabla-a__num celda-a @(usaron > 55 ? "celda-a--oscura" : "")" style="--intensidad:@Pct(usaron / 100)">@Formato.Porcentaje(usaron, 0)</td>
                            <td class="tabla-a__num celda-a @(volvieron > 55 ? "celda-a--oscura" : "")" style="--intensidad:@Pct(volvieron / 100)">@Formato.Porcentaje(volvieron, 0)</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <p class="tarjeta-a__nota tarjeta-a__nota--bloque">«La usaron»: abrieron la app algún día tras registrarse. «Volvieron»: la usaron en otra semana distinta a la de su registro. Más oscuro, más gente. La semana en curso aún no puede tener «volvieron».</p>
        }
    </section>
    <section class="tarjeta-a" aria-labelledby="titulo-canales">
        <div class="tarjeta-a__cabecera"><h3 id="titulo-canales">Por dónde llegan los reportes</h3><span class="tarjeta-a__nota">@Formato.Plural(totalCanales, "reporte", "reportes") en el periodo</span></div>
        @if (totalCanales == 0)
        {
            <p class="tarjeta-a__vacia">Sin reportes con canal registrado en el periodo (el canal se registra desde el 27/10/2026).</p>
        }
        else
        {
            <div class="canales-b" role="img" aria-label="@string.Join(", ", canales.Select(c => $"{c.Texto}: {c.Reportes}"))">
                @for (var i = 0; i < canales.Count; i++)
                {
                    <i style="flex:@canales[i].Reportes 1 0;background:@coloresCanal[Math.Min(i, coloresCanal.Length - 1)];--i:@i"></i>
                }
            </div>
            <ul class="canales-b__lista">
                @for (var i = 0; i < canales.Count; i++)
                {
                    <li data-canal="@canales[i].Texto"><i style="background:@coloresCanal[Math.Min(i, coloresCanal.Length - 1)]"></i>@canales[i].Texto<b>@canales[i].Reportes</b><small>@Formato.Porcentaje(canales[i].Reportes * 100.0 / totalCanales, 0)</small></li>
                }
            </ul>
        }
        <ul class="filas-a">
            <li class="fila-a fila-a--dos"><span>Tiempo entre el hecho y el reporte (la mitad llega antes de)</span><span class="fila-a__cifra">@Formato.Horas(demora.HorasP50)</span></li>
            <li class="fila-a fila-a--dos"><span>Reportes enviados en la primera hora del hecho</span><span class="fila-a__cifra">@(demora.Reportes == 0 ? "—" : Formato.Porcentaje(demora.PorcentajeEnLaPrimeraHora, 0))</span></li>
        </ul>
    </section>
</div>
