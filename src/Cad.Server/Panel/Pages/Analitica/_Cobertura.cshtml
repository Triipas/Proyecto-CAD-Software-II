@model (IndexModel M, IndexModel.VistaCobertura V)
@using System.Globalization
@{
    var (m, v) = Model;
    var c = v.Cobertura;
    var minimo = m.Opciones.MinimoCasosPorZona;
    var tablero = TableroZonas.Armar(c.ZonasBloques ?? []);
    var radio = Formato.Decimal(c.RadioMetros, 0);
    string F(double x) => x.ToString("0.##", CultureInfo.InvariantCulture);
    // Las coordenadas del encuadre, sin redondear: 0,005° ya es una fila entera de zonas y el mapa quedaría corrido.
    string G(double x) => x.ToString("R", CultureInfo.InvariantCulture);
    string Pct(double x) => Formato.Porcentaje(x, 0);
    string Casos(int n) => n >= minimo ? Formato.Plural(n, "incidencia", "incidencias") : $"menos de {minimo} incidencias";

    // La peor franja del día: donde más casos entran por cada sereno libre.
    var horas = v.Demanda.PorHora;
    var maxCasos = Math.Max(0.01, horas.Max(h => h.CasosPorDia));
    var maxSerenos = Math.Max(0.01, horas.Max(h => h.SerenosDisponibles));
    var brecha = horas.Where(h => h.CasosPorDia > 0).OrderByDescending(h => h.CasosPorDia / Math.Max(h.SerenosDisponibles, 0.5)).FirstOrDefault();
    var franja = brecha is null ? new HashSet<int>() : horas.Where(h => Math.Abs(h.Hora - brecha.Hora) <= 2 && h.CasosPorDia >= brecha.CasosPorDia * 0.6).Select(h => h.Hora).ToHashSet();
    string Altura(double valor, double maximo) => Math.Max(valor / maximo * 100, valor > 0 ? 4 : 2).ToString("0.#", CultureInfo.InvariantCulture);

    // Los filtros del tablero: todos los bloques o uno. Cada uno con su titular y sus zonas menos cubiertas.
    var filtros = new List<(string Clave, string? Nombre, IReadOnlyList<CeldaTablero> Celdas)> { ("todos", null, tablero.Celdas) };
    filtros.AddRange(tablero.Bloques.Select(b => (b.Bloque.Clave, (string?)b.Bloque.Nombre, (IReadOnlyList<CeldaTablero>)tablero.Celdas.Where(x => x.Bloque == b.Bloque).ToList())));

    // Las zonas con incidencias que quedan fuera de los bloques (el tablero es el distrito): se cuentan aparte.
    var deBloques = tablero.Celdas.Select(x => Zona.De(x.Datos.Sur + 1e-7, x.Datos.Oeste + 1e-7)).ToHashSet();
    var fuera = c.Zonas.Where(z => !deBloques.Contains(Zona.De(z.Sur + 1e-7, z.Oeste + 1e-7))).ToList();

    // Los serenos con posición ahora, en su lugar del tablero (la misma proyección del mapa de fondo).
    static double Y(double latitud) => Math.Log(Math.Tan(Math.PI / 4 + latitud * Math.PI / 360));
    var serenos = v.Serenos.Where(s => s.Operativo && s.Latitud is { } la && s.Longitud is { } lo
            && la >= tablero.Sur && la <= tablero.Norte && lo >= tablero.Oeste && lo <= tablero.Este)
        .Select(s => (Libre: s.Disponible, X: (s.Longitud!.Value - tablero.Oeste) / (tablero.Este - tablero.Oeste) * 100,
            Y: (Y(tablero.Norte) - Y(s.Latitud!.Value)) / (Y(tablero.Norte) - Y(tablero.Sur)) * 100))
        .ToList();
}
@if (tablero.Celdas.Count == 0 || c.Muestras == 0 || (c.Zonas.Count == 0 && c.ZonasAgrupadas == 0))
{
    <partial name="_Vacio" model="@(new Vacio($"No hubo incidencias con ubicación en {m.TextoPeriodo}.", "La cobertura se mide en las zonas donde ocurren las incidencias. Prueba con un periodo más largo.",
        m.Periodo == "30" ? [] : [("Ver los últimos 30 días", m.Enlace(periodo: "30"), true)]))" />
}
else
{
    <section class="tarjeta-a respuesta cobertura-b" aria-labelledby="respuesta-cobertura" data-respuesta="cobertura" data-cobertura data-filtro="todos">
        <div class="respuesta__cabecera">
            <h2 class="respuesta__titular" id="respuesta-cobertura">
                @foreach (var (clave, nombre, celdas) in filtros)
                {
                    var bajas = celdas.Count(x => x.Baja);
                    var donde = nombre is null ? "" : $" del bloque {nombre}";
                    <span data-bloque="@clave" hidden="@(clave != "todos")">
                        @if (bajas == 0)
                        {
                            <text>@(nombre is null ? $"Las {celdas.Count} zonas de los bloques" : $"Las {celdas.Count} zonas{donde}") tuvieron un sereno cerca <em>la mayor parte del tiempo</em>.</text>
                        }
                        else
                        {
                            <text><em>@(bajas == 1 ? "Una zona" : $"{bajas} zonas")</em>@donde @(bajas == 1 ? "pasa" : "pasan") más de la mitad del tiempo sin un sereno cerca.</text>
                        }
                    </span>
                }
            </h2>
            <p class="respuesta__lectura">Cada cuadro es una zona del distrito, en su lugar del plano y con el borde de su bloque. Cuenta como cubierta cuando hubo un sereno libre a @radio m o menos de su centro: más brillante, más tiempo cubierta; en ocre y con ▲, las que pasan más de la mitad del tiempo sin uno. El punto blanco es la comisaría o el puesto de cada bloque (ubicación aproximada).</p>
            @* Sin JavaScript los filtros no sirven: quedan ocultos y se ve todo el distrito. *@
            <div class="cobertura-b__chips" role="group" aria-label="Bloque" data-chips hidden>
                <button type="button" aria-pressed="true" data-ver="todos"><i style="background:#D5E0F0"></i>Todos</button>
                @foreach (var b in tablero.Bloques)
                {
                    <button type="button" aria-pressed="false" data-ver="@b.Bloque.Clave"><i style="background:@TableroZonas.Colores[b.Bloque.Clave]"></i>@b.Bloque.Nombre</button>
                }
            </div>
        </div>
        <div class="respuesta__visual">
            <div class="cobertura-b__cuerpo">
                <div class="cobertura-b__plano">
                    <div class="tablero-b" data-tablero style="aspect-ratio:@tablero.ProporcionCss;--columnas:@tablero.Columnas;--filas:@tablero.Filas"
                         data-teselas="@m.UrlTeselas" data-sur="@G(tablero.Sur)" data-oeste="@G(tablero.Oeste)" data-norte="@G(tablero.Norte)" data-este="@G(tablero.Este)">
                        <div class="tablero-b__mapa" data-mapa aria-hidden="true"></div>
                        <span class="tablero-b__velo" aria-hidden="true"></span>
                        @* La capa de zonas y serenos: sin JavaScript cubre el tablero; con el mapa, va dentro de él y se mueve con él. *@
                        <div class="tablero-b__capa" data-capa>
                            <div class="tablero-b__celdas" role="group" aria-label="Tablero de @tablero.Celdas.Count zonas: @tablero.Celdas.Count(x => x.Baja) pasan más de la mitad del tiempo sin un sereno cerca">
                                @foreach (var x in tablero.Celdas)
                                {
                                    var pct = x.Datos.PorcentajeCubierto;
                                    var color = TableroZonas.Colores[x.Bloque.Clave];
                                    var fondo = x.Baja ? "rgb(245 181 68 / 0.88)" : $"rgb(69 227 164 / {F(0.14 + Math.Clamp((pct - 50) / 50, 0, 1) * 0.52)})";
                                    var bordes = new List<string>();
                                    if (x.Norte) bordes.Add($"0 -2px 0 0 {color}");
                                    if (x.Sur) bordes.Add($"0 2px 0 0 {color}");
                                    if (x.Oeste) bordes.Add($"-2px 0 0 0 {color}");
                                    if (x.Este) bordes.Add($"2px 0 0 0 {color}");
                                    var descripcion = $"Zona {x.Nombre}, bloque {x.Bloque.Nombre}: {Pct(pct)} del tiempo cubierta{(x.Baja ? " (menos de la mitad)" : "")}, {Casos(x.Datos.Casos)}";
                                    <button type="button" class="celda-b@(x.Baja ? " celda-b--baja" : "")" data-bloque="@x.Bloque.Clave" aria-label="@descripcion"
                                            style="grid-column:@(x.Columna + 1);grid-row:@(x.Fila + 1);background:@fondo;box-shadow:@(bordes.Count == 0 ? "none" : string.Join(", ", bordes));--d:@F(x.Distancia);--b:@tablero.Bloques.ToList().FindIndex(b => b.Bloque == x.Bloque)"
                                            data-nombre="@x.Nombre" data-bloque-nombre="@x.Bloque.Nombre" data-cubierta="@Pct(pct) del tiempo cubierta" data-casos="@Casos(x.Datos.Casos)" data-horas="@Formato.Horas(x.Datos.HorasSinCobertura) sin un sereno cerca">
                                        <span aria-hidden="true">@(x.Baja ? "▲" : "")@x.Nombre</span>
                                        @if (x.Base) { <i class="celda-b__base" aria-hidden="true"></i> }
                                    </button>
                                }
                            </div>
                            @foreach (var s in serenos)
                            {
                                <span class="tablero-b__sereno@(s.Libre ? "" : " tablero-b__sereno--ocupado")" style="left:@F(s.X)%;top:@F(s.Y)%" aria-hidden="true"></span>
                            }
                        </div>
                        <div class="tablero-b__globo" data-globo hidden aria-hidden="true"></div>
                    </div>
                    <div class="cobertura-b__rampa" aria-hidden="true"><span>Menos cubierta</span><i></i><span>Más cubierta</span></div>
                    <p class="cobertura-b__atribucion">Mapa: © colaboradores de OpenStreetMap</p>
                </div>
                <div class="cobertura-b__bloques">
                    @for (var i = 0; i < tablero.Bloques.Count; i++)
                    {
                        var b = tablero.Bloques[i];
                        <button type="button" class="bloque-b" data-ver="@b.Bloque.Clave" style="--color:@TableroZonas.Colores[b.Bloque.Clave];--i:@i" aria-label="Ver solo el bloque @b.Bloque.Nombre: @Pct(b.Porcentaje) del tiempo cubierto en promedio, @Formato.Plural(b.Bajas, "zona", "zonas") con poca cobertura">
                            <span class="bloque-b__sello" aria-hidden="true"></span>
                            <span class="bloque-b__nombre"><b>@b.Bloque.Nombre</b> <small>· @b.Zonas zonas</small></span>
                            <span class="bloque-b__cifra">@Pct(b.Porcentaje)<small class="@(b.Bajas > 0 ? "bloque-b__aviso" : "")">@(b.Bajas > 0 ? $"▲ {Formato.Plural(b.Bajas, "zona", "zonas")} con poca" : "✓ todas cubiertas")</small></span>
                            <span class="bloque-b__barra" aria-hidden="true"><i style="width:@F(b.Porcentaje)%"></i></span>
                        </button>
                    }
                    <p class="cobertura-b__total">En todo el distrito hubo al menos un sereno libre y ubicado el <b>@Pct(c.PorcentajeConAlguno)</b> del tiempo@(brecha is null ? "." : "; ")@if (brecha is not null) {<text>la franja con menor cobertura es de <b>@franja.Min() a @(franja.Max() + 1) h</b>.</text>}</p>
                    <p class="cobertura-b__nota">El porcentaje de cada bloque es el promedio de sus zonas.</p>
                </div>
            </div>
            <ul class="cobertura-b__leyenda">
                <li><i style="background:#45E3A4"></i>Cubierta casi siempre</li>
                <li><i style="background:rgb(69 227 164 / 0.3)"></i>Cubierta a ratos</li>
                <li><i style="background:#F5B544"></i>▲ Menos de la mitad del tiempo cubierta</li>
                <li><i class="cobertura-b__muestra-borde"></i>Borde: el bloque de la zona</li>
                @if (serenos.Count > 0)
                {
                    <li><i class="cobertura-b__muestra-sereno"></i>Serenos libres ahora</li>
                    <li><i class="cobertura-b__muestra-sereno cobertura-b__muestra-sereno--ocupado"></i>Con caso</li>
                }
            </ul>
            <table class="visualmente-oculto">
                <caption>Tiempo cubierto por zona</caption>
                <thead><tr><th>Zona</th><th>Bloque</th><th>Tiempo cubierto</th><th>Incidencias</th></tr></thead>
                <tbody>@foreach (var x in tablero.Celdas.OrderBy(x => x.Datos.PorcentajeCubierto)) { <tr><td>@x.Nombre</td><td>@x.Bloque.Nombre</td><td>@Pct(x.Datos.PorcentajeCubierto)</td><td>@Casos(x.Datos.Casos)</td></tr> }</tbody>
            </table>
        </div>
    </section>

    <div class="rejilla-a rejilla-a--dos cobertura-b__abajo">
        <section class="tarjeta-a" aria-labelledby="titulo-turnos">
            <h3 id="titulo-turnos">Turnos y demanda</h3>
            @if (brecha is not null)
            {
                var enFranja = horas.Where(h => franja.Contains(h.Hora)).ToList();
                <p class="horas-a__conclusion" data-franja><b>La hora de más presión es de @franja.Min() a @(franja.Max() + 1) h</b>: entran @Formato.Decimal(enFranja.Average(h => h.CasosPorDia)) casos por hora y quedan @Formato.Decimal(enFranja.Average(h => h.SerenosDisponibles)) serenos libres en promedio.</p>
            }
            else
            {
                <p class="horas-a__conclusion">No entraron casos con hora en @m.TextoPeriodo.</p>
            }
            <p class="tarjeta-a__nota tarjeta-a__nota--bloque">Promedio por hora del día en @m.TextoPeriodo. Cada gráfico tiene su propia escala: compara la forma, no la altura entre uno y otro.</p>
            <div class="horas-a" aria-hidden="true">
                <span class="horas-a__rotulo">Casos que entran<small>hasta @Formato.Decimal(maxCasos) por hora</small></span>
                <div class="horas-a__barras">@foreach (var h in horas) { <span class="@(franja.Contains(h.Hora) ? "horas-a__casos horas-a__casos--franja" : "horas-a__casos")" style="height:@Altura(h.CasosPorDia, maxCasos)%" title="@h.Hora h: @Formato.Decimal(h.CasosPorDia) casos"></span> }</div>
                <span class="horas-a__rotulo">Serenos libres<small>hasta @Formato.Decimal(maxSerenos)</small></span>
                <div class="horas-a__barras horas-a__barras--bajas">@foreach (var h in horas) { <span class="@(franja.Contains(h.Hora) ? "horas-a__serenos horas-a__serenos--franja" : "horas-a__serenos")" style="height:@Altura(h.SerenosDisponibles, maxSerenos)%" title="@h.Hora h: @Formato.Decimal(h.SerenosDisponibles) serenos libres"></span> }</div>
                <span></span><div class="horas-a__eje"><span>0 h</span><span>6</span><span>12</span><span>18</span><span>23 h</span></div>
            </div>
            @if (brecha is not null)
            {
                <ul class="leyenda-a">
                    <li><i class="leyenda-a__prio-nueve"></i>Casos por hora</li>
                    <li><i class="leyenda-a__sereno-libre-claro"></i>Serenos libres</li>
                    <li><i class="leyenda-a__prio-mitad"></i>Más oscuro: la hora de más presión (más casos por sereno libre)</li>
                </ul>
            }
            <table class="visualmente-oculto">
                <caption>Casos y serenos libres por hora</caption>
                <thead><tr><th>Hora</th><th>Casos por día</th><th>Serenos operativos</th><th>Serenos libres</th></tr></thead>
                <tbody>@foreach (var h in horas) { <tr><td>@h.Hora h</td><td>@Formato.Decimal(h.CasosPorDia)</td><td>@Formato.Decimal(h.SerenosOperativos)</td><td>@Formato.Decimal(h.SerenosDisponibles)</td></tr> }</tbody>
            </table>
        </section>
        <section class="tarjeta-a tarjeta-a--llena" aria-labelledby="titulo-zonas-cobertura" data-cobertura-tabla>
            <h3 id="titulo-zonas-cobertura">Zonas con menos cobertura</h3>
            <p class="tarjeta-a__nota tarjeta-a__nota--bloque">Las 6 zonas donde más tiempo no hubo un sereno libre cerca en @m.TextoPeriodo.</p>
            <table class="tabla-a">
                <thead><tr><th scope="col">Zona</th><th scope="col">Tiempo cubierto</th><th scope="col" class="tabla-a__num">Incidencias</th><th scope="col" class="tabla-a__num">Tiempo sin sereno cerca</th></tr></thead>
                @foreach (var (clave, nombre, celdas) in filtros)
                {
                    <tbody data-bloque="@clave" hidden="@(clave != "todos")">
                        @foreach (var x in celdas.OrderBy(x => x.Datos.PorcentajeCubierto).ThenByDescending(x => x.Datos.Casos).Take(6))
                        {
                            var pct = x.Datos.PorcentajeCubierto;
                            <tr data-zona="@x.Nombre">
                                <td><span class="sello-b" style="background:@TableroZonas.Colores[x.Bloque.Clave]" aria-hidden="true"></span>@x.Nombre <span class="zona-b__bloque">@x.Bloque.Nombre</span></td>
                                <td class="zona-b__cubierta"><span class="@(x.Baja ? "medidor-a medidor-a--alerta" : "medidor-a")" aria-hidden="true"><i style="width:@(Math.Round(pct))%"></i></span>@(x.Baja ? "▲ " : "")@Pct(pct)@if (x.Baja) {<span class="visualmente-oculto"> (menos de la mitad)</span>}</td>
                                <td class="tabla-a__num">@(x.Datos.Casos >= minimo ? x.Datos.Casos.ToString() : $"< {minimo}")</td>
                                <td class="tabla-a__num">@Formato.Horas(x.Datos.HorasSinCobertura)</td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
            <p class="tarjeta-a__nota tarjeta-a__nota--bloque">Una zona con menos de @minimo incidencias muestra «&lt; @minimo» para no identificar a nadie.@(fuera.Count == 0 ? "" : $" Fuera de los bloques hubo {Formato.Plural(fuera.Count, "zona", "zonas")} con {minimo} o más incidencias; {fuera.Count(z => z.PorcentajeCubierto < TableroZonas.Mitad)} con menos de la mitad del tiempo cubierta.")</p>
        </section>
    </div>
}
