@model (IndexModel M, IndexModel.VistaCobertura V)
@using System.Text.Json
@{
    var (m, v) = Model;
    var c = v.Cobertura;
    var sinCubrir = c.Zonas.Where(z => z.PorcentajeCubierto < 50).ToList();
    var zonasJson = JsonSerializer.Serialize(c.Zonas.Select(z => new
    {
        sur = z.Sur, oeste = z.Oeste, norte = z.Norte, este = z.Este, valor = Math.Round(z.PorcentajeCubierto), nombre = m.Zonas.Nombre(z.Sur, z.Oeste),
        casos = z.Casos, alerta = z.PorcentajeCubierto < 50,
    }));
    var serenosJson = JsonSerializer.Serialize(v.Serenos.Where(s => s.Operativo && s.Latitud is not null).Select(s => new { lat = s.Latitud, lon = s.Longitud, disponible = s.Disponible }));
    // La peor franja del día: donde más casos entran por cada sereno libre.
    var horas = v.Demanda.PorHora;
    var maxCasos = Math.Max(0.01, horas.Max(h => h.CasosPorDia));
    var maxSerenos = Math.Max(0.01, horas.Max(h => h.SerenosDisponibles));
    var brecha = horas.Where(h => h.CasosPorDia > 0).OrderByDescending(h => h.CasosPorDia / Math.Max(h.SerenosDisponibles, 0.5)).FirstOrDefault();
    var franja = brecha is null ? new HashSet<int>() : horas.Where(h => Math.Abs(h.Hora - brecha.Hora) <= 2 && h.CasosPorDia >= brecha.CasosPorDia * 0.6).Select(h => h.Hora).ToHashSet();
    string Altura(double valor, double maximo) => Math.Max(valor / maximo * 100, valor > 0 ? 4 : 2).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    var radio = Formato.Decimal(c.RadioMetros, 0);
}
@if (c.Zonas.Count == 0 && c.ZonasAgrupadas == 0)
{
    <partial name="_Vacio" model="@(new Vacio($"No hubo incidencias con ubicación en {m.TextoPeriodo}.", "La cobertura se mide en las zonas donde ocurren las incidencias. Prueba con un periodo más largo.",
        m.Periodo == "30" ? [] : [("Ver los últimos 30 días", m.Enlace(periodo: "30"), true)]))" />
}
else
{
    <div class="cobertura-a">
        <section class="tarjeta-a mapa-protagonista" aria-label="Mapa de cobertura">
            @if (c.Zonas.Count > 0)
            {
                <div class="mapa-a mapa-a--grande" id="mapa-zonas" role="region" aria-label="Mapa: porcentaje del tiempo con un sereno cerca, por zona" tabindex="0"
                     data-teselas="@m.UrlTeselas" data-escala="cobertura"><script type="application/json" data-zonas>@Html.Raw(zonasJson)</script><script type="application/json" data-serenos>@Html.Raw(serenosJson)</script></div>
            }
            <div class="@(c.Zonas.Count == 0 ? "respuesta" : "respuesta flotante-a")" data-respuesta="cobertura">
                @if (c.Zonas.Count == 0)
                {
                    <h2 class="respuesta__titular" id="respuesta-cobertura">Hubo un sereno disponible y ubicado <em>el @Formato.Porcentaje(c.PorcentajeConAlguno, 0) del tiempo</em>.</h2>
                }
                else if (sinCubrir.Count == 0)
                {
                    <h2 class="respuesta__titular" id="respuesta-cobertura">Todas las zonas con incidencias tuvieron <em>un sereno cerca</em> la mayor parte del tiempo.</h2>
                }
                else
                {
                    <h2 class="respuesta__titular" id="respuesta-cobertura">@(sinCubrir.Count == 1 ? "Una zona pasa" : $"{sinCubrir.Count} zonas pasan") más de la mitad del tiempo <em>sin un sereno cerca</em>.</h2>
                }
                @if (c.Zonas.Count == 0)
                {
                    <p class="respuesta__lectura">Ninguna zona llega a 3 incidencias en el periodo: para cuidar la privacidad, una zona con menos casos no se muestra sola.@(brecha is null ? "" : $" La peor franja es de {franja.Min()} a {franja.Max() + 1} h.")</p>
                }
                else
                {
                    <p class="respuesta__lectura">Hubo al menos un sereno disponible y ubicado el @Formato.Porcentaje(c.PorcentajeConAlguno, 0) del tiempo@(brecha is null ? "." : $"; la peor franja es de {franja.Min()} a {franja.Max() + 1} h.")</p>
                }
            </div>
            @if (c.Zonas.Count > 0)
            {
                <div class="leyenda-mapa-a">
                    <span>% del tiempo con un sereno disponible a @radio m o menos</span>
                    <div class="rampa-a rampa-a--cobertura" aria-hidden="true"><span>0</span><i></i><span>100 %</span></div>
                    <span><i class="leyenda-a__rayado"></i>Menos de la mitad del tiempo</span>
                    <span><i class="leyenda-a__sereno-libre"></i>Serenos ahora</span>
                </div>
            }
        </section>
        <div class="cobertura-a__lado">
            <section class="tarjeta-a" aria-labelledby="titulo-turnos">
                <h3 id="titulo-turnos">¿Los turnos acompañan a la demanda?</h3>
                <p class="tarjeta-a__nota tarjeta-a__nota--bloque">Promedio por hora del día en @m.TextoPeriodo. Misma hora, dos escalas separadas.</p>
                <div class="horas-a" aria-hidden="true">
                    <span class="horas-a__rotulo">Casos por hora</span>
                    <div class="horas-a__barras">@foreach (var h in horas) { <span class="@(franja.Contains(h.Hora) ? "horas-a__casos horas-a__casos--franja" : "horas-a__casos")" style="height:@Altura(h.CasosPorDia, maxCasos)%" title="@h.Hora h: @Formato.Decimal(h.CasosPorDia) casos"></span> }</div>
                    <span class="horas-a__rotulo">Serenos libres</span>
                    <div class="horas-a__barras horas-a__barras--bajas">@foreach (var h in horas) { <span class="@(franja.Contains(h.Hora) ? "horas-a__serenos horas-a__serenos--franja" : "horas-a__serenos")" style="height:@Altura(h.SerenosDisponibles, maxSerenos)%" title="@h.Hora h: @Formato.Decimal(h.SerenosDisponibles) serenos libres"></span> }</div>
                    <span></span><div class="horas-a__eje"><span>0 h</span><span>6</span><span>12</span><span>18</span><span>23 h</span></div>
                </div>
                <table class="visualmente-oculto">
                    <caption>Casos y serenos libres por hora</caption>
                    <thead><tr><th>Hora</th><th>Casos por día</th><th>Serenos operativos</th><th>Serenos libres</th></tr></thead>
                    <tbody>@foreach (var h in horas) { <tr><td>@h.Hora h</td><td>@Formato.Decimal(h.CasosPorDia)</td><td>@Formato.Decimal(h.SerenosOperativos)</td><td>@Formato.Decimal(h.SerenosDisponibles)</td></tr> }</tbody>
                </table>
                @if (brecha is not null)
                {
                    var enFranja = horas.Where(h => franja.Contains(h.Hora)).ToList();
                    <p class="horas-a__conclusion"><b>De @franja.Min() a @(franja.Max() + 1) h</b> entran @Formato.Decimal(enFranja.Average(h => h.CasosPorDia)) casos por hora y quedan @Formato.Decimal(enFranja.Average(h => h.SerenosDisponibles)) serenos libres en promedio.</p>
                }
            </section>
            <section class="tarjeta-a" aria-labelledby="titulo-zonas-cobertura">
                <h3 id="titulo-zonas-cobertura">Zonas con menos cobertura</h3>
                @if (c.Zonas.Count == 0)
                {
                    <p class="tarjeta-a__vacia">Sin zonas con 3 o más incidencias.</p>
                }
                else
                {
                    <table class="tabla-a">
                        <thead><tr><th scope="col">Zona</th><th scope="col">Cubierta</th><th scope="col" class="tabla-a__num">Casos</th><th scope="col" class="tabla-a__num">Sin cobertura</th></tr></thead>
                        <tbody>
                            @foreach (var z in c.Zonas.Take(6))
                            {
                                <tr data-zona="@m.Zonas.Nombre(z.Sur, z.Oeste)">
                                    <td>@m.Zonas.Nombre(z.Sur, z.Oeste)</td>
                                    <td><span class="medidor-a" aria-hidden="true"><i style="width:@(Math.Round(z.PorcentajeCubierto))%"></i></span>@Formato.Porcentaje(z.PorcentajeCubierto, 0)@if (z.PorcentajeCubierto < 50) {<span class="visualmente-oculto"> (menos de la mitad)</span>}</td>
                                    <td class="tabla-a__num">@z.Casos</td>
                                    <td class="tabla-a__num">@Formato.Horas(z.HorasSinCobertura)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (c.ZonasAgrupadas > 0)
                {
                    <p class="tarjeta-a__nota tarjeta-a__nota--bloque">@Formato.Plural(c.ZonasAgrupadas, "zona", "zonas") con menos de 3 casos (@c.CasosAgrupados en total): agrupadas para no identificar a nadie.</p>
                }
            </section>
        </div>
    </div>
}
