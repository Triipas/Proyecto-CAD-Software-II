@page "/panel/admin/cuentas"
@model Cad.Server.Panel.Pages.Admin.Cuentas.IndexModel
@{
    ViewData["Title"] = "Cuentas institucionales";
}
@section Estilos {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
<div class="pagina__encabezado">
    <div>
        <h1 class="titulo">Cuentas institucionales</h1>
        <p class="texto-secundario">Operadores de central y serenos.</p>
    </div>
    <a class="boton boton--principal" href="/panel/admin/cuentas/nueva"><partial name="_Icono" model="@("asignado")" />Nueva cuenta</a>
</div>

@if (Model.Mensaje is not null)
{
    <div class="aviso aviso--exito" role="status" tabindex="-1" data-enfocar>
        <partial name="_Icono" model="@("exito")" />
        <div>
            <p class="aviso__titulo">Cambios guardados</p>
            <p class="aviso__texto">@Model.Mensaje</p>
        </div>
    </div>
}

@if (Model.Cuentas.Count == 0)
{
    <section class="superficie estado-vacio">
        <partial name="_Icono" model="@("escudo")" />
        <p class="aviso__titulo">Aún no hay cuentas institucionales</p>
        <p>Crea la primera cuenta de operador o de sereno.</p>
        <a class="boton boton--secundario" href="/panel/admin/cuentas/nueva">Nueva cuenta</a>
    </section>
}
else
{
    <partial name="_TablaCuentas" model="Model.Cuentas" />
}
