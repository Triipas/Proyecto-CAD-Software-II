@page "/panel/admin/cuentas"
@model Cad.Server.Panel.Pages.Admin.Cuentas.IndexModel
@{
    ViewData["Title"] = "Cuentas institucionales";
}
@section Estilos {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
<div class="pagina__encabezado">
    <div>
        <h1 class="titulo">Cuentas institucionales</h1>
        <p class="texto-secundario">Operadores de central y serenos.</p>
    </div>
    <a class="boton boton--principal" href="/panel/admin/cuentas/nueva"><partial name="_Icono" model="@("asignado")" />Nueva cuenta</a>
</div>

@if (Model.Mensaje is not null)
{
    <div class="aviso aviso--exito" role="status" tabindex="-1" data-enfocar>
        <partial name="_Icono" model="@("exito")" />
        <div>
            <p class="aviso__titulo">Cambios guardados</p>
            <p class="aviso__texto">@Model.Mensaje</p>
        </div>
    </div>
}

@if (Model.Total > 0)
{
    @* Búsqueda por código, nombre, correo o DNI completo, y filtro por rol (GET: el resultado se puede compartir y recargar). *@
    <form method="get" action="/panel/admin/cuentas" class="superficie formulario cuentas__busqueda" role="search" aria-label="Buscar cuentas">
        <div class="campo">
            <label class="campo__etiqueta" for="Buscar">Buscar</label>
            <input class="campo__control" id="Buscar" name="Buscar" type="search" value="@Model.Buscar" autocomplete="off"
                   aria-describedby="Buscar-ayuda" />
            <p id="Buscar-ayuda" class="campo__ayuda">Código, nombre, correo o DNI completo.</p>
        </div>
        <div class="campo">
            <label class="campo__etiqueta" for="Rol">Rol</label>
            <select class="campo__control campo__control--seleccion" id="Rol" name="Rol">
                <option value="">Todos</option>
                <option value="Operador" selected="@(Model.Rol == "Operador")">Operador</option>
                <option value="Sereno" selected="@(Model.Rol == "Sereno")">Sereno</option>
            </select>
        </div>
        <div class="acciones cuentas__busqueda-acciones">
            <button type="submit" class="boton boton--principal"><partial name="_Icono" model="@("lupa")" />Buscar</button>
            @if (Model.Filtrando)
            {
                <a class="boton boton--secundario" href="/panel/admin/cuentas">Limpiar</a>
            }
        </div>
    </form>
}

@if (Model.Total == 0)
{
    <section class="superficie estado-vacio">
        <partial name="_Icono" model="@("escudo")" />
        <p class="aviso__titulo">Aún no hay cuentas institucionales</p>
        <p>Crea la primera cuenta de operador o de sereno.</p>
        <a class="boton boton--secundario" href="/panel/admin/cuentas/nueva">Nueva cuenta</a>
    </section>
}
else if (Model.Cuentas.Count == 0)
{
    <section class="superficie estado-vacio" data-sin-resultados>
        <partial name="_Icono" model="@("lupa")" />
        <p class="aviso__titulo">Ninguna cuenta coincide con la búsqueda</p>
        <p>Revisa el texto o el rol elegido.</p>
        <a class="boton boton--secundario" href="/panel/admin/cuentas">Ver todas las cuentas</a>
    </section>
}
else
{
    <partial name="_TablaCuentas" model="Model.Cuentas" />
}
