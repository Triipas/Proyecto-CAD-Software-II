@page "/panel/casos"
@model Cad.Server.Panel.Pages.Casos.IndexModel
@using System.Globalization
@using Cad.Server.Modulos.Casos.Dominio
@using Tiempos = Cad.Server.Modulos.Consultas.TiemposCaso
@{
    ViewData["Title"] = "Casos";
    var inv = CultureInfo.InvariantCulture;
    string Local(DateTimeOffset momento) => TimeZoneInfo.ConvertTime(momento, Model.ZonaHoraria).ToString("dd/MM/yyyy HH:mm", inv);
    var r = Model.Resultado;
}
<div class="pagina__encabezado">
    <div>
        <p class="sobretitulo">Operador</p>
        <h1 class="titulo">Casos</h1>
        <p class="texto-secundario">SOS y reportes. Los filtros se combinan; sin filtros, los casos más recientes primero, de @Cad.Server.Modulos.Consultas.ConsultarCasos.TamanoPagina en @Cad.Server.Modulos.Consultas.ConsultarCasos.TamanoPagina.</p>
    </div>
</div>

@* HU26-CA01 — filtros combinables. Formulario GET: la búsqueda queda en la dirección. *@
<form method="get" action="/panel/casos" class="superficie formulario filtros" aria-labelledby="titulo-filtros" data-filtros novalidate>
    <h2 id="titulo-filtros" class="central__titulo">Filtros</h2>
    <div class="filtros__campos">
        @{
            async Task Selector(string id, string etiqueta, string? valor, IEnumerable<(string Valor, string Texto)> opciones, string vacia)
            {
                var error = Model.ErrorDe(id);
                <div class="campo">
                    <label class="campo__etiqueta" for="@id">@etiqueta</label>
                    <select class="campo__control campo__control--seleccion" id="@id" name="@id"
                            aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : $"{id}-error")">
                        <option value="">@vacia</option>
                        @foreach (var (v, t) in opciones)
                        {
                            <option value="@v" selected="@(valor == v)">@t</option>
                        }
                    </select>
                    @if (error is not null)
                    {
                        <p id="@id-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@error</span></p>
                    }
                </div>
                await Task.CompletedTask;
            }
            async Task CampoFecha(string id, string etiqueta, string? valor)
            {
                var error = Model.ErrorDe(id);
                <div class="campo">
                    <label class="campo__etiqueta" for="@id">@etiqueta</label>
                    <input class="campo__control" type="date" id="@id" name="@id" value="@valor"
                           aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? $"{id}-ayuda" : $"{id}-error {id}-ayuda")" />
                    <p id="@id-ayuda" class="campo__ayuda">Fecha de registro del caso.</p>
                    @if (error is not null)
                    {
                        <p id="@id-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@error</span></p>
                    }
                </div>
                await Task.CompletedTask;
            }
        }
        @{ await CampoFecha("desde", "Desde", Model.Desde); }
        @{ await CampoFecha("hasta", "Hasta", Model.Hasta); }
        @{ await Selector("origen", "Origen", Model.Origen, [("Sos", "SOS"), ("Reporte", "Reporte"), ("Acompanamiento", "Acompañamiento")], "Todos"); }
        @{ await Selector("tipo", "Tipo de incidencia", Model.Tipo,
               Model.Categorias.Select(c => (c.Id.ToString(), c.Nombre)).Append((Cad.Server.Panel.Pages.Casos.IndexModel.ValorSinTipo, Cad.Server.Modulos.Consultas.CasoEncontrado.TipoPorDeterminar)), "Todos"); }
        @{ await Selector("estado", "Estado", Model.Estado,
               Cad.Server.Panel.Pages.Casos.IndexModel.EstadosFiltrables.Select(e => (e.ToString(), EstadosCaso.Texto(e))), "Todos"); }
        @{ await Selector("sereno", "Sereno asignado", Model.Sereno, Model.Serenos.Select(s => (s.Id.ToString(), s.Nombre)), "Todos"); }
    </div>
    <div class="acciones">
        @* HU26-CA03: limpiar retira todos los filtros. *@
        <a class="boton boton--secundario" href="/panel/casos" data-limpiar>Limpiar filtros</a>
        <button type="submit" class="boton boton--principal">Buscar</button>
    </div>
</form>

@if (r is null)
{
    <div class="aviso aviso--error" role="alert" tabindex="-1" data-enfocar>
        <partial name="_Icono" model="@("error")" />
        <div>
            <p class="aviso__titulo">Revisa los filtros</p>
            <p class="aviso__texto">Corrige los datos marcados para buscar.</p>
        </div>
    </div>
}
else if (r.Total == 0)
{
    @* HU26-CA04 *@
    <div class="estado-vacio" role="status" data-sin-coincidencias>
        <partial name="_Icono" model="@("informacion")" />
        <p class="aviso__titulo">No existen casos que coincidan con los filtros</p>
        <p>Cambia o limpia los filtros para ver más casos.</p>
    </div>
}
else
{
    <div class="tabla-contenedor">
        <table class="tabla" data-casos data-total="@r.Total">
            <caption>@r.Total @(r.Total == 1 ? "caso" : "casos")@(Model.HayFiltros ? " con los filtros aplicados" : "") · página @r.Pagina de @r.Paginas</caption>
            <thead>
                <tr>
                    <th scope="col">Registrado</th>
                    <th scope="col">Origen</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Ciudadano</th>
                    <th scope="col">Sereno asignado</th>
                    <th scope="col">Ubicación</th>
                    @* HU28 (DP18): tiempos por caso, desde el registro. *@
                    <th scope="col">Hasta la decisión <span class="texto-secundario">(reportes)</span></th>
                    <th scope="col">Hasta el inicio de atención <span class="texto-secundario">(en un SOS, tiempo de respuesta)</span></th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var caso in r.Casos)
                {
                    <tr data-caso="@caso.Id">
                        <th scope="row"><time datetime="@caso.RegistradoEn.ToString("O", inv)">@Local(caso.RegistradoEn)</time></th>
                        <td>@caso.TextoOrigen</td>
                        <td data-estado>@caso.Estado</td>
                        @* HU26-CA02 *@
                        <td class="@(caso.Tipo is null ? "texto-secundario" : null)" data-tipo>@caso.TextoTipo</td>
                        <td>@caso.Ciudadano</td>
                        <td>@(caso.Sereno ?? "—")</td>
                        @* HU26-CA05: sin coordenadas inventadas. *@
                        <td data-ubicacion>@(caso.ConUbicacion ? (caso.Origen switch { OrigenCaso.Sos => "Del dispositivo", OrigenCaso.Reporte => "Lugar del hecho", _ => "Última posición del acompañamiento" }) : "Sin ubicación")</td>
                        <td data-tiempo-decision class="@(Tiempos.SinValor(caso.Tiempos.HastaDecision) ? "texto-secundario" : null)">@caso.Tiempos.HastaDecision</td>
                        <td data-tiempo-atencion class="@(Tiempos.SinValor(caso.Tiempos.HastaInicioAtencion) ? "texto-secundario" : null)">@caso.Tiempos.HastaInicioAtencion</td>
                        <td>
                            <a href="@Cad.Server.Panel.Pages.Casos.IndexModel.Detalle(caso)">Detalle<span class="visualmente-oculto"> del caso de @caso.Ciudadano</span></a>
                            · <a href="/panel/casos/@caso.Id/historial">Historial<span class="visualmente-oculto"> del caso de @caso.Ciudadano</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (r.Paginas > 1)
    {
        <nav class="paginacion" aria-label="Páginas de resultados">
            @if (r.Pagina > 1)
            {
                <a class="boton boton--secundario" href="@Model.RutaPagina(r.Pagina - 1)" rel="prev">Anterior</a>
            }
            <span class="texto-secundario">Página @r.Pagina de @r.Paginas</span>
            @if (r.Pagina < r.Paginas)
            {
                <a class="boton boton--secundario" href="@Model.RutaPagina(r.Pagina + 1)" rel="next">Siguiente</a>
            }
        </nav>
    }
}
