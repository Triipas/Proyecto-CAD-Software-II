@page "/panel/casos/{id:guid}/historial"
@model Cad.Server.Panel.Pages.Casos.HistorialModel
@using System.Globalization
@{
    ViewData["Title"] = "Historial del caso";
    var inv = CultureInfo.InvariantCulture;
    var h = Model.Historial;
    string Local(DateTimeOffset momento) => TimeZoneInfo.ConvertTime(momento, Model.ZonaHoraria).ToString("dd/MM/yyyy HH:mm:ss", inv);
}
<p><a class="enlace-volver" href="@(h.Origen == "SOS" ? $"/panel/central/sos/{h.Id}" : $"/panel/reportes/{h.Id}")">← Volver al caso</a></p>
<div class="pagina__encabezado">
    <div>
        <p class="sobretitulo">Operador · @h.Origen @h.Estado</p>
        <h1 class="titulo">Historial del caso</h1>
        <p class="texto-secundario">Registrado el @Local(h.RegistradoEn). Identificador: @h.Id</p>
        @if (h.HechoOcurridoEn is { } hecho)
        {
            <p class="texto-secundario" data-hecho>Hecho ocurrido aproximadamente el @TimeZoneInfo.ConvertTime(hecho, Model.ZonaHoraria).ToString("dd/MM/yyyy HH:mm", inv), según el ciudadano.</p>
        }
    </div>
</div>

@* HU27-CA02: un caso finalizado queda identificado con su resultado. *@
@if (h.Resultado is { } resultado)
{
    <div class="aviso aviso--exito" data-resultado-final>
        <partial name="_Icono" model="@("exito")" />
        <div>
            <p class="aviso__titulo">@resultado.Estado el @Local(resultado.En)</p>
            <p class="aviso__texto">@resultado.Descripcion</p>
        </div>
    </div>
}

@* HU33 — evaluación del ciudadano (solo lectura). CA02: un caso sin evaluación no muestra ninguna puntuación. *@
@if (h.Estado == "Cerrada" || h.Evaluacion is not null)
{
    <section class="superficie" aria-labelledby="titulo-evaluacion" data-evaluacion>
        <h2 id="titulo-evaluacion" class="central__titulo">Evaluación del ciudadano</h2>
        @if (h.Evaluacion is { } evaluacion)
        {
            <p class="evaluacion__puntuacion" data-puntuacion="@evaluacion.Puntuacion">
                <span aria-hidden="true">@(new string('★', evaluacion.Puntuacion))@(new string('☆', 5 - evaluacion.Puntuacion))</span>
                <strong>@evaluacion.Puntuacion de 5</strong> · <span class="texto-secundario">@Local(evaluacion.EvaluadaEn)</span>
            </p>
            <p class="historial__texto">@(evaluacion.Comentario is { } comentario ? $"Comentario: {comentario}" : "Sin comentario.")</p>
        }
        else
        {
            <p class="texto-secundario" data-sin-evaluacion>El ciudadano no ha evaluado este caso. Evaluar es voluntario.</p>
        }
    </section>
}

<section class="superficie" aria-labelledby="titulo-secuencia">
    <h2 id="titulo-secuencia" class="central__titulo">Secuencia de atención · @h.Entradas.Count @(h.Entradas.Count == 1 ? "actuación" : "actuaciones")</h2>
    @* HU27-CA01/CA03: actuaciones en orden, con responsable y marca de tiempo. CA05: sin acompañamiento. *@
    <ol class="historial" data-historial>
        @foreach (var entrada in h.Entradas)
        {
            <li class="historial__elemento" data-actuacion>
                <p class="historial__cabecera">
                    <span class="estado @(entrada.Interna ? "estado--inactiva" : "estado--activa")">@entrada.Actuacion</span>
                    <time datetime="@entrada.En.ToString("O", inv)">@Local(entrada.En)</time>
                    <span class="texto-secundario">· @entrada.Responsable</span>
                </p>
                @if (entrada.Detalle is not null)
                {
                    <p class="historial__texto">
                        @if (entrada.Interna)
                        {
                            <strong>Solo personal autorizado:</strong>
                        }
                        @entrada.Detalle
                    </p>
                }
            </li>
        }
    </ol>
</section>
