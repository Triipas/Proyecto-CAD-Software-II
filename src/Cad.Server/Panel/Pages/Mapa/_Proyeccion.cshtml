@model Cad.Server.Panel.Pages.Mapa.ConcentracionModel
@using System.Globalization
@using Cad.Server.Modulos.Proyeccion
@* HU46 (S6-T20, S6-T21) — vista «Proyección»: zonas con más casos esperados en la ventana elegida, con su nivel en texto y no solo en
   color (CA08), por qué, la cobertura de serenos (CA04) y el parte de patrullaje. Solo celdas, nunca casos (CA03).
   Rediseño del 05/11/2026: el mapa a sangre, el panel flotante con las zonas en orden y una línea de tiempo por bloques de 4 h; el
   nivel es absoluto (casos esperados por bloque), no un percentil. *@
@{
    var p = Model.Proyeccion!;
    var inv = CultureInfo.InvariantCulture;
    var es = CultureInfo.GetCultureInfo("es-PE");
    var local = (DateTimeOffset t) => TimeZoneInfo.ConvertTime(t, Model.ZonaHoraria);
    static string Nivel(NivelFoco n) => n switch { NivelFoco.Alto => "Alto", NivelFoco.Medio => "Medio", _ => "Bajo" };
    static string Km(int metros) => (metros / 1000.0).ToString("0.0", CultureInfo.GetCultureInfo("es-PE")) + " km";
    static string Cifra(double v) => v.ToString("0.0", CultureInfo.GetCultureInfo("es-PE"));
    static string Umbral(double v) => v.ToString("0.##", CultureInfo.GetCultureInfo("es-PE"));
    var principales = p.Suficiente ? p.Principales(10) : [];
}

@if (p.Suficiente)
{
    <div id="mapa-proyeccion" class="mapa mapa--infrarrojo focos__mapa" data-centro-lat="@Model.CentroLatitud" data-centro-lon="@Model.CentroLongitud"
         data-zoom="@Model.Zoom" data-teselas="@Model.UrlTeselas" role="region"
         aria-label="Mapa de la proyección: zonas de nivel alto, medio y bajo" aria-describedby="zonas-proyectadas"></div>
}
else
{
    <div class="mapa mapa--infrarrojo focos__mapa focos__mapa--vacio" aria-hidden="true"></div>
}

@* La honestidad del prototipo, siempre a la vista y sobre el mapa: lo esperado se calcula con datos simulados. *@
<p class="aviso-mapa" role="note" data-aviso-proyeccion>
    <partial name="_Icono" model="@("informacion")" />
    <span><strong>Proyección calculada sobre datos simulados</strong> · orienta el patrullaje, no predice delitos individuales.</span>
</p>

<aside class="focos__panel" aria-label="Proyección de focos">
    <header class="focos__cabecera">
        <h1 class="titulo focos__titulo">Mapa de concentración</h1>
        <partial name="_VistaMapa" model="Model" />
    </header>

    <div class="focos__cuerpo" tabindex="0" role="region" aria-label="Ventana, parte y zonas proyectadas">
        <form method="get" action="/panel/mapa-concentracion" class="focos__seleccion" aria-labelledby="titulo-ventana" data-seleccion-proyeccion>
            <h2 id="titulo-ventana" class="visualmente-oculto">Ventana de la proyección</h2>
            <input type="hidden" name="Vista" value="proyeccion" />
            <div class="segmentos" role="group" aria-label="Ventana">
                @foreach (var (codigo, texto, _) in Cad.Server.Panel.Pages.Mapa.ConcentracionModel.Ventanas)
                {
                    <button type="submit" name="Ventana" value="@codigo" class="segmentos__opcion" aria-pressed="@(Model.Ventana == codigo ? "true" : "false")">@texto</button>
                }
            </div>
            <p class="campo__ayuda">Desde las @local(p.Desde).ToString("HH:mm", inv) del @local(p.Desde).ToString("dd/MM", inv) hasta las @local(p.Hasta).ToString("HH:mm", inv) del @local(p.Hasta).ToString("dd/MM", inv).</p>
        </form>

        @if (!p.Suficiente)
        {
            <div class="aviso aviso--advertencia" role="status" data-sin-datos-proyeccion>
                <partial name="_Icono" model="@("advertencia")" />
                <p class="aviso__texto">No hay datos suficientes para proyectar: hacen falta al menos @Model.MinimoCasos casos con ubicación en las últimas 8 semanas (hay @p.CasosRecientes).</p>
            </div>
        }
        else
        {
            @if (Model.Parte is { } parte)
            {
                <details class="parte-patrullaje" open data-parte data-parte-origen="@(parte.Modelo is null ? "plantilla" : "modelo")">
                    <summary class="parte-patrullaje__titulo"><partial name="_Icono" model="@("informacion")" />Parte sugerido</summary>
                    <p data-parte-resumen>@parte.Resumen</p>
                    @if (parte.Acciones.Count > 0)
                    {
                        <ul class="parte-patrullaje__acciones">
                            @foreach (var a in parte.Acciones)
                            {
                                <li>@a.Texto</li>
                            }
                        </ul>
                    }
                    <p class="campo__ayuda">@(parte.Modelo is null ? "Parte plantilla con las cifras calculadas (sin modelo de lenguaje)." : $"Redactado por {parte.Modelo} con las cifras calculadas y comprobado: no trae cifras, zonas ni serenos fuera de la proyección.") Es una ayuda de lectura: reposicionar serenos lo decide la central.</p>
                </details>
            }

            <section class="focos__seccion" aria-labelledby="titulo-proyeccion">
                <h2 id="titulo-proyeccion" class="focos__subtitulo">Zonas con más casos esperados en @p.TextoVentana</h2>
                <p class="campo__ayuda" data-vista-bloque aria-live="polite">Toda la ventana; el nivel es el promedio por bloque de 4 horas. Elige un bloque en la línea de tiempo para verlo solo.</p>
                @if (p.Tranquila)
                {
                    <div class="aviso aviso--informacion" role="status" data-tranquila>
                        <partial name="_Icono" model="@("informacion")" />
                        <p class="aviso__texto">Semana tranquila: ninguna zona llega a @Umbral(p.UmbralMedio) casos esperados en un bloque de 4 horas. Se listan las que más tienen.</p>
                    </div>
                }
                <ol class="ranking ranking--proyeccion" id="zonas-proyectadas" data-zonas-proyectadas>
                    @foreach (var (z, i) in principales.Select((z, i) => (z, i)))
                    {
                        <li class="ranking__item@(z.SinCobertura ? " ranking__item--sin-cobertura" : "")" data-clave="@z.Clave" data-zona="@z.Clave" data-nivel="@z.Nivel">
                            <button type="button" class="ranking__boton" data-ver-zona="@z.Clave" aria-pressed="false">
                                <span class="ranking__orden num" aria-hidden="true">@(i + 1)</span>
                                <span class="ranking__nombre">@z.Zona</span>
                                <span class="ranking__cifra num"><strong>@Cifra(z.Esperados)</strong> esperados</span>
                                <span class="nivel-foco nivel-foco--@z.Nivel.ToString().ToLowerInvariant()">@Nivel(z.Nivel)</span>
                                <span class="ranking__porque">@z.Explicacion</span>
                                <span class="ranking__sereno">
                                    @if (z.SinCobertura)
                                    {
                                        <strong class="proyeccion__sin-cobertura" data-sin-cobertura><partial name="_Icono" model="@("advertencia")" />Sin cobertura cercana</strong>
                                    }
                                    @if (z.MetrosSerenoCercano is { } m)
                                    {
                                        <span>@z.SerenoCercano, a @Km(m)</span>
                                    }
                                    else
                                    {
                                        <span class="texto-secundario">No hay serenos operativos con ubicación</span>
                                    }
                                </span>
                            </button>
                        </li>
                    }
                </ol>
            </section>

            <p class="campo__ayuda" data-metodo-proyeccion>Casos esperados por zona de unos 550 m: @p.Metodo, con los SOS y reportes con ubicación de las últimas 26 semanas (sin cancelados ni descartados). Modelo entrenado con datos simulados. El nivel es absoluto, por bloque de 4 horas: Alto desde @Umbral(p.UmbralAlto) casos esperados; Medio, desde @Umbral(p.UmbralMedio).</p>
        }
    </div>
</aside>

@if (p.Suficiente)
{
    @* La línea de tiempo: la ventana entera y cada bloque de 4 h que toca, con los casos esperados en toda la ciudad. Cambia el mapa y
       la lista sin volver al servidor (proyeccion.js). *@
    var bloques = p.Bloques ?? [];
    var maximo = Math.Max(0.01, bloques.Count == 0 ? 0 : bloques.Max(b => b.Total));
    <div class="linea-tiempo" data-linea-tiempo role="group" aria-label="Bloques de 4 horas de la ventana">
        <button type="button" class="linea-tiempo__bloque linea-tiempo__bloque--todo" data-bloque="-1" aria-pressed="true">
            <span class="linea-tiempo__dia">Ventana</span>
            <span class="linea-tiempo__hora">Toda</span>
            <span class="linea-tiempo__cifra num">@Cifra(p.Zonas.Sum(z => z.Esperados)) casos</span>
        </button>
        @foreach (var (b, i) in bloques.Select((b, i) => (b, i)))
        {
            <button type="button" class="linea-tiempo__bloque" data-bloque="@i" aria-pressed="false">
                <span class="linea-tiempo__dia">@b.Dia@(b.EsAhora ? " · ahora" : "")</span>
                <span class="linea-tiempo__hora num">@b.Rotulo</span>
                <span class="linea-tiempo__barra" aria-hidden="true"><i style="width:@((b.Total / maximo * 100).ToString("0", inv))%"></i></span>
                <span class="linea-tiempo__cifra num">@Cifra(b.Total) casos</span>
            </button>
        }
    </div>

    <ul class="leyenda-focos" data-leyenda-proyeccion aria-label="Leyenda del mapa">
        <li><span class="leyenda-focos__muestra leyenda-focos__muestra--alto" aria-hidden="true"></span>Alto: @Umbral(p.UmbralAlto) casos esperados o más por bloque</li>
        <li><span class="leyenda-focos__muestra leyenda-focos__muestra--medio" aria-hidden="true"></span>Medio: desde @Umbral(p.UmbralMedio)</li>
        <li><span class="leyenda-focos__muestra leyenda-focos__muestra--bajo" aria-hidden="true"></span>Bajo: menos de @Umbral(p.UmbralMedio)</li>
        <li><span class="leyenda-focos__muestra leyenda-focos__muestra--sin" aria-hidden="true"></span>Sin sereno a menos de @Km(p.UmbralCoberturaMetros)</li>
        <li><span class="leyenda-focos__muestra leyenda-focos__muestra--sereno" aria-hidden="true"></span>Sereno operativo</li>
    </ul>
    <script type="application/json" id="celdas-proyeccion">@Html.Raw(Model.ProyeccionJson)</script>
    <script type="application/json" id="contexto-proyeccion">@Html.Raw(Model.ContextoProyeccionJson)</script>
}
