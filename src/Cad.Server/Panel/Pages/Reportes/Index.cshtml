@page "/panel/reportes"
@model Cad.Server.Panel.Pages.Reportes.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Reportes";
    var inv = CultureInfo.InvariantCulture;
    static string Fuente(string fuente) => fuente switch
    {
        "Mapa" => "Punto en el mapa",
        "PosicionActual" => "Posición del ciudadano (elegida)",
        _ => "Referencia textual",
    };
}
@section Estilos {
    <link rel="stylesheet" href="~/css/reportes.css" asp-append-version="true" />
}
<div class="pagina__encabezado">
    <div>
        <h1 class="titulo">Reportes</h1>
        <p class="texto-secundario">Recibidos y en revisión, los más recientes primero. No son alertas urgentes: los SOS siguen en la central.</p>
    </div>
    @* 23/10/2026: un hecho que llega por otra vía (p. ej. una llamada) lo registra la central. *@
    <a class="boton boton--principal" href="/panel/reportes/nuevo"><partial name="_Icono" model="@("documento")" />Nuevo reporte</a>
</div>

@if (Model.Reportes.Count == 0)
{
    <div class="superficie estado-vacio reportes__vacio">
        <partial name="_Icono" model="@("exito")" />
        <p class="aviso__titulo">No hay reportes por revisar</p>
        <p>Los reportes que envíen los ciudadanos aparecerán aquí.</p>
    </div>
}
else
{
    <div class="tabla-contenedor reportes__tabla" tabindex="0" role="region" aria-labelledby="leyenda-reportes">
        <table class="tabla" data-reportes>
            <caption id="leyenda-reportes">@Model.Reportes.Count @(Model.Reportes.Count == 1 ? "reporte" : "reportes") por revisar</caption>
            <thead>
                <tr>
                    <th scope="col">Registrado</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Categoría vigente</th>
                    <th scope="col">Ciudadano</th>
                    <th scope="col">Hecho (aprox.)</th>
                    <th scope="col">Ubicación del hecho</th>
                    <th scope="col"><span class="visualmente-oculto">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reporte in Model.Reportes)
                {
                    var registrado = TimeZoneInfo.ConvertTime(reporte.RegistradoEn, Model.ZonaHoraria);
                    var hecho = TimeZoneInfo.ConvertTime(reporte.OcurridoAproximadamenteEn, Model.ZonaHoraria);
                    <tr data-reporte="@reporte.Id">
                        <th scope="row"><time class="reportes__fecha" datetime="@reporte.RegistradoEn.ToString("O", inv)"><b>@registrado.ToString("HH:mm", inv)</b> <span>@registrado.ToString("dd/MM/yyyy", inv)</span></time></th>
                        <td data-estado><partial name="_ChipEstado" model="@((reporte.Estado, false))" /></td>
                        <td class="reportes__categoria">@reporte.Categoria</td>
                        <td>@reporte.Ciudadano</td>
                        <td class="reportes__hecho">@hecho.ToString("dd/MM/yyyy HH:mm", inv)</td>
                        <td>@Fuente(reporte.FuenteUbicacion)</td>
                        <td><a href="/panel/reportes/@reporte.Id" data-abrir-caso>Revisar<span class="visualmente-oculto"> el reporte de @reporte.Ciudadano</span></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script src="~/js/casos.js" asp-append-version="true"></script>
}
