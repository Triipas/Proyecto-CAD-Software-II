@page "/panel/reportes/{id:guid}"
@model Cad.Server.Panel.Pages.Reportes.DetalleModel
@using System.Globalization
@using Cad.Server.Modulos.Casos.Dominio
@using Accion = Cad.Server.Panel.Pages.Reportes.DetalleModel.SiguienteAccion
@{
    ViewData["Title"] = "Reporte";
    ViewData["ClasePagina"] = "pagina--consola";
    var inv = CultureInfo.InvariantCulture;
    var r = Model.Reporte;
    var s = Model.Seguimiento;
    var siguiente = Model.Siguiente;
    string Local(DateTimeOffset momento, string formato = "dd/MM/yyyy HH:mm:ss") => TimeZoneInfo.ConvertTime(momento, Model.ZonaHoraria).ToString(formato, inv);
    var fuente = r.FuenteUbicacion switch
    {
        "Mapa" => "Punto elegido en el mapa por el ciudadano",
        "PosicionActual" => "Posición del ciudadano al reportar (por elección suya)",
        _ => "Referencia textual (sin punto)",
    };
    // Consola de incidente (27/10/2026), como el detalle del SOS. Un reporte no es urgente: su cronómetro no sube de tono.
    var terminado = r.Estado is EstadoCaso.Derivada or EstadoCaso.Descartada or EstadoCaso.Cancelada or EstadoCaso.Cerrada;
    var etiquetaTiempo = r.Estado switch
    {
        EstadoCaso.Recibido => "Sin revisar",
        EstadoCaso.EnRevision => "Sin decidir",
        EstadoCaso.Pendiente => "Sin asignar",
        _ => "Abierto",
    };
    var fase = siguiente switch
    {
        Accion.IniciarRevision or Accion.Decidir => "Revisión",
        Accion.Asignar => "Despacho",
        _ => "Atención",
    };
    string Transcurrido(TimeSpan t) => t.TotalMinutes < 1 ? "hace menos de 1 min"
        : t.TotalHours < 1 ? $"hace {(int)t.TotalMinutes} min"
        : t.TotalDays < 1 ? $"hace {(int)t.TotalHours} h {t.Minutes} min"
        : $"hace {(int)t.TotalDays} d {t.Hours} h";
    string Corta(DateTimeOffset momento)
    {
        var local = TimeZoneInfo.ConvertTime(momento, Model.ZonaHoraria);
        var hoy = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, Model.ZonaHoraria).Date;
        return local.Date == hoy ? $"hoy, {local.ToString("HH:mm", inv)}" : local.ToString("dd/MM HH:mm", inv);
    }
    var categoriaCorregida = r.CategoriaOriginal != r.CategoriaActual;
    // «Otras acciones»: corregir la categoría, solo mientras el reporte está «En revisión» (HU14-CA04).
    var abrirOtras = Model.ErrorCategoria is not null || Model.ErrorCorreccion is not null;
    var hechoPrimero = r.PuedeIniciarRevision || r.PuedeDecidir;

    // Rediseño del 27/10/2026: lo que reportó el ciudadano va en la columna principal, junto a la decisión (antes, abajo en el
    // contexto). Mientras se revisa va primero; después, bajo las acciones.
    void Hecho()
    {
        <section class="superficie seccion-caso hecho" aria-labelledby="titulo-hecho">
            <div class="hecho__cabecera">
                <h2 id="titulo-hecho" class="seccion-caso__titulo">@(r.DeLaCentral ? "Lo que se informó a la central" : "Lo que reportó el ciudadano")</h2>
                <p class="hecho__cuando">Ocurrió aproximadamente el @Local(r.OcurridoAproximadamenteEn, "dd/MM/yyyy HH:mm")</p>
            </div>
            <p class="hecho__descripcion" data-descripcion>@r.Descripcion</p>
            @if (r.DeLaCentral)
            {
                <dl class="datos datos--en-linea">
                    <div><dt>Registrado</dt><dd>Por la central</dd></div>
                    <div><dt>Quién avisó</dt><dd data-contacto>@(r.ContactoNombre ?? "Sin datos")@(r.ContactoTelefono is { } telefono ? $" · {telefono}" : "")</dd></div>
                </dl>
            }
            else
            {
                @* DP08 ampliada (26/10/2026): fotos que adjuntó el ciudadano, ya sin metadatos; solo las ve el operador. *@
                <div class="hecho__fotos" data-fotos-reporte="@r.Fotos">
                    <h3 id="titulo-fotos" class="hecho__subtitulo">Fotos del ciudadano</h3>
                    @if (r.Fotos == 0)
                    {
                        <p class="texto-secundario" data-sin-fotos>El ciudadano no adjuntó fotos.</p>
                    }
                    else
                    {
                        <ul class="fotos-reporte" role="list">
                            @for (var n = 1; n <= r.Fotos; n++)
                            {
                                var url = $"/panel/reportes/{r.Id}?handler=Foto&numero={n}";
                                <li>
                                    <a href="@url" target="_blank" rel="noopener" class="fotos-reporte__enlace" data-foto="@n">
                                        <img src="@url" alt="Foto @n de @r.Fotos adjuntada por el ciudadano" decoding="async" />
                                    </a>
                                </li>
                            }
                        </ul>
                        <p class="texto-secundario detalle-caso__nota">Ábrela para verla en tamaño completo (en otra pestaña). Son fotos del ciudadano: no confirman por sí solas lo ocurrido.</p>
                    }
                </div>
            }
        </section>
    }
    // HU15–HU17: la decisión registrada, en la tarjeta (derivado o descartado) o en el contexto (admitido).
    void DatosDecision(Cad.Server.Modulos.Consultas.DecisionVista d)
    {
        <dl class="datos datos--en-linea" data-decision="@d.Tipo">
            <div><dt>Decisión</dt><dd>@d.Texto</dd></div>
            @if (d.Destino is { } destino)
            {
                <div><dt>Destino</dt><dd data-destino>@destino</dd></div>
                <div><dt>Acción realizada</dt><dd class="datos__texto">@d.Accion</dd></div>
            }
            <div><dt>Motivo</dt><dd class="datos__texto" data-motivo>@d.Motivo</dd></div>
            <div><dt>Decidido por</dt><dd>@d.Operador</dd></div>
            <div><dt>Fecha y hora</dt><dd>@Local(d.En)</dd></div>
        </dl>
    }
}
@section Estilos {
    @if (r.ConPunto)
    {
        <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/detalle-caso.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/consola.css" asp-append-version="true" />
}

<header class="consola__barra" data-caso="@r.Id" data-origen-estado="Reporte @r.TextoEstado"
        data-regiones="[aria-labelledby='titulo-categoria'],[aria-labelledby='titulo-revision'],[data-tiempos]"
        data-texto-cancelado="El ciudadano retiró este reporte mientras escribías. Lo que escribiste no se registró.">
    <div class="consola__ancho">
        <a class="consola__volver" href="/panel/reportes" aria-label="Volver a los reportes" title="Reportes">
            <partial name="_Icono" model="@("izquierda")" />
        </a>
        <div class="consola__titular">
            <span class="etiqueta-reporte"><partial name="_Icono" model="@("documento")" />Reporte</span>
            <h1 class="consola__titulo">@r.CategoriaActual</h1>
            <span data-estado><partial name="_ChipEstado" model="@((r.TextoEstado, false))" /></span>
            <span class="consola__quien">de <strong>@r.Ciudadano</strong></span>
            @if (!terminado)
            {
                <span class="consola__cronometro" data-transcurrido="@r.RegistradoEn.ToString("O", inv)" data-nivel="0" title="Registrado el @Local(r.RegistradoEn)">
                    <partial name="_Icono" model="@("reloj")" />
                    <span>@etiquetaTiempo</span>
                    <strong data-texto>@Transcurrido(DateTimeOffset.UtcNow - r.RegistradoEn)</strong>
                </span>
            }
        </div>
        <div class="consola__acciones">
            <a class="consola__otro-sos" href="/panel/central" data-otro-sos hidden>
                <partial name="_Icono" model="@("urgente")" />Nuevo SOS en la central
            </a>
            <span class="consola__vivo" data-vivo data-conexion="conectando"><span class="consola__punto" aria-hidden="true"></span><span data-texto>Conectando…</span></span>
            <a class="boton boton--secundario boton--compacto" href="/panel/casos/@r.Id/historial">
                <partial name="_Icono" model="@("reloj")" />Historial
            </a>
        </div>
    </div>
    <p class="visualmente-oculto" role="status" data-anuncio></p>
</header>

@if (Model.Mensaje is not null)
{
    <div class="aviso aviso--exito" role="status" tabindex="-1" data-enfocar>
        <partial name="_Icono" model="@("exito")" />
        <div>
            <p class="aviso__titulo">@Model.Mensaje</p>
            <p class="aviso__texto">El reporte está «@r.TextoEstado». @Model.DetalleMensaje</p>
        </div>
    </div>
}

@* Errores de las acciones: se muestran arriba aunque el formulario ya no esté disponible (p. ej., otro operador decidió antes). *@
@foreach (var (titulo, error) in new[] {
    ("No se pudo iniciar la revisión", Model.ErrorRevision),
    ("No se pudo corregir la categoría", Model.ErrorCorreccion),
    ("No se pudo registrar la decisión", Model.ErrorDecision),
    ("No se registró el inicio de atención", Model.ErrorAtencion),
    ("No se pudo cerrar el reporte", Model.ErrorCierre),
    ("No se pudo descartar el reporte", Model.ErrorDescarte),
    ("No se pudo reasignar el reporte", Model.ErrorReasignacion),
    ("No se pudo asignar el reporte", Model.ErrorAsignacion) })
{
    if (error is null) continue;
    <div class="aviso aviso--error" role="alert" tabindex="-1" data-enfocar>
        <partial name="_Icono" model="@("error")" />
        <div>
            <p class="aviso__titulo">@titulo</p>
            <p class="aviso__texto">@error</p>
        </div>
    </div>
}

<div class="consola consola__ancho">
    <div class="consola__pasos">
        <partial name="_ProgresoCaso" model="Model.Pasos" />
        <dl class="consola__resumen">
            <div><dt>Registrado</dt><dd><time datetime="@r.RegistradoEn.ToString("O", inv)">@Corta(r.RegistradoEn)</time></dd></div>
            <div><dt>Ocurrió</dt><dd>@Corta(r.OcurridoAproximadamenteEn)</dd></div>
            @if (r.RevisionIniciadaPor is { } revisor)
            {
                <div><dt>Revisa</dt><dd>@revisor</dd></div>
            }
            @if (s?.Asignacion is { FinalizadaEn: null } enCurso)
            {
                <div><dt>Sereno</dt><dd>@enCurso.Sereno</dd></div>
            }
            <div><dt>Identificador</dt><dd title="@r.Id">@r.Id.ToString()[..8].ToUpperInvariant()</dd></div>
        </dl>
    </div>

    <div class="consola__trabajo">
        <div class="aviso consola__cambio" role="alert" data-caso-cambio data-tono="informacion" hidden>
            <partial name="_Icono" model="@("informacion")" />
            <p class="aviso__texto" data-texto></p>
            <button type="button" class="boton boton--secundario boton--compacto" data-recargar>Ver los cambios</button>
        </div>
        @if (hechoPrimero)
        {
            Hecho();
        }
        <section class="superficie siguiente@(terminado ? " siguiente--terminado" : "")" aria-labelledby="titulo-siguiente">
            @switch (siguiente)
            {
                case Accion.IniciarRevision:
                    @* HU14-CA01/CA02/CA05 — inicio de la revisión. *@
                    <div class="siguiente__cabecera">
                        <h2 class="siguiente__titulo" id="titulo-siguiente">Revisa el reporte de @r.Ciudadano</h2>
                        <span class="siguiente__paso">@fase</span>
                    </div>
                    <form method="post" asp-page-handler="IniciarRevision" class="formulario" data-formulario>
                        <p class="texto-secundario">El reporte pasará a «En revisión» y quedarás como responsable. Después podrás corregir la categoría y decidir.</p>
                        <div class="acciones">
                            <button type="submit" class="boton boton--principal" data-texto-carga="Iniciando…">Iniciar la revisión</button>
                        </div>
                    </form>
                    break;
                case Accion.Decidir:
                    @* HU15–HU17 — admitir, derivar o descartar, solo desde «En revisión». *@
                    <div class="siguiente__cabecera">
                        <h2 class="siguiente__titulo" id="titulo-siguiente">Decide qué hacer con el reporte</h2>
                        <span class="siguiente__paso">@fase</span>
                    </div>
                    <form method="post" asp-page-handler="Decidir" class="formulario" data-formulario novalidate>
                        <fieldset class="opciones opciones--segmentadas">
                            <legend class="campo__etiqueta">Decisión</legend>
                            <div class="opciones__segmentos">
                                <label class="opcion"><input type="radio" name="Decision.Tipo" value="Admision" checked="@(Model.Decision.Tipo == TipoDecisionReporte.Admision)" aria-describedby="ayuda-admision" />Admitir</label>
                                <label class="opcion"><input type="radio" name="Decision.Tipo" value="Derivacion" checked="@(Model.Decision.Tipo == TipoDecisionReporte.Derivacion)" aria-describedby="ayuda-derivacion" />Derivar</label>
                                <label class="opcion"><input type="radio" name="Decision.Tipo" value="Descarte" checked="@(Model.Decision.Tipo == TipoDecisionReporte.Descarte)" aria-describedby="ayuda-descarte" />Descartar</label>
                            </div>
                            <p id="ayuda-admision" class="campo__ayuda decision__ayuda decision__ayuda--admision">Admitir para atención: pasa a «Admitido» y queda listo para asignarlo a un sereno.</p>
                            <p id="ayuda-derivacion" class="campo__ayuda decision__ayuda decision__ayuda--derivacion">Derivar a otra entidad: es solo un registro, el sistema no envía nada.</p>
                            <p id="ayuda-descarte" class="campo__ayuda decision__ayuda decision__ayuda--descarte">Descartar: el reporte no se atiende y queda en el historial.</p>
                        </fieldset>
                        @foreach (var (campo, etiqueta, ayuda, valor, multilinea, maximo) in new[]
                        {
                            ("Motivo", "Motivo", "Obligatorio en las tres decisiones. En un descarte es la justificación.", Model.Decision.Motivo, true, DecisionReporte.MaximoMotivo),
                            ("Destino", "Destino (solo para derivar)", "Entidad o área a la que se deriva. Obligatorio al derivar.", Model.Decision.Destino, false, DecisionReporte.MaximoDestino),
                            ("Accion", "Acción realizada (solo para derivar)", "Por ejemplo, cómo se comunicó el caso. Obligatoria al derivar.", Model.Decision.Accion, true, DecisionReporte.MaximoAccion),
                        })
                        {
                            var id = $"Decision_{campo}";
                            var error = Model.ErrorDecisionDe(campo.ToLowerInvariant());
                            var descrito = error is null ? $"{id}-ayuda" : $"{id}-error {id}-ayuda";
                            <div class="campo@(campo == "Motivo" ? "" : " campo--derivacion")">
                                <label class="campo__etiqueta" for="@id">@etiqueta</label>
                                @if (multilinea)
                                {
                                    <textarea class="campo__control campo__control--texto" id="@id" name="Decision.@campo" rows="3" maxlength="@maximo"
                                              aria-invalid="@(error is null ? null : "true")" aria-describedby="@descrito">@valor</textarea>
                                }
                                else
                                {
                                    <input class="campo__control" id="@id" name="Decision.@campo" type="text" value="@valor" maxlength="@maximo"
                                           aria-invalid="@(error is null ? null : "true")" aria-describedby="@descrito" />
                                }
                                <p id="@id-ayuda" class="campo__ayuda">@ayuda</p>
                                @if (error is not null)
                                {
                                    <p id="@id-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@error</span></p>
                                }
                            </div>
                        }
                        <div class="acciones">
                            <button type="submit" class="boton boton--principal" data-texto-carga="Registrando…">Registrar la decisión</button>
                        </div>
                    </form>
                    break;
                case Accion.Asignar:
                    <div class="siguiente__cabecera">
                        <h2 class="siguiente__titulo" id="titulo-siguiente">Asigna el reporte a un sereno disponible</h2>
                        <span class="siguiente__paso">@fase</span>
                    </div>
                    <p data-pendiente-asignacion>Pendiente de asignación. Elige un sereno disponible; también puedes hacerlo desde el mapa de la central, como un SOS.</p>
                    @if (Model.SerenosParaAsignar.Count == 0)
                    {
                        <p class="texto-secundario">No hay serenos disponibles en este momento (operativos y sin asignación vigente).</p>
                        <div class="acciones">
                            <a class="boton boton--secundario" href="/panel/central#titulo-reportes">Ver en el mapa de la central</a>
                        </div>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Asignar" class="formulario" data-formulario novalidate>
                            <input type="hidden" name="Asignacion.IdSolicitud" value="@Model.IdAsignacion" />
                            <input type="hidden" name="Asignacion.Volver" value="detalle" />
                            <fieldset class="opciones">
                                <legend class="campo__etiqueta">Sereno disponible</legend>
                                @foreach (var sereno in Model.SerenosParaAsignar)
                                {
                                    var idOpcion = $"Asignacion_Sereno_{sereno.Id:N}";
                                    <label class="opcion" for="@idOpcion">
                                        <input type="radio" id="@idOpcion" name="Asignacion.SerenoId" value="@sereno.Id" required />
                                        <span>@sereno.Nombre <span class="texto-secundario">· @sereno.Detalle</span></span>
                                    </label>
                                }
                            </fieldset>
                            <div class="acciones">
                                <a class="boton boton--secundario" href="/panel/central#titulo-reportes">Ver en el mapa de la central</a>
                                <button type="submit" class="boton boton--principal" data-texto-carga="Asignando…">Asignar el reporte</button>
                            </div>
                        </form>
                    }
                    break;
                case Accion.EsperarDesplazamiento:
                    <h2 class="siguiente__titulo" id="titulo-siguiente">@s!.Asignacion!.Sereno recibió el despacho</h2>
                    <p class="texto-secundario">Verás aquí cuando confirme que va en camino y cuando inicie la atención.</p>
                    break;
                case Accion.EsperarAtencion:
                    @* HU23-CA02: el operador registra el inicio de atención si el sereno no puede. *@
                    <h2 class="siguiente__titulo" id="titulo-siguiente">@s!.Asignacion!.Sereno va en camino</h2>
                    <form method="post" asp-page-handler="IniciarAtencion" class="formulario" data-formulario novalidate>
                        <p class="texto-secundario">Si el sereno no puede registrarlo, puedes registrar el inicio de atención; quedarás como responsable y el motivo quedará en el historial.</p>
                        <div class="campo">
                            <label class="campo__etiqueta" for="MotivoInicio">Motivo</label>
                            <textarea class="campo__control campo__control--texto" id="MotivoInicio" name="MotivoInicio" rows="2" required
                                      maxlength="@Cad.Contratos.Serenos.MotivosInicioFueraDeRango.MaximoDetalle"
                                      aria-invalid="@(Model.ErrorMotivoInicio is null ? null : "true")"
                                      aria-describedby="MotivoInicio-ayuda@(Model.ErrorMotivoInicio is null ? "" : " MotivoInicio-error")">@Model.MotivoInicio</textarea>
                            <p id="MotivoInicio-ayuda" class="campo__ayuda">Por ejemplo: el sereno avisó por radio que llegó; su teléfono no tiene señal.</p>
                            @if (Model.ErrorMotivoInicio is not null)
                            {
                                <p id="MotivoInicio-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@Model.ErrorMotivoInicio</span></p>
                            }
                        </div>
                        <div class="acciones">
                            <button type="submit" class="boton boton--secundario" data-texto-carga="Registrando…">Registrar inicio de atención</button>
                        </div>
                    </form>
                    break;
                case Accion.Cerrar:
                    var errorCategoria = Model.ErrorCierreDe("categoriaId");
                    var errorResultado = Model.ErrorCierreDe("resultadoPublico");
                    var errorNotas = Model.ErrorCierreDe("notasInternas");
                    @* HU24-CA05: el operador cierra el reporte en atención con su tipificación y resultado. *@
                    <h2 class="siguiente__titulo" id="titulo-siguiente">Cierra el reporte con su tipificación y resultado</h2>
                    <form method="post" asp-page-handler="Cerrar" class="formulario" data-formulario novalidate>
                        <div class="campo">
                            <label class="campo__etiqueta" for="Cierre_CategoriaId">Tipificación final</label>
                            <select class="campo__control campo__control--seleccion" id="Cierre_CategoriaId" name="Cierre.CategoriaId" required
                                    aria-invalid="@(errorCategoria is null ? null : "true")"
                                    aria-describedby="@(errorCategoria is null ? null : "Cierre_CategoriaId-error")">
                                <option value="">Elige una categoría</option>
                                @foreach (var categoria in Model.Categorias)
                                {
                                    <option value="@categoria.Id" selected="@(Model.Cierre.CategoriaId == categoria.Id)">@categoria.Nombre</option>
                                }
                            </select>
                            @if (errorCategoria is not null)
                            {
                                <p id="Cierre_CategoriaId-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorCategoria</span></p>
                            }
                        </div>
                        <div class="campo">
                            <label class="campo__etiqueta" for="Cierre_ResultadoPublico">Resultado de la atención</label>
                            <textarea class="campo__control campo__control--texto" id="Cierre_ResultadoPublico" name="Cierre.ResultadoPublico" rows="3" required
                                      maxlength="@CierreCaso.MaximoResultado"
                                      aria-invalid="@(errorResultado is null ? null : "true")"
                                      aria-describedby="Cierre_ResultadoPublico-ayuda@(errorResultado is null ? "" : " Cierre_ResultadoPublico-error")">@Model.Cierre.ResultadoPublico</textarea>
                            <p id="Cierre_ResultadoPublico-ayuda" class="campo__ayuda">Es el resultado público: el ciudadano podrá verlo.</p>
                            @if (errorResultado is not null)
                            {
                                <p id="Cierre_ResultadoPublico-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorResultado</span></p>
                            }
                        </div>
                        <div class="campo">
                            <label class="campo__etiqueta" for="Cierre_NotasInternas">Notas internas (opcional)</label>
                            <textarea class="campo__control campo__control--texto" id="Cierre_NotasInternas" name="Cierre.NotasInternas" rows="3"
                                      maxlength="@CierreCaso.MaximoNotas"
                                      aria-invalid="@(errorNotas is null ? null : "true")"
                                      aria-describedby="Cierre_NotasInternas-ayuda@(errorNotas is null ? "" : " Cierre_NotasInternas-error")">@Model.Cierre.NotasInternas</textarea>
                            <p id="Cierre_NotasInternas-ayuda" class="campo__ayuda">Solo para el personal autorizado; el ciudadano no las verá.</p>
                            @if (errorNotas is not null)
                            {
                                <p id="Cierre_NotasInternas-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@errorNotas</span></p>
                            }
                        </div>
                        <div class="acciones">
                            <button type="submit" class="boton boton--principal" data-texto-carga="Cerrando…">Cerrar el reporte</button>
                        </div>
                    </form>
                    break;
                case Accion.VerCierre:
                    var cierre = s!.Cierre!;
                    <h2 class="siguiente__titulo" id="titulo-siguiente">Atención cerrada</h2>
                    <dl class="datos" data-cierre>
                        <div><dt>Tipificación final</dt><dd>@cierre.Tipificacion</dd></div>
                        <div><dt>Resultado de la atención (público)</dt><dd data-resultado-publico>@cierre.ResultadoPublico</dd></div>
                        <div><dt>Notas internas (solo personal autorizado)</dt><dd data-notas-internas>@(cierre.NotasInternas ?? "Sin notas internas.")</dd></div>
                        <div><dt>Cerrado por</dt><dd>@cierre.Responsable</dd></div>
                        <div><dt>Fecha y hora</dt><dd>@Local(cierre.CerradoEn)</dd></div>
                    </dl>
                    break;
                case Accion.VerDecision:
                    var final = r.Decision!;
                    <h2 class="siguiente__titulo" id="titulo-siguiente">@(final.Destino is { } destinoFinal ? $"Reporte derivado a {destinoFinal}" : "Reporte descartado")</h2>
                    DatosDecision(final);
                    @if (final.Tipo == TipoDecisionReporte.Derivacion)
                    {
                        <p class="texto-secundario">La derivación es solo un registro: el sistema no envía información a la entidad de destino.</p>
                    }
                    break;
                case Accion.VerDescarte:
                    var descarte = Model.Descartado!;
                    <h2 class="siguiente__titulo" id="titulo-siguiente">Reporte descartado por la central</h2>
                    <dl class="datos" data-descartado>
                        <div><dt>Motivo (solo personal autorizado)</dt><dd>@descarte.Motivo</dd></div>
                        <div><dt>Estaba</dt><dd>@descarte.EstadoPrevio</dd></div>
                        <div><dt>Descartado por</dt><dd>@descarte.Operador</dd></div>
                        <div><dt>Fecha y hora</dt><dd>@Local(descarte.DescartadoEn)</dd></div>
                    </dl>
                    break;
                case Accion.VerRetiro:
                    var retiro = r.Retiro!;
                    <h2 class="siguiente__titulo" id="titulo-siguiente">Reporte retirado por el ciudadano</h2>
                    <dl class="datos" data-retirado>
                        <div><dt>Motivo del ciudadano</dt><dd>@retiro.Motivo</dd></div>
                        <div><dt>Fecha y hora</dt><dd>@Local(retiro.En)</dd></div>
                    </dl>
                    <p class="texto-secundario">Lo retiró antes de la decisión de la central: ya no admite acciones.</p>
                    break;
                default:
                    <h2 class="siguiente__titulo" id="titulo-siguiente">Sin acciones pendientes</h2>
                    <p class="texto-secundario">El reporte no admite más acciones en el estado «@r.TextoEstado».</p>
                    break;
            }
        </section>

        @if (r.PuedeCorregirCategoria)
        {
            @* HU14-CA03/CA04 — la categoría solo se corrige mientras el reporte está «En revisión». *@
            <details class="superficie otras-acciones" open="@abrirOtras">
                <summary>Otras acciones</summary>
                <div class="otras-acciones__cuerpo">
                    <section aria-labelledby="titulo-corregir">
                        <h3 id="titulo-corregir" class="otras-acciones__titulo">Corregir la categoría elegida por el ciudadano</h3>
                        <form method="post" asp-page-handler="Corregir" class="formulario" data-formulario novalidate>
                            <div class="campo">
                                <label class="campo__etiqueta" for="CategoriaId">Corregir a</label>
                                <select class="campo__control campo__control--seleccion" id="CategoriaId" name="CategoriaId" required
                                        aria-invalid="@(Model.ErrorCategoria is null ? null : "true")"
                                        aria-describedby="@(Model.ErrorCategoria is null ? null : "CategoriaId-error")">
                                    @foreach (var categoria in Model.Categorias)
                                    {
                                        <option value="@categoria.Id" selected="@(Model.CategoriaId == categoria.Id)">@categoria.Nombre</option>
                                    }
                                </select>
                                @if (Model.ErrorCategoria is not null)
                                {
                                    <p id="CategoriaId-error" class="campo__error"><partial name="_Icono" model="@("error")" /><span>@Model.ErrorCategoria</span></p>
                                }
                            </div>
                            <div class="acciones">
                                <button type="submit" class="boton boton--secundario" data-texto-carga="Guardando…">Corregir la categoría</button>
                            </div>
                        </form>
                    </section>
                </div>
            </details>
        }

        @if (!hechoPrimero)
        {
            Hecho();
        }

        @* Decisión del PO del 16/10/2026: atención de un reporte admitido, con las mismas reglas que en un SOS. *@
        @if (s?.Asignacion is { } asignacion)
        {
            <section class="superficie seccion-caso" aria-labelledby="titulo-atencion" data-atencion>
                <h2 id="titulo-atencion" class="seccion-caso__titulo">Despacho</h2>
                <p class="estado estado--activa">
                    <partial name="_Icono" model="@("exito")" />Asignado a @asignacion.Sereno a las @Local(asignacion.AsignadaEn)
                </p>
                @if (Model.PuedeReasignarse)
                {
                    <partial name="_ReasignarCaso" model="Model.VistaReasignacion" />
                }
                @if (!asignacion.SerenoOperativo)
                {
                    <p class="despacho-alerta" data-desactivado-con-caso>
                        <partial name="_Icono" model="@("advertencia")" />
                        <span>@asignacion.Sereno se desactivó con el caso en curso: la central no ve su ubicación y el caso sigue a su nombre.</span>
                    </p>
                }
                @if (s.Avances is { Count: > 0 } avances)
                {
                    <ol class="historial" data-avances>
                        @foreach (var avance in avances)
                        {
                            <li class="historial__elemento">
                                <p class="historial__cabecera">
                                    <span class="estado estado--activa">@avance.Descripcion</span>
                                    <time datetime="@avance.En.ToString("O", inv)">@Local(avance.En)</time>
                                    <span class="texto-secundario">· @avance.Responsable</span>
                                </p>
                                @if (avance.Nota is { } nota)
                                {
                                    <p class="historial__texto@(avance.Alerta ? " historial__texto--alerta" : "")" data-inicio-atencion>
                                        @if (avance.Alerta)
                                        {
                                            <partial name="_Icono" model="@("advertencia")" />
                                        }
                                        <span>@nota</span>
                                    </p>
                                }
                            </li>
                        }
                    </ol>
                }
            </section>
        }

        @if (Model.PuedeDescartarse)
        {
            <partial name="_DescartarCaso" model="Model.VistaDescarte" />
        }
    </div>

    <aside class="detalle-caso__contexto consola__expediente" aria-label="Expediente del reporte">
        <section class="superficie seccion-caso" aria-labelledby="titulo-lugar">
            <h2 id="titulo-lugar" class="seccion-caso__titulo">Ubicación del hecho</h2>
            @if (r.ConPunto)
            {
                <div id="mapa-hecho" class="mapa mapa--detalle" role="region" aria-label="Mapa con el lugar del hecho"
                     data-lat="@r.LatitudHecho?.ToString(inv)" data-lon="@r.LongitudHecho?.ToString(inv)" data-teselas="@Model.UrlTeselas"
                     data-clase-marcador="marcador-hecho marcador-hecho--reporte" data-titulo="Lugar del hecho"></div>
            }
            <dl class="datos datos--en-linea">
                <div><dt>Indicada como</dt><dd data-fuente>@fuente</dd></div>
                @if (r.ConPunto)
                {
                    <div><dt>Coordenadas</dt><dd>@r.LatitudHecho?.ToString("0.00000", inv), @r.LongitudHecho?.ToString("0.00000", inv)</dd></div>
                    @if (r.PrecisionHechoMetros is { } precision)
                    {
                        <div><dt>Precisión</dt><dd>± @precision.ToString("0", inv) m</dd></div>
                    }
                }
                @if (r.ReferenciaHecho is { } referencia)
                {
                    <div><dt>Referencia</dt><dd data-referencia>@referencia</dd></div>
                }
            </dl>
            <p class="texto-secundario detalle-caso__nota">Es el lugar del hecho que indicó el ciudadano, no la ubicación de su dispositivo.</p>
        </section>

        @if (Model.Ficha is { } ficha)
        {
            <partial name="_FichaCiudadano" model="ficha" />
        }



        <section class="superficie seccion-caso" aria-labelledby="titulo-categoria">
            <h2 id="titulo-categoria" class="seccion-caso__titulo">Categoría</h2>
            <dl class="datos datos--en-linea">
                <div class="@(categoriaCorregida ? null : "dato--vacio")"><dt>Original (elegida por el ciudadano)</dt><dd data-categoria-original>@r.CategoriaOriginal</dd></div>
                <div><dt>Vigente</dt><dd data-categoria-vigente>@r.CategoriaActual</dd></div>
            </dl>
            @if (r.Correcciones.Count > 0)
            {
                <ol class="historial" data-correcciones>
                    @foreach (var c in r.Correcciones)
                    {
                        <li class="historial__elemento">
                            <p class="historial__cabecera">
                                <span>«@c.Anterior» → «@c.Nueva»</span>
                                <time datetime="@c.En.ToString("O", inv)">@Local(c.En)</time>
                                <span class="texto-secundario">· @c.Operador</span>
                            </p>
                        </li>
                    }
                </ol>
            }
            @if (r.PuedeIniciarRevision)
            {
                <p class="texto-secundario detalle-caso__nota">Podrás corregirla cuando inicies la revisión.</p>
            }
        </section>

        <section class="superficie seccion-caso" aria-labelledby="titulo-revision">
            <h2 id="titulo-revision" class="seccion-caso__titulo">@(r.Decision is not null && siguiente != Accion.VerDecision ? "Revisión y decisión" : "Revisión")</h2>
            @if (r.RevisionIniciadaPor is { } responsable && r.RevisionIniciadaEn is { } iniciada)
            {
                <dl class="datos datos--en-linea" data-revision>
                    <div><dt>Responsable</dt><dd>@responsable</dd></div>
                    <div><dt>Iniciada</dt><dd>@Local(iniciada)</dd></div>
                </dl>
            }
            else
            {
                <p class="texto-secundario">Nadie ha iniciado la revisión todavía.</p>
            }
            @if (r.Decision is { } decision && siguiente != Accion.VerDecision)
            {
                DatosDecision(decision);
            }
        </section>

        @if (Model.Tiempos is { } tiempos)
        {
            <partial name="_TiemposCaso" model="tiempos" />
        }
    </aside>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/consola.js" asp-append-version="true"></script>
    @if (r.ConPunto)
    {
        <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
        <script src="~/js/mapa-hecho.js" asp-append-version="true"></script>
    }
}
