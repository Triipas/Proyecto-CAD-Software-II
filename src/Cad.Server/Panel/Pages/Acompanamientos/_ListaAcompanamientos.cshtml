@model Cad.Server.Panel.Pages.Acompanamientos.ListaAcompanamientos
@using Cad.Server.Panel.Pages.Acompanamientos
@using Cad.Server.Modulos.Acompanamiento.Dominio
@{
    var umbral = (int)Model.Umbral.TotalSeconds;
    static string Iniciales(string nombre) => string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var ordenadas = Model.Ordenadas;
    var urgentes = ordenadas.Where(s => Model.AtencionDe(s) != Atencion.Calma).ToList();
    var calma = ordenadas.Where(s => Model.AtencionDe(s) == Atencion.Calma).ToList();
}
@* Rediseño (25/10/2026): cola de vigilancia por urgencia. La tarjeta entera elige a la persona y pasa al modo «sesión». *@
<p class="vigilancia__resumen" data-suave data-resumen data-cantidad="@Model.Sesiones.Count">
    <span><b class="num">@Model.Sesiones.Count</b> @(Model.Sesiones.Count == 1 ? "activa" : "activas")</span>
    @if (Model.RequierenAtencion > 0)
    {
        <span class="vigilancia__resumen-atencion"><b class="num">@Model.RequierenAtencion</b> @(Model.RequierenAtencion == 1 ? "requiere" : "requieren") atención</span>
    }
</p>

@if (Model.AvisosSinSesion is { Count: > 0 } sueltos)
{
    @* HU42-CA04: avisos de sesiones que ya terminaron: siguen pendientes y no son SOS. *@
    <section class="vigilancia__grupo" aria-label="Avisos de sesiones terminadas">
        <h2 class="vigilancia__grupo-titulo"><partial name="_Icono" model="@("advertencia")" />Avisos de sesiones terminadas</h2>
        <ul class="vigilados">
            @foreach (var aviso in sueltos)
            {
                <li class="vigilado vigilado--aviso-suelto" data-clave="aviso-@aviso.Id">
                    <p class="vigilado__linea"><strong>@aviso.TextoTipo: @aviso.TextoRegla</strong><span class="texto-secundario"> · @aviso.Ciudadano · @Formato.Hora(aviso.GeneradoEn, Model.ZonaHoraria, "HH:mm")</span></p>
                    <a class="vigilado__enlace" href="/panel/avisos/@aviso.Id" data-aviso="@aviso.Id" data-regla="@aviso.Regla" data-estado-aviso="@aviso.Estado">Revisar el aviso<span class="visualmente-oculto"> de @aviso.Ciudadano</span></a>
                </li>
            }
        </ul>
    </section>
}

@if (Model.Sesiones.Count == 0)
{
    <div class="vigilancia__vacio" data-sin-acompanamientos>
        <partial name="_Icono" model="@("ruta")" />
        <p class="aviso__titulo">No hay acompañamientos activos.</p>
        <p>Cuando un ciudadano comparta su trayecto, aparecerá aquí y en el mapa.</p>
    </div>
}
else
{
    foreach (var (titulo, grupo, clase) in new[] { ("Requieren atención", urgentes, "atencion"), ("En calma", calma, "calma") })
    {
        if (grupo.Count == 0) continue;
        <section class="vigilancia__grupo vigilancia__grupo--@clase" aria-label="@titulo">
            <h2 class="vigilancia__grupo-titulo">@titulo <span class="num">@grupo.Count</span></h2>
            <ul class="vigilados" data-cantidad="@grupo.Count">
                @foreach (var s in grupo)
                {
                    var p = s.Ultima;
                    var gris = s.SinConexion || p is { Desactualizada: true } || p is null;
                    var atencion = Model.AtencionDe(s);
                    var avisos = Model.AvisosDe(s.Id);
                    <li class="vigilado vigilado--@atencion.ToString().ToLowerInvariant()" data-clave="@s.Id" data-acompanamiento="@s.Id" data-ciudadano="@s.Ciudadano"
                        data-atencion="@atencion" data-sin-conexion="@(s.SinConexion ? "true" : "false")"
                        data-lat="@(p is null ? null : Formato.Numero(p.Latitud))" data-lon="@(p is null ? null : Formato.Numero(p.Longitud))"
                        data-desactualizada="@(p is { Desactualizada: true } ? "true" : "false")">
                        @* Sonar mientras su posición está al día; desfasado por sesión para que no laten a la vez. *@
                        <span class="vigilado__avatar@(gris ? " vigilado__avatar--gris" : " sonar")" aria-hidden="true"
                              style="--desfase: -@(Math.Abs(s.Id.GetHashCode() % 24) * 100)ms">@Iniciales(s.Ciudadano)</span>
                        <div class="vigilado__cuerpo">
                            <p class="vigilado__linea">
                                <a class="vigilado__nombre" href="/panel/acompanamientos?sesion=@s.Id" data-elegir-acompanamiento
                                   aria-describedby="acompanamiento-@s.Id-posicion">@s.Ciudadano<span class="visualmente-oculto">: seguir su recorrido</span></a>
                                <span class="vigilado__vence num">hasta @Formato.Hora(s.VenceEn, Model.ZonaHoraria, "HH:mm")</span>
                            </p>
                            @* El motivo de la urgencia, siempre con icono y texto. *@
                            @switch (atencion)
                            {
                                case Atencion.PideAyuda:
                                    <span class="chip chip--urgente vigilado__motivo" data-suave><partial name="_Icono" model="@("urgente")" />Pidió ayuda · SOS abierto</span>
                                    break;
                                case Atencion.AlgoNoEstaBien:
                                    <span class="chip chip--advertencia vigilado__motivo" data-suave data-algo-no-esta-bien><partial name="_Icono" model="@("advertencia")" />Avisó que algo no está bien</span>
                                    break;
                                case Atencion.Aviso when p is not { Desactualizada: true }:
                                    <span class="chip chip--advertencia vigilado__motivo" data-suave><partial name="_Icono" model="@("advertencia")" />@avisos[0].TextoRegla</span>
                                    break;
                                case Atencion.SinConexion:
                                    <span class="chip chip--advertencia vigilado__motivo" data-suave data-estado-sesion><partial name="_Icono" model="@("advertencia")" />Sin conexión</span>
                                    break;
                                case Atencion.Desactualizada:
                                    <span class="chip chip--advertencia vigilado__motivo" data-suave data-desactualizada-aviso><partial name="_Icono" model="@("reloj")" />Posición desactualizada</span>
                                    break;
                            }
                            @if (p is { Desactualizada: true } && atencion != Atencion.Desactualizada)
                            {
                                <span class="chip chip--advertencia vigilado__motivo" data-suave data-desactualizada-aviso><partial name="_Icono" model="@("reloj")" />Posición desactualizada</span>
                            }
                            @if (s.SinConexion && atencion != Atencion.SinConexion)
                            {
                                <span class="chip chip--advertencia vigilado__motivo" data-suave data-estado-sesion><partial name="_Icono" model="@("advertencia")" />Sin conexión</span>
                            }
                            @if (p is null)
                            {
                                <p class="vigilado__dato texto-secundario" id="acompanamiento-@s.Id-posicion" data-sin-posicion>Aún no se recibió ninguna posición.</p>
                            }
                            else
                            {
                                @* HU38-CA01/CA02/CA03: hora de obtención, precisión y antigüedad; una posición desactualizada no se presenta como actual. *@
                                <p class="vigilado__dato" id="acompanamiento-@s.Id-posicion" data-posicion>
                                    <strong>@(p.Desactualizada || s.SinConexion ? "Última posición conocida" : "Posición actual")</strong>
                                    · <time class="num sin-corte" datetime="@p.ObtenidaEn.ToString("O")" data-antiguedad data-desde="@p.ObtenidaEn.ToString("O")" data-umbral="@umbral">@Formato.Antiguedad(p.Antiguedad)</time>
                                    · <span class="sin-corte">precisión ± @Formato.Numero(p.PrecisionMetros, "0") m</span>
                                </p>
                            }
                            @* HU40/HU41: última confirmación de bienestar. «Necesito ayuda» es una alerta solo mientras su SOS sigue abierto. *@
                            @if (s.UltimaConfirmacion is { } confirmacion)
                            {
                                var ayuda = confirmacion.Respuesta == RespuestaBienestar.NecesitoAyuda;
                                <p class="@(!ayuda ? "vigilado__dato" : confirmacion.SosEnCurso ? "aviso aviso--error vigilado__nota" : "aviso aviso--advertencia vigilado__nota")"
                                   data-confirmacion="@(confirmacion.Respuesta?.ToString() ?? "Pendiente")" data-sos-en-curso="@(confirmacion.SosEnCurso ? "true" : "false")">
                                    Bienestar (@Formato.Hora(confirmacion.SolicitadaEn, Model.ZonaHoraria, "HH:mm")): <strong>@confirmacion.TextoRespuesta</strong>
                                    @if (confirmacion.TextoSos is { } textoSos)
                                    {
                                        <span data-estado-sos>@textoSos</span>
                                    }
                                    @if (confirmacion.CasoId is { } caso)
                                    {
                                        <a class="vigilado__enlace" href="/panel/central/sos/@caso">Ver el SOS</a>
                                    }
                                </p>
                            }
                            @* 26/10/2026: lo último que el ciudadano informó por su cuenta. Un aviso nuevo de peligro suena una vez. *@
                            @if (s.UltimoEstado is { } informado)
                            {
                                var alerta = informado.Estado is EstadoCiudadano.AlgoNoEstaBien || informado is { Estado: EstadoCiudadano.NecesitoAyuda, SosEnCurso: true };
                                <p class="vigilado__dato" data-estado-informado="@informado.Estado" data-alerta-ciudadano="@(alerta ? informado.Id : null)">
                                    Informó (@Formato.Hora(informado.InformadoEn, Model.ZonaHoraria, "HH:mm")): <strong>@informado.Texto</strong>
                                    @if (informado.TextoSos is { } textoSos)
                                    {
                                        <span data-estado-sos>@textoSos</span>
                                    }
                                    @if (informado.CasoId is { } casoInformado)
                                    {
                                        <a class="vigilado__enlace" href="/panel/central/sos/@casoInformado">Ver el SOS</a>
                                    }
                                </p>
                            }
                            @foreach (var aviso in avisos)
                            {
                                <a class="vigilado__enlace" href="/panel/avisos/@aviso.Id" data-aviso="@aviso.Id" data-regla="@aviso.Regla" data-estado-aviso="@aviso.Estado">
                                    @aviso.TextoTipo · @aviso.TextoEstado.ToLowerInvariant()<span class="visualmente-oculto">: @aviso.TextoRegla</span>
                                </a>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
}
