@model Cad.Server.Panel.Pages.Acompanamientos.ListaAcompanamientos
@using Cad.Server.Panel.Pages.Acompanamientos
@{
    var umbral = (int)Model.Umbral.TotalSeconds;
}
@if (Model.Sesiones.Count == 0)
{
    <p class="texto-secundario" data-sin-acompanamientos>No hay acompañamientos activos.</p>
}
else
{
    <ul class="lista-acompanamientos" data-cantidad="@Model.Sesiones.Count">
        @foreach (var s in Model.Sesiones)
        {
            var p = s.Ultima;
            <li class="acompanamiento @(s.SinConexion ? "acompanamiento--sin-conexion" : "")" data-acompanamiento="@s.Id"
                data-ciudadano="@s.Ciudadano" data-sin-conexion="@(s.SinConexion ? "true" : "false")"
                data-lat="@(p is null ? null : Formato.Numero(p.Latitud))" data-lon="@(p is null ? null : Formato.Numero(p.Longitud))"
                data-desactualizada="@(p is { Desactualizada: true } ? "true" : "false")">
                <p class="acompanamiento__cabecera">
                    <span class="etiqueta-acompanamiento">Acompañamiento</span>
                    @* DP20: sin envíos del dispositivo durante más del umbral, la sesión se muestra «Sin conexión». *@
                    @if (s.SinConexion)
                    {
                        <span class="estado estado--sin-contacto" data-estado-sesion><partial name="_Icono" model="@("advertencia")" />Sin conexión</span>
                    }
                    else
                    {
                        <span class="estado estado--activa" data-estado-sesion><partial name="_Icono" model="@("exito")" />Activa</span>
                    }
                    <span class="texto-secundario">hasta las @Formato.Hora(s.VenceEn, Model.ZonaHoraria, "HH:mm")</span>
                </p>
                <p class="acompanamiento__ciudadano">@s.Ciudadano @(s.Telefono is { } t ? $"· {t}" : "")</p>
                @if (p is null)
                {
                    <p class="texto-secundario" data-sin-posicion>Aún no se recibió ninguna posición.</p>
                }
                else
                {
                    @* HU38-CA01/CA02/CA03: hora de obtención, precisión y antigüedad; una posición desactualizada no se presenta como actual. *@
                    <p data-posicion>
                        <strong>@(p.Desactualizada || s.SinConexion ? "Última posición conocida" : "Posición actual")</strong>
                        · obtenida a las <time datetime="@p.ObtenidaEn.ToString("O")">@Formato.Hora(p.ObtenidaEn, Model.ZonaHoraria)</time>
                        (<span data-antiguedad data-desde="@p.ObtenidaEn.ToString("O")" data-umbral="@umbral">@Formato.Antiguedad(p.Antiguedad)</span>)
                        · precisión ± @Formato.Numero(p.PrecisionMetros, "0") m
                    </p>
                    @if (p.Desactualizada)
                    {
                        <p class="aviso aviso--advertencia acompanamiento__aviso" data-desactualizada-aviso>
                            <partial name="_Icono" model="@("advertencia")" />
                            <span>Posición desactualizada: tiene más de @umbral s. No es la ubicación actual del ciudadano.</span>
                        </p>
                    }
                }
                @if (s.SinConexion)
                {
                    <p class="aviso aviso--advertencia acompanamiento__aviso" data-sin-conexion-aviso>
                        <partial name="_Icono" model="@("advertencia")" />
                        <span>Sin conexión: no llega ningún envío del dispositivo desde las @(s.UltimoContactoEn is { } u ? Formato.Hora(u, Model.ZonaHoraria) : "—"). Si el ciudadano finalizó sin conexión, el cierre llegará cuando la recupere.</span>
                    </p>
                }
                <p><a href="/panel/acompanamientos/@s.Id">Ver el recorrido (@s.Posiciones @(s.Posiciones == 1 ? "posición" : "posiciones"))</a></p>
            </li>
        }
    </ul>
}
