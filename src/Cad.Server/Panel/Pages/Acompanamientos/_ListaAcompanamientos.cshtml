@model Cad.Server.Panel.Pages.Acompanamientos.ListaAcompanamientos
@using Cad.Server.Panel.Pages.Acompanamientos
@{
    var umbral = (int)Model.Umbral.TotalSeconds;
    static string Iniciales(string nombre) => string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
@* HU42-CA04: los avisos técnicos y de verificación, en su propia lista: no son SOS ni generan despacho. *@
@if (Model.Avisos is { Count: > 0 } avisos)
{
    <section class="avisos-acompanamiento" aria-label="Avisos del acompañamiento sin resolver" data-avisos="@avisos.Count">
        <h3 class="acompanamientos__subtitulo"><partial name="_Icono" model="@("advertencia")" />Avisos sin resolver · @avisos.Count</h3>
        <ul class="lista-acompanamientos">
            @foreach (var aviso in avisos)
            {
                <li class="aviso-acompanamiento" data-aviso="@aviso.Id" data-regla="@aviso.Regla" data-estado-aviso="@aviso.Estado">
                    <p class="acompanamiento__meta">
                        <span class="etiqueta-acompanamiento">@aviso.TextoTipo</span>
                        <strong>@aviso.TextoRegla</strong>
                    </p>
                    <p class="acompanamiento__dato texto-secundario">@aviso.Ciudadano · @Formato.Hora(aviso.GeneradoEn, Model.ZonaHoraria) · @aviso.TextoEstado@(aviso.Responsable is { } responsable ? $" ({responsable})" : "")</p>
                    <p class="acompanamiento__dato"><a href="/panel/avisos/@aviso.Id">Revisar el aviso<span class="visualmente-oculto"> de @aviso.Ciudadano</span></a></p>
                </li>
            }
        </ul>
    </section>
}
@if (Model.Sesiones.Count == 0)
{
    <div class="estado-vacio acompanamientos__vacio" data-sin-acompanamientos>
        <partial name="_Icono" model="@("ruta")" />
        <p class="aviso__titulo">No hay acompañamientos activos.</p>
        <p>Cuando un ciudadano comparta su trayecto, aparecerá aquí y en el mapa.</p>
    </div>
}
else
{
    <ul class="lista-acompanamientos" data-cantidad="@Model.Sesiones.Count">
        @foreach (var s in Model.Sesiones)
        {
            var p = s.Ultima;
            var gris = s.SinConexion || p is { Desactualizada: true };
            <li class="acompanamiento @(s.SinConexion ? "acompanamiento--sin-conexion" : "")" data-acompanamiento="@s.Id"
                data-ciudadano="@s.Ciudadano" data-sin-conexion="@(s.SinConexion ? "true" : "false")"
                data-lat="@(p is null ? null : Formato.Numero(p.Latitud))" data-lon="@(p is null ? null : Formato.Numero(p.Longitud))"
                data-desactualizada="@(p is { Desactualizada: true } ? "true" : "false")">
                <div class="acompanamiento__cabecera">
                    @* 24/10/2026: sonar mientras la sesión se vigila con posición al día; desfasado por sesión para que no laten a la vez. *@
                    <span class="acompanamiento__inicial@(gris ? " acompanamiento__inicial--gris" : " sonar")" aria-hidden="true"
                          style="--desfase: -@(Math.Abs(s.Id.GetHashCode() % 24) * 100)ms">@Iniciales(s.Ciudadano)</span>
                    <div class="acompanamiento__quien">
                        @* 24/10/2026: como en la central, la tarjeta entera es el botón que ubica la sesión en el mapa (el del nombre,
                           extendido a toda la tarjeta). Sin ninguna posición no hay nada que ubicar. *@
                        @if (p is not null)
                        {
                            <button type="button" class="acompanamiento__ciudadano acompanamiento__elegir" data-elegir-acompanamiento aria-pressed="false"
                                    aria-describedby="acompanamiento-@s.Id-posicion">@s.Ciudadano @(s.Telefono is { } t ? $"· {t}" : "")<span class="visualmente-oculto">: ubicar en el mapa</span></button>
                        }
                        else
                        {
                            <p class="acompanamiento__ciudadano">@s.Ciudadano @(s.Telefono is { } t ? $"· {t}" : "")</p>
                        }
                        <p class="acompanamiento__meta">
                            <span class="etiqueta-acompanamiento">Acompañamiento</span>
                            <span class="texto-secundario">hasta las @Formato.Hora(s.VenceEn, Model.ZonaHoraria, "HH:mm")</span>
                        </p>
                    </div>
                    @* DP20: sin envíos del dispositivo durante más del umbral, la sesión se muestra «Sin conexión». *@
                    @if (s.SinConexion)
                    {
                        <span class="chip chip--advertencia" data-estado-sesion><partial name="_Icono" model="@("advertencia")" />Sin conexión</span>
                    }
                    else
                    {
                        <span class="chip chip--acompanamiento" data-estado-sesion><partial name="_Icono" model="@("exito")" />Activa</span>
                    }
                </div>
                @* HU40/HU41: última confirmación de bienestar de la sesión. «Necesito ayuda» es una alerta solo mientras su SOS sigue
                   abierto; si el ciudadano lo canceló (o se cerró o descartó), se dice y deja de mostrarse en rojo (24/10/2026). *@
                @if (s.UltimaConfirmacion is { } confirmacion)
                {
                    var ayuda = confirmacion.Respuesta == Cad.Server.Modulos.Acompanamiento.Dominio.RespuestaBienestar.NecesitoAyuda;
                    <p class="@(!ayuda ? "acompanamiento__dato" : confirmacion.SosEnCurso ? "aviso aviso--error acompanamiento__aviso" : "aviso aviso--advertencia acompanamiento__aviso")"
                       data-confirmacion="@(confirmacion.Respuesta?.ToString() ?? "Pendiente")" data-sos-en-curso="@(confirmacion.SosEnCurso ? "true" : "false")">
                        Confirmación de bienestar (@Formato.Hora(confirmacion.SolicitadaEn, Model.ZonaHoraria, "HH:mm")): <strong>@confirmacion.TextoRespuesta</strong>
                        @if (confirmacion.TextoSos is { } textoSos)
                        {
                            <span data-estado-sos>@textoSos</span>
                        }
                        @if (confirmacion.CasoId is { } caso)
                        {
                            <a href="/panel/central/sos/@caso">Ver el SOS</a>
                        }
                    </p>
                }
                @if (p is null)
                {
                    <p class="acompanamiento__dato texto-secundario" data-sin-posicion>Aún no se recibió ninguna posición.</p>
                }
                else
                {
                    @* HU38-CA01/CA02/CA03: hora de obtención, precisión y antigüedad; una posición desactualizada no se presenta como actual. *@
                    <p class="acompanamiento__dato" id="acompanamiento-@s.Id-posicion" data-posicion>
                        <partial name="_Icono" model="@("ubicacion")" />
                        <span>
                            <strong>@(p.Desactualizada || s.SinConexion ? "Última posición conocida" : "Posición actual")</strong>
                            · obtenida a las <time datetime="@p.ObtenidaEn.ToString("O")">@Formato.Hora(p.ObtenidaEn, Model.ZonaHoraria)</time>
                            (<span data-antiguedad data-desde="@p.ObtenidaEn.ToString("O")" data-umbral="@umbral">@Formato.Antiguedad(p.Antiguedad)</span>)
                            · precisión ± @Formato.Numero(p.PrecisionMetros, "0") m
                        </span>
                    </p>
                    @if (p.Desactualizada)
                    {
                        <p class="aviso aviso--advertencia acompanamiento__aviso" data-desactualizada-aviso>
                            <partial name="_Icono" model="@("advertencia")" />
                            <span>Posición desactualizada: tiene más de @umbral s. No es la ubicación actual del ciudadano.</span>
                        </p>
                    }
                }
                @if (s.SinConexion)
                {
                    <p class="aviso aviso--advertencia acompanamiento__aviso" data-sin-conexion-aviso>
                        <partial name="_Icono" model="@("advertencia")" />
                        <span>Sin conexión: no llega ningún envío del dispositivo desde las @(s.UltimoContactoEn is { } u ? Formato.Hora(u, Model.ZonaHoraria) : "—"). Si el ciudadano finalizó sin conexión, el cierre llegará cuando la recupere.</span>
                    </p>
                }
                <div class="acompanamiento__acciones">
                    <a class="acompanamiento__recorrido" href="/panel/acompanamientos/@s.Id">Ver el recorrido (@s.Posiciones @(s.Posiciones == 1 ? "posición" : "posiciones"))</a>
                </div>
            </li>
        }
    </ul>
}
