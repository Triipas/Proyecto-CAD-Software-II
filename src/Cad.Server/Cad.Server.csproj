<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Cad.Contratos\Cad.Contratos.csproj" />
    <ProjectReference Include="..\Cad.Calles\Cad.Calles.csproj" />
    <!-- HU48: cuadrícula, rasgos, línea base y el predictor que carga el modelo de focos (ML.NET). -->
    <ProjectReference Include="..\Cad.Proyeccion\Cad.Proyeccion.csproj" />
  </ItemGroup>

  <!-- S6-T01: criterios de triaje, una sola fuente para el prompt del asistente y la página que leen los operadores. -->
  <ItemGroup>
    <EmbeddedResource Include="Modulos\Asistencia\Recursos\criterios-triaje.md" LogicalName="Cad.Server.Modulos.Asistencia.Recursos.criterios-triaje.md" />
  </ItemGroup>

  <!-- HU48 (S6-T24): el modelo de focos que exporta la herramienta ia-evaluacion (pequeño y versionado). -->
  <ItemGroup>
    <EmbeddedResource Include="Recursos\modelo-focos.zip" LogicalName="Cad.Server.Recursos.modelo-focos.zip" />
  </ItemGroup>

  <!-- Red de calles de la zona (la misma que viaja en la app) para dibujar en la central el recorrido del sereno. -->
  <ItemGroup>
    <None Include="..\Cad.Movil\Resources\Raw\mapa\red-viaria.bin" Link="Calles\red-viaria.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9ad5770a-a2bb-4267-8ded-529c4c72d3ef</UserSecretsId>
  </PropertyGroup>

</Project>
